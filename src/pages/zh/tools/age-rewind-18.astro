---
import Base from '../../../layouts/Base.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const siteBase = Astro.site ?? new URL('https://aiartspell.art');
const cover = new URL('/tool-covers/age-rewind-18.jpg', siteBase).toString();
const ogImageUrl = cover;
const pageUrl = new URL('/zh/tools/age-rewind-18/', siteBase).toString();

const primaryPrompt = `把照片里的人物返老还童，变成 18 岁的样子。严格保留同一个人：五官比例、眼型、鼻唇、神态表情、姿势、服装、构图、背景和光线都不变。
只逆转年龄痕迹：淡化皱纹与细纹、恢复紧致饱满的年轻肤质、淡化老年斑、眼神更清亮、气色红润自然。
头发规则——头发绝对不能是白色、银白或灰白色：请按照人物的人种恢复成自然的年轻发色（东亚人：黑色或深棕色；欧美白人：棕色、深金或金色；非洲裔：黑色或深棕色；南亚、拉美、中东：深棕色或黑色），发量浓密、有自然光泽，并保留原来的发型。
保持原照片的摄影风格、色调、颗粒与景深不变。真实摄影质感，保留皮肤纹理与毛孔，不要塑料磨皮脸、不要换脸、不要新增人物、不要卡通化、不要文字或水印。`;

const enPrompt = `Make the person in this photo look 18 years old again (age rewind / de-aging edit).
Keep the exact same identity: identical facial bone structure, eye shape, nose, lips, expression, pose, clothing, framing, background and lighting.
Only reverse the signs of aging: smooth wrinkles and fine lines, restore firm youthful skin and soft facial volume, fade age spots, brighten the eyes, add subtle healthy colour to the complexion.
HAIR RULE - do not keep white, silver or grey hair: recolour the hair to the natural young hair colour that matches this person's ethnicity (East Asian: black or dark brown; Caucasian: brown, dark blonde or blonde; African: black or dark brown; South Asian, Latina/o or Middle Eastern: dark brown or black). Hair should look dense, healthy and naturally glossy, with the original hairstyle preserved.
Keep the original photographic style, colour grading, grain and depth of field. Photorealistic, visible skin pores and texture, no plastic skin, no beautifying filter, no face swap, no new person, no cartoon or illustration, no text or watermark.`;

const ctaHref = `${base}/zh/tools/agnes-image/?prompt=${encodeURIComponent(primaryPrompt)}`;

const rules = [
  {
    n: '01',
    title: '写「变成 18 岁」，不要写「变年轻一点」',
    body: '模糊指令只会让模型做一次轻度磨皮就交差。给出明确年龄，模型才有具体的面部参照：更饱满的脸颊、更紧致的下颌线、更清亮的眼神、更少的细纹。如果模型总把脸推向幼态，再补一句「青年人，不是儿童、不是少年」。',
  },
  {
    n: '02',
    title: '必须显式禁止白发、银发、灰白发',
    body: '这是最高频的翻车点。返老还童改了脸，但模型会把输入图里最显眼的特征——白发——当成身份特征保留下来，于是得到「年轻人的脸 + 一头银发」。「年轻发色」这类正面描述压不住它，必须写硬性否定：头发不能是白色、银白或灰白，去掉每一根白发。',
  },
  {
    n: '03',
    title: '发色要按人物人种来改',
    body: '只写「变成黑发」，欧美老人会被染成乌黑、完全不像本人；只写「金发」，东亚老人又变成金发外国人。正确做法是让模型根据人物人种推断自然的年轻发色，并把常见范围列出来当示例，既保证真实感，又不破坏身份一致性。',
  },
  {
    n: '04',
    title: '先锁身份，再写修改',
    body: '把「保留同一个人：五官比例、眼型、神态、姿势、服装、背景、光线」放在提示词最前面。少了这一句，模型会直接生成一个陌生的好看年轻人，而不是照片里的这个人。',
  },
];

const steps = [
  { title: '挑一张清晰的原图', text: '正面或四分之三侧面、整个头部完整、光线均匀、脸部无遮挡的肖像效果最好。避开眼睛上有重阴影、戴墨镜、帽子压住发际线、以及分辨率过低的扫描件。' },
  { title: '打开图生图工具', text: '返老还童是「编辑」，不是文生图。切到「图生图 / 参考图」模式并上传照片。本站免费 AI 图片生成器支持参考图（单张最多 5MB），无需注册登录。' },
  { title: '粘贴完整提示词', text: '把上面的提示词整段复制到描述框。头发规则和身份锁定两句千万别删——删掉任何一句，就会出现「白发没去掉」或「换了一张脸」这两个经典问题。' },
  { title: '设置重绘幅度与比例', text: '画面比例保持和原图一致。参考强度从中等起步，先保住脸型；如果皱纹或白发还在，再小幅调高。一次生成 3–4 个版本，横向对比挑最自然的一张。' },
  { title: '用小指令做二次微调', text: '如果只有一个细节不对，就在生成图上做定点修正，例如「把所有残留的灰白发改成自然的深棕色，脸和其他部分完全不变」。小步修正比整段重写提示词更稳。' },
];

const settings = [
  ['模式', '图生图 / 参考图', '文生图无法保留照片里的这个人。'],
  ['参考强度', '从中等起步，约 50%–70%', '太低会留下皱纹和白发，太高会直接换脸。'],
  ['画面比例', '与原图完全一致', '避免重新构图、肩膀被裁切。'],
  ['生成数量', '3–4 个版本', '发色和皮肤质感每次都有波动，选最可信的一张。'],
  ['反向提示词', '白发、灰发、银发、皱纹、老年皮肤、换脸、塑料皮肤、卡通、文字、水印', '再次强调模型最容易忽略的两条规则。'],
];

const variants = [
  {
    title: '合影 / 多人照片',
    note: '画面里有多个人时用这条，「每一个」三个字是关键。',
    text: `把照片里的每一个人都返老还童到 18 岁，逐个人物单独处理。每个人都要保留自己的五官、表情、姿势和服装。对每一个人，都要去掉全部白色、银白、灰白头发，并按照该人物自身的人种恢复成自然的年轻发色。保持合影构图、背景和光线不变。真实摄影质感，不要换脸，不要少人或多人。`,
  },
  {
    title: '泛黄老照片 / 黑白照',
    note: '顺带修复划痕褪色，但不会把照片变成现代棚拍。',
    text: `修复这张老照片，并把照片里的人物返老还童到 18 岁。严格保留同一个人的身份、姿势、服装和构图。修复划痕、灰尘与褪色，做克制的自然上色，保留年代照片的质感。头发绝对不能是白色、银白或灰白色：按照人物的人种恢复成自然的年轻发色，发丝真实柔和。不要现代网红修图感，不要塑料皮肤，不要插画感。`,
  },
  {
    title: '男性 / 短发 / 有胡须',
    note: '防止模型擅自加长头发或把胡子刮干净。',
    text: `把照片里的男性返老还童到 18 岁，严格保留同一个人。保留原来的短发造型、发际线、胡须形状、表情、服装和背景。去掉每一根白色、银白、灰白头发，并按人种恢复成自然的年轻发色（东亚：黑色或深棕；欧美白人：棕色或深金；非洲裔：黑色或深棕）。年轻紧致的皮肤、保留真实纹理，写实摄影，不要换脸，不要改变发型。`,
  },
  {
    title: '证件照 / 标准肖像',
    note: '保持原图的中性、纪实感。',
    text: `把这张证件照里的人物返老还童到 18 岁。保留完全一致的五官身份、中性表情、头部角度、纯色背景、均匀光线和服装，只淡化年龄痕迹。头发绝对不能是白色、银白或灰白色：按人物人种恢复成自然的年轻发色。不要加笑容，不要改发型，不要换背景，不要加妆容或美颜滤镜。写实证件照质感。`,
  },
  {
    title: '只修头发（二次修正）',
    note: '脸已经对了、但白发还在时，用这条跑第二遍。',
    text: `只修改这张图里的头发。彻底去掉所有白色、银白、灰白发丝，按人物人种把头发恢复成自然的年轻颜色，保留原来的发型、发际线和发量。不要改脸、不要改皮肤、不要改表情、不要改服装、不要改背景、不要改光线，除头发以外的所有像素保持完全一致。`,
  },
];

const fixes = [
  ['白发还是没去掉', '把头发规则挪到提示词第一行，加「去掉每一根白色、银白、灰白发丝」，小幅调高重绘幅度；或者用上面「只修头发」那条跑第二遍。'],
  ['变成了另一个人', '加强身份锁定句，调低参考强度，删掉所有「好看、完美、精致」之类会让模型自由发挥的词；条件允许就上传同一人的两张参考图。'],
  ['皮肤像塑料、蜡像', '加「保留毛孔和真实皮肤纹理，不要模糊、不要美颜滤镜」，并去掉「无瑕、完美肌肤」这类表述。'],
  ['衣服或背景被改了', '加「只修改脸和头发，其余部分像素级保持不变」，并使用原图比例。'],
  ['合影里只改了一个人', '明确写「每一个人、画面中共 N 个人」，并把人数写进提示词。'],
  ['发色和人种不匹配', '把笼统描述换成「人种 + 具体发色范围」，例如「东亚女性：自然黑发，不要金色」。'],
  ['看起来像小孩不像 18 岁', '补一句「青年人、18 岁、成年人面部比例，不是儿童、不是少年」。'],
];

const faqs = [
  {
    q: '什么是 AI 返老还童提示词？',
    a: '它是一条用于图生图的指令，让 AI 模型淡化照片中的年龄痕迹，同时保留同一个人。可靠的返老还童提示词必须写清三件事：目标年龄、身份锁定、发色处理——白发恰恰是模型最容易漏改的细节。',
  },
  {
    q: '为什么变年轻了头发还是白的？',
    a: '模型把白发当成输入图的主导视觉特征，为了「保持一致」会主动保留它。解决办法是显式否定——头发不能是白色、银白或灰白——同时给出一个按人种推断的替换发色，让模型有明确的东西可以生成，而不是只收到一句「不要」。',
  },
  {
    q: '发色为什么要按人种来写？',
    a: '统一写死一种发色会破坏长相：欧美老人变成乌黑头发、东亚老人变成金发，看着就不是本人了。让模型根据人种推断自然的年轻发色并列出示例范围，再保留原发型，真实感和身份一致性才能同时保住。',
  },
  {
    q: '处理后还能认出是本人吗？',
    a: '通常可以，前提是身份锁定句放在提示词最前面、参考强度保持中等。建议生成多个版本，对照原图看眼型、鼻子和下颌线——最好的结果是「还是这个人，只是年轻了」，而不是换了一张脸。',
  },
  {
    q: '哪些工具能用这条提示词？',
    a: '任何支持「参考图 + 文字描述」的图片编辑器都可以：Nano Banana Pro、GPT Image、Gemini 图片编辑、Midjourney 图生图、Flux / ComfyUI 图生图工作流等。上面的提示词不绑定具体工具。',
  },
  {
    q: '免费吗？老照片能用吗？',
    a: '免费。可以直接复制提示词到本站的 AI 图片生成器使用，无需注册；也可以粘贴到你已经在用的任何编辑器。扫描的老照片同样适用，用上面「泛黄老照片」那个变体可以同时处理褪色和划痕。',
  },
];

const howToLd = {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: '重返18岁：用 AI 提示词让照片里的人物返老还童',
  description: '分步教程：用一条图生图提示词把照片里的人物变成 18 岁，头发不能是白色的，并按人种恢复自然年轻发色，同时保留同一个人。',
  image: ogImageUrl,
  totalTime: 'PT5M',
  tool: [{ '@type': 'HowToTool', name: '图生图工具或本站 AI 图片生成器' }],
  supply: [{ '@type': 'HowToSupply', name: '一张清晰的人像照片' }],
  step: steps.map((s, i) => ({
    '@type': 'HowToStep',
    position: i + 1,
    name: s.title,
    text: s.text,
    url: `${pageUrl}#step-${i + 1}`,
  })),
};

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<Base
  title="重返18岁：AI 返老还童照片提示词（完整教程）"
  description="可直接复制的 AI 返老还童提示词：把照片里的人物变成 18 岁，头发不能是白色的，按照人种恢复自然年轻发色，并保留同一个人。附分步教程、参数建议与失败排查。"
  ogImage={ogImageUrl}
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(howToLd)} />
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(faqLd)} />

  <article class="guide">
    <div class="container guide-wrap">
      <header class="guide-hero">
        <a class="crumb" href={`${base}/zh/tools/`}>← 返回 AI 工具</a>
        <span class="eyebrow">照片编辑教程 · 可直接复制的提示词</span>
        <h1>重返 18 岁：一条真正管用的 AI 返老还童提示词</h1>
        <p class="lead">把老照片里的人物变成可信的 18 岁模样——<strong>头发不能是白色的</strong>、<strong>发色按人种自然恢复</strong>，而且还是一眼能认出的同一个人。一条提示词、五步流程，外加常见翻车的逐条修法。</p>

        <figure class="hero-figure">
          <img src={cover} alt="效果对比：AI 返老还童把一位白发老奶奶变成深发的 18 岁年轻女性，仍是同一个人" width="224" height="169" />
          <figcaption>Before / After —— 同一个人、同样的造型，只是回到了 18 岁。下面这条提示词就是为这个效果调的。</figcaption>
        </figure>

        <div class="hero-actions">
          <a class="btn btn-primary" href={ctaHref}>打开 AI 图片生成器 →</a>
          <a class="btn btn-ghost" href="#prompt">直接看提示词</a>
        </div>
        <p class="hero-note">免费、无需注册。进入生成器后先切到<strong>「图生图」</strong>并上传照片，提示词已经帮你预填好了。</p>
      </header>

      <div class="guide-body">
        <section id="prompt" class="g-section">
          <h2>核心提示词</h2>
          <p>整段复制即可。它是按图生图写的，默认你已经上传了照片。顺序是刻意安排的：先锁身份，再改年龄，最后写头发规则。</p>

          <div class="prompt-card">
            <div class="prompt-head">
              <span class="prompt-label">主提示词 · 中文</span>
              <button type="button" class="copy-btn" data-copy-target="prompt-main" data-copied="已复制">复制提示词</button>
            </div>
            <pre id="prompt-main">{primaryPrompt}</pre>
          </div>

          <details class="prompt-alt">
            <summary>English version / 英文版提示词</summary>
            <div class="prompt-card">
              <div class="prompt-head">
                <span class="prompt-label">Main prompt · English</span>
                <button type="button" class="copy-btn" data-copy-target="prompt-en" data-copied="Copied!">Copy prompt</button>
              </div>
              <pre id="prompt-en">{enPrompt}</pre>
            </div>
          </details>

          <p class="tip"><strong>精简版</strong>（工具限制字数时用）：<em>「把照片里的人物返老还童到 18 岁，严格保留同一张脸和身份，去掉全部白发／灰白发并按人种恢复自然年轻发色，保持原照片风格不变。」</em></p>
        </section>

        <section class="g-section" id="why">
          <h2>为什么必须写清这三件事</h2>
          <p>绝大多数返老还童失败，都栽在三种可预期的问题上。上面这条提示词就是围绕它们设计的。</p>
          <div class="rule-grid">
            {rules.map((r) => (
              <div class="rule-card">
                <span class="rule-n">{r.n}</span>
                <h3>{r.title}</h3>
                <p>{r.body}</p>
              </div>
            ))}
          </div>
        </section>

        <section class="g-section" id="steps">
          <h2>五步实操：从照片到 18 岁</h2>
          <ol class="step-list">
            {steps.map((s, i) => (
              <li id={`step-${i + 1}`}>
                <span class="step-n">{i + 1}</span>
                <div>
                  <h3>{s.title}</h3>
                  <p>{s.text}</p>
                </div>
              </li>
            ))}
          </ol>
          <a class="inline-cta" href={ctaHref}>带着这条提示词打开生成器 →</a>
        </section>

        <section class="g-section" id="settings">
          <h2>参数建议</h2>
          <div class="table-wrap">
            <table>
              <thead><tr><th>设置项</th><th>建议值</th><th>原因</th></tr></thead>
              <tbody>
                {settings.map((row) => (
                  <tr><td><strong>{row[0]}</strong></td><td>{row[1]}</td><td>{row[2]}</td></tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>

        <section class="g-section" id="variants">
          <h2>常见场景的提示词变体</h2>
          <p>照片情况更复杂时，用对应变体替换主提示词即可。每一条都保留了「不能有白发」和「按人种改发色」这两个核心约束。</p>
          <div class="variant-list">
            {variants.map((v, i) => (
              <div class="variant-card">
                <div class="variant-head">
                  <div>
                    <h3>{v.title}</h3>
                    <p class="variant-note">{v.note}</p>
                  </div>
                  <button type="button" class="copy-btn" data-copy-target={`variant-${i}`} data-copied="已复制">复制</button>
                </div>
                <pre id={`variant-${i}`}>{v.text}</pre>
              </div>
            ))}
          </div>
        </section>

        <section class="g-section" id="troubleshooting">
          <h2>翻车排查</h2>
          <div class="table-wrap">
            <table>
              <thead><tr><th>出了什么问题</th><th>怎么改</th></tr></thead>
              <tbody>
                {fixes.map((row) => (
                  <tr><td><strong>{row[0]}</strong></td><td>{row[1]}</td></tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>

        <section class="g-section" id="faq">
          <h2>常见问题</h2>
          <div class="faq-list">
            {faqs.map((f) => (
              <details class="faq-item">
                <summary>{f.q}</summary>
                <p>{f.a}</p>
              </details>
            ))}
          </div>
        </section>

        <section class="g-section related">
          <h2>继续逛逛</h2>
          <div class="related-grid">
