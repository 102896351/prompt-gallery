---
import Base from '../../layouts/Base.astro';
import { collections } from '../../data/collections';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const collectionListLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'AI生图提示词合集',
  description: '按主题整理的 AI生图提示词和 AI绘画提示词合集。',
  url: new URL('/zh/collections/', Astro.site ?? 'https://aiartspell.art').toString(),
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: collections.length,
    itemListElement: collections.map((c, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: c.title,
      url: new URL(`/zh/collections/${c.slug}/`, Astro.site ?? 'https://aiartspell.art').toString(),
    })),
  },
};
---

<Base title="AI生图提示词与绘画提示词合集" description="按主题浏览精选 AI生图提示词和 AI绘画提示词，包含人像、产品摄影、海报、插画和 3D 等示例。">
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(collectionListLd)} />
  <section class="hero collections-hero">
    <div class="container">
      <h1><span class="grad">AI生图提示词合集</span></h1>
      <p>按主题探索精选 AI生图提示词和 AI绘画提示词——人像、产品摄影、海报、插画、3D 等。</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="collections-grid">
        {collections.map((c) => (
          <a href={`${base}/zh/collections/${c.slug}/`} class="card collection-card">
            <div class="collection-cover">
              <img
                src={c.cover.startsWith('http') ? c.cover : `${base}${c.cover}`}
                alt={c.title}
                loading="lazy"
                decoding="async"
                onerror="this.style.visibility='hidden'"
              />
            </div>
            <div class="collection-body">
              <h2>{c.title}</h2>
              <p class="collection-desc">{c.description}</p>
              <span class="collection-count">{c.count} 个提示词</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
</Base>

<style>
  .collections-hero { padding-bottom: 32px; }
  .collections-hero h1 {
    font-size: clamp(32px, 4.5vw, 44px);
    margin: 0 0 12px;
    font-weight: 800;
    letter-spacing: -0.02em;
  }
  .collections-hero p {
    color: var(--text-soft);
    max-width: 640px;
    margin: 0 auto;
  }
  .collections-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 20px;
  }
  .collection-card {
    display: flex;
    flex-direction: column;
    padding: 0;
    overflow: hidden;
  }
  .collection-cover {
    aspect-ratio: 16 / 10;
    background: var(--bg-soft);
    overflow: hidden;
  }
  .collection-cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s;
  }
  .collection-card:hover .collection-cover img {
    transform: scale(1.05);
  }
  .collection-body {
    padding: 18px 20px;
  }
  .collection-body h2 {
    margin: 0 0 8px;
    font-size: 18px;
    font-weight: 700;
    line-height: 1.4;
  }
  .collection-desc {
    color: var(--text-soft);
    font-size: 13px;
    line-height: 1.55;
    margin: 0 0 12px;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .collection-count {
    display: inline-block;
    padding: 4px 12px;
    background: var(--accent-bg);
    color: var(--accent);
    border-radius: 999px;
    font-size: 12px;
    font-weight: 600;
  }
</style>