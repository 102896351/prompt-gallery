---
//  /zh/prompts/<category>/  — 中文分类聚合页（分页）
//  承接 "AI 人像提示词" / "AI 产品摄影提示词" 这类中文品类词，
//  同时把权重从 /zh/ai-image-prompts/ 下发给中文详情页。

import Base from '../../../../layouts/Base.astro';
import PromptCard from '../../../../components/PromptCard.astro';
import { prompts, promptCategories, type Prompt } from '../../../../data/prompts';

// 按 slug 去重，与详情页（/zh/prompt，1228 页）一致
const allPrompts = [...new Map(prompts.map((p) => [p.slug, p])).values()];

export async function getStaticPaths({ paginate }: any) {
  // getStaticPaths 被 Astro 提取到独立模块，只能访问 import；去重在此处本地完成
  const deduped = [...new Map(prompts.map((p) => [p.slug, p])).values()];
  return promptCategories
    .map((cat) => ({
      cat,
      items: deduped
        .filter((p) => p.category === cat.id)
        .sort((a, b) => (b.dateAdded || '').localeCompare(a.dateAdded || '')),
    }))
    .filter((g) => g.items.length > 0)
    .flatMap((g) =>
      paginate(g.items, {
        params: { category: g.cat.id },
        props: { cat: g.cat },
        pageSize: 48,
      })
    );
}

const { page } = Astro.props;
const { cat } = Astro.props as { cat: (typeof promptCategories)[number] };
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const isFirst = page.currentPage === 1;
const suffix = isFirst ? '' : ` — 第 ${page.currentPage} 页`;

const title = `AI ${cat.labelZh}提示词${suffix}`;
const total = allPrompts.filter((p) => p.category === cat.id).length;
const description = isFirst
  ? `共 ${total} 条可直接复制的 AI ${cat.labelZh}提示词，每条都配有真实示例图与经过测试的参数。${cat.description || ''}`
  : `AI ${cat.labelZh}提示词 — 第 ${page.currentPage} / ${page.lastPage} 页。`;

const siteBase = Astro.site ?? new URL('https://aiartspell.art');

function pageHref(catId: string, n: number) {
  return n === 1 ? `${base}/zh/prompts/${catId}/` : `${base}/zh/prompts/${catId}/${n}/`;
}
const pageNumbers = Array.from({ length: page.lastPage }, (_, i) => i + 1).filter(
  (n) => n === 1 || n === page.lastPage || n % 5 === 0 || Math.abs(n - page.currentPage) <= 2
);

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: '首页', item: new URL('/zh/', siteBase).toString() },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'AI 生图提示词',
      item: new URL('/zh/ai-image-prompts/', siteBase).toString(),
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: `AI ${cat.labelZh}提示词`,
      item: new URL(`/zh/prompts/${cat.id}/`, siteBase).toString(),
    },
  ],
};

const itemListLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: `AI ${cat.labelZh}提示词${suffix}`,
  numberOfItems: page.data.length,
  itemListElement: page.data.map((p: Prompt, i: number) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: p.title,
    url: new URL(`/zh/prompt/${p.slug}/`, siteBase).toString(),
  })),
};
---

<Base title={title} description={description}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(itemListLd)} />

  <section class="section">
    <div class="container">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href={`${base}/zh/`}>首页</a>
        <span aria-hidden="true">/</span>
        <a href={`${base}/zh/ai-image-prompts/`}>AI 生图提示词</a>
        <span aria-hidden="true">/</span>
        <span>{cat.labelZh}</span>
      </nav>

      <h1>AI {cat.labelZh}提示词{suffix}</h1>
      <p class="page-count">共 {total} 条提示词 · 第 {page.currentPage} / {page.lastPage} 页</p>

      {
        isFirst && (
          <p class="lead">
            <strong>{total} 条 AI {cat.labelZh}提示词</strong> —— {cat.description}。
            下方的每条提示词都配有真实示例图、经过测试的表述以及它所针对的模型，可直接复制到 Nano Banana Pro、ChatGPT 或 Gemini 中使用。
          </p>
        )
      }

      <div class="grid">
        {
          page.data.map((p: Prompt) => (
            <div class="card-wrap">
              <PromptCard prompt={p} base={base} />
            </div>
          ))
        }
      </div>

      <nav class="pager" aria-label="Pagination">
        {page.url.prev ? <a href={page.url.prev}>← 上一页</a> : <span class="pager-off">← 上一页</span>}
        <div class="pager-nums">
          {
            pageNumbers.map((n: number) =>
              n === page.currentPage ? (
                <span class="pager-cur">{n}</span>
              ) : (
                <a href={pageHref(cat.id, n)}>{n}</a>
              )
            )
          }
        </div>
        {page.url.next ? <a href={page.url.next}>下一页 →</a> : <span class="pager-off">下一页 →</span>}
      </nav>
    </div>
  </section>
</Base>

<style>
  .crumbs {
    margin-bottom: 12px;
    color: var(--text-muted);
    font-size: 13px;
  }
  .crumbs a { color: var(--accent); text-decoration: none; }
  .crumbs a:hover { text-decoration: underline; }
  .page-count { margin: 6px 0 18px; color: var(--text-muted); font-size: 13px; }
  .lead { max-width: 760px; margin: 0 0 26px; line-height: 1.75; }
  .pager {
    display: flex; flex-wrap: wrap; align-items: center; justify-content: center;
    gap: 8px; margin: 32px 0 8px;
  }
  .pager a, .pager span {
    min-width: 36px; padding: 7px 11px; border: 1px solid var(--border);
    border-radius: 8px; background: var(--bg-card); color: var(--text);
    font-size: 13px; text-align: center; text-decoration: none;
  }
  .pager a:hover { border-color: var(--accent); color: var(--accent); }
  .pager .pager-cur { border-color: var(--accent); background: var(--accent); color: #fff; font-weight: 600; }
  .pager .pager-off { opacity: 0.4; }
  .pager-nums { display: flex; flex-wrap: wrap; gap: 6px; }
</style>
