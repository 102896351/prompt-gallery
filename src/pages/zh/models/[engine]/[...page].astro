---
//  /zh/models/<engine>/  — 中文模型聚合页（分页）
//  承接 "Nano Banana Pro 提示词" / "Gemini 提示词" 等中文模型词。
//  与英文版对称，但文案、详情链接、官方站说明全部中文化。

import Base from '../../../../layouts/Base.astro';
import PromptCard from '../../../../components/PromptCard.astro';
import { prompts, type Prompt } from '../../../../data/prompts';
import { engines, type Engine } from '../../../../data/engines';

// 按 slug 去重，与详情页（/zh/prompt，1228 页）一致
const allPrompts = [...new Map(prompts.map((p) => [p.slug, p])).values()];

// 重点模型中文定制文案（其余走通用模板）
const MODEL_COPY: Record<string, { h1: string; lead: string; usage: string }> = {
  'nano-banana-pro': {
    h1: 'Nano Banana Pro 提示词',
    lead: 'Nano Banana Pro 是 Google DeepMind 的图像模型，它在两件多数模型仍做不好的事上格外出色：在图片内渲染可读文字，以及在高分辨率下保持精细细节。',
    usage: 'Nano Banana Pro 更偏好平实的描写句，而不是 Midjourney 式参数旗标。按顺序描述主体、光线、镜头，再写想嵌入的文字即可。',
  },
  gemini: {
    h1: 'Gemini AI 图像提示词',
    lead: 'Google Gemini 以对话方式处理图像：你可以先生成，再在同一轮对话里要求改动，而不必从头重写整条提示词。',
    usage: '用 Gemini 时，靠迭代而非重写。先生成初版，再逐条要求改动——"让光线更暖"、"裁切更紧"——它会在多轮间保留上下文。',
  },
  'chatgpt-image': {
    h1: 'ChatGPT 图像提示词',
    lead: 'ChatGPT 在聊天界面内使用 DALL·E 图像模型，当你还不确定想要什么时，它是最快的选择。',
    usage: 'ChatGPT 适合"一句主体 + 一句风格"的写法。若输出跑偏，让它基于上一张图出个变体，比新开一条提示词更稳。',
  },
  midjourney: {
    h1: 'Midjourney 提示词',
    lead: 'Midjourney 在风格化、绘画感与电影感输出上依旧最强，其参数旗标让你精确控制画面比例与风格化程度。',
    usage: 'Midjourney 是这里唯一偏好参数旗标的模型。用 --ar 控制比例、--s 控制风格化；省略则默认 1:1。',
  },
  flux: {
    h1: 'Flux AI 图像提示词',
    lead: 'Flux 来自 Black Forest Labs，是领先的开权重图像模型，意味着你可以本地部署，把所有提示词与输出都留在自己的硬件上。',
    usage: 'Flux 很"实诚"：它会紧贴提示词，比 Midjourney 少做风格化解读，所以要把情绪和光线写明确，别只靠形容词。',
  },
};

export async function getStaticPaths({ paginate }: any) {
  // getStaticPaths 被 Astro 提取到独立模块，只能访问 import；去重在此处本地完成
  const deduped = [...new Map(prompts.map((p) => [p.slug, p])).values()];
  const list = Object.values(engines).filter((e) => e.key !== 'other');
  return list
    .map((engine) => ({
      engine,
      items: deduped
        .filter((p) => p.engines.includes(engine.key as Prompt['engines'][number]))
        .sort((a, b) => (b.dateAdded || '').localeCompare(a.dateAdded || '')),
    }))
    .filter((g) => g.items.length > 0)
    .flatMap((g) =>
      paginate(g.items, {
        params: { engine: g.engine.key },
        props: { engine: g.engine },
        pageSize: 48,
      })
    );
}

const { page } = Astro.props;
const { engine } = Astro.props as { engine: Engine };
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const isFirst = page.currentPage === 1;
const suffix = isFirst ? '' : ` — 第 ${page.currentPage} 页`;

const copy = MODEL_COPY[engine.key] || {
  h1: `${engine.nameZh}提示词`,
  lead: engine.descZh || engine.descEn,
  usage: `这些提示词已针对 ${engine.nameZh} 测试过。先原样复制一条，再每次只改动一个变量，观察模型对什么有反应。`,
};

const total = allPrompts.filter((p) => p.engines.includes(engine.key as Prompt['engines'][number])).length;
const title = `${copy.h1}${suffix}`;
const description = isFirst
  ? `共 ${total} 条可直接复制的 ${engine.nameZh}提示词，每条都配有真实示例图与经过测试的参数。${engine.descZh || engine.descEn}`
  : `${copy.h1} — 第 ${page.currentPage} / ${page.lastPage} 页。`;

const siteBase = Astro.site ?? new URL('https://aiartspell.art');

function pageHref(key: string, n: number) {
  return n === 1 ? `${base}/zh/models/${key}/` : `${base}/zh/models/${key}/${n}/`;
}
const pageNumbers = Array.from({ length: page.lastPage }, (_, i) => i + 1).filter(
  (n) => n === 1 || n === page.lastPage || n % 5 === 0 || Math.abs(n - page.currentPage) <= 2
);

// FAQ 随模型名变化
const faqList = [
  {
    q: `${engine.nameZh}是什么？`,
    a: (engine.descZh || engine.descEn) + ` 官方地址：${engine.url.replace(/^https?:\/\//, '')}。`,
  },
  {
    q: `怎么写出好的 ${engine.nameZh}提示词？`,
    a: copy.usage,
  },
  {
    q: `这些 ${engine.nameZh}提示词可以免费使用吗？`,
    a: '可以。本页所有提示词均可免费复制并改编。每条都标注了原作者，公开发布结果时请注明原始创作者。',
  },
  {
    q: `这里共有多少条 ${engine.nameZh}提示词？`,
    a: `本库共有 ${total} 条 ${engine.nameZh}提示词，每条都配有真实示例图与经过测试的表述，用下方分页即可浏览全部。`,
  },
];

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: '首页', item: new URL('/zh/', siteBase).toString() },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'AI 生图提示词',
      item: new URL('/zh/ai-image-prompts/', siteBase).toString(),
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: copy.h1,
      item: new URL(`/zh/models/${engine.key}/`, siteBase).toString(),
    },
  ],
};

const itemListLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: `${copy.h1}${suffix}`,
  numberOfItems: page.data.length,
  itemListElement: page.data.map((p: Prompt, i: number) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: p.title,
    url: new URL(`/zh/prompt/${p.slug}/`, siteBase).toString(),
  })),
};

const faqLd = isFirst
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: faqList.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    }
  : null;
---

<Base title={title} description={description}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(itemListLd)} />
  {faqLd && <script slot="head" type="application/ld+json" set:html={JSON.stringify(faqLd)} />}

  <section class="section">
    <div class="container">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href={`${base}/zh/`}>首页</a>
        <span aria-hidden="true">/</span>
        <a href={`${base}/zh/ai-image-prompts/`}>AI 生图提示词</a>
        <span aria-hidden="true">/</span>
        <span>{engine.nameZh}</span>
      </nav>

      <h1>{copy.h1}{suffix}</h1>
      <p class="page-count">共 {total} 条提示词 · 第 {page.currentPage} / {page.lastPage} 页</p>

      {
        isFirst && (
          <>
            <p class="lead">
              <strong>{total} 条可直接复制的 {engine.nameZh}提示词</strong>，每条都配有真实示例图与经过测试的参数。{copy.lead}
            </p>
            <p class="usage">{copy.usage}</p>
            <p class="official">
              官方站点：<a href={engine.url} rel="noopener nofollow" target="_blank">{engine.url.replace(/^https?:\/\//, '')}</a>
            </p>
          </>
        )
      }

      <div class="grid">
        {
          page.data.map((p: Prompt) => (
            <div class="card-wrap">
              <PromptCard prompt={p} base={base} />
            </div>
          ))
        }
      </div>

      <nav class="pager" aria-label="Pagination">
        {page.url.prev ? <a href={page.url.prev}>← 上一页</a> : <span class="pager-off">← 上一页</span>}
        <div class="pager-nums">
          {
            pageNumbers.map((n: number) =>
              n === page.currentPage ? (
                <span class="pager-cur">{n}</span>
              ) : (
                <a href={pageHref(engine.key, n)}>{n}</a>
              )
            )
          }
        </div>
        {page.url.next ? <a href={page.url.next}>下一页 →</a> : <span class="pager-off">下一页 →</span>}
      </nav>

      {
        isFirst && (
          <section class="faq" aria-labelledby="faq-title">
            <h2 id="faq-title" class="sub">{engine.nameZh}提示词常见问题</h2>
            {faqList.map((f) => (
              <details>
                <summary>{f.q}</summary>
                <p>{f.a}</p>
              </details>
            ))}
          </section>
        )
      }
    </div>
  </section>
</Base>

<style>
  .crumbs { margin-bottom: 12px; color: var(--text-muted); font-size: 13px; }
  .crumbs a { color: var(--accent); text-decoration: none; }
  .crumbs a:hover { text-decoration: underline; }
  .page-count { margin: 6px 0 18px; color: var(--text-muted); font-size: 13px; }
  .lead { max-width: 780px; margin: 0 0 16px; line-height: 1.75; }
  .usage { max-width: 780px; margin: 0 0 12px; color: var(--text-muted); line-height: 1.75; font-size: 14px; }
  .official { margin: 0 0 26px; font-size: 13px; color: var(--text-muted); }
  .official a { color: var(--accent); }
  .sub { margin: 32px 0 14px; font-size: 19px; }
  .pager {
    display: flex; flex-wrap: wrap; align-items: center; justify-content: center;
    gap: 8px; margin: 32px 0 8px;
  }
  .pager a, .pager span {
    min-width: 36px; padding: 7px 11px; border: 1px solid var(--border);
    border-radius: 8px; background: var(--bg-card); color: var(--text);
    font-size: 13px; text-align: center; text-decoration: none;
  }
  .pager a:hover { border-color: var(--accent); color: var(--accent); }
  .pager .pager-cur { border-color: var(--accent); background: var(--accent); color: #fff; font-weight: 600; }
  .pager .pager-off { opacity: 0.4; }
  .pager-nums { display: flex; flex-wrap: wrap; gap: 6px; }
  .faq details {
    margin-bottom: 10px; padding: 12px 16px; border: 1px solid var(--border);
    border-radius: var(--radius); background: var(--bg-card);
  }
  .faq summary { cursor: pointer; font-weight: 600; font-size: 14px; }
  .faq details p { margin: 10px 0 0; color: var(--text-muted); font-size: 14px; line-height: 1.7; }
</style>
