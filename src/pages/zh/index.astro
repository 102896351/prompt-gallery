---
import Base from '../../layouts/Base.astro';
import PromptCard from '../../components/PromptCard.astro';
import { prompts, promptCategories, type Prompt } from '../../data/prompts';
import { collections } from '../../data/collections';
import { zh } from '../../i18n';

const t = zh;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const siteBase = Astro.site ?? new URL('https://prompt-gallery.example.com');

// 专题（右栏）：5 个随机专题轮换。从 collections.ts 单一数据源
// pick 5 个；只 build-time 选定，不重复。
const specialSlugs = [
  'collection-18',
  'collection-16',
  'collection-20',
  'collection-14',
  'collection-09',
];
const specials = specialSlugs
  .map((s) => collections.find((c) => c.slug === s))
  .filter((c): c is NonNullable<typeof c> => Boolean(c));

const featuredSlugs = [
  'sci-fi-sculptural-representation-zhi-zi-and-trisolar-system',
  'cloud-white-earphone-making-process-share',
  'shout-with-me-and-i-will-be-your-girlfriend',
  'artistic-elevation-street-fighter-character-portfolio',
  'dress-from-the-inside-out-clothing-isn-t-just-a-uniform',
  'atmospheric-haze-scene',
  'today-post-text-clothing-first-step',
  'fireworks-over-waterfront-city-at-night',
  'ingredient-orbit-shot',
  'silhouette-photography',
  'hero-gazing-out-at-the-stormy-sea',
  'the-architecture-of-becoming',
  'exploring-the-miniature-world',
  'mcdonalds-advertising-workflow-sharing',
  'baoyu-teacher-s-movie-style-miniature-diorama',
  'teach-easily-create-edc-image-conventional-mystery-box-mode-full-analysis',
  'mirror-product-photography',
  'product-interaction-photography-powder-explosion',
  'gemini-nano-banana-pro-product-shot',
  'infographic-indian-man-yoga-steps-aesthetics',
  'exaggerated-perspective-illustration-style-analysis',
  'nano-banana-pro-dragon-ball-z-style-q-version-pseudo-3d-illustration',
  'one-piece-style-devil-fruit-ability-transformation',
  'miniature-world-inside-a-sphere',
  'wuta-zhenri-poster-contest',
  'kling-o1-poster-generation',
  'text-rendering-parameters-in-image-prompts',
  'porcelain-sculpture-figurine-friens-dreamlike-art',
  'high-end-leather-clutch',
  'surreal-bird-fantasy',
  'cyber-business-card',
  'time-traveling-filter-old-photograph-restoration',
  'transparent-typographic-garment-nanobanana-ver1-2-guide',
  'a-mesmerizing-passage-of-time-at-shanghai-bund',
  'y2k-aesthetic-city-impression-collage-poster',
  'nano-banana-pro-t0r7mf',
  'ultra-cute-isometric-3d-miniature-chengdu-city-diorama-with-panda-theme',
  'eternal-cycle-of-architecture-of-mortality',
  'perfect-miniature-banknote',
  'floating-product-photography',
];
const featured = featuredSlugs
  .map((s) => prompts.find((p) => p.slug === s))
  .filter(Boolean) as Prompt[];

// Hero banner：取前 5 条精选的首图作为轮播背景（与 i18n hero.slides 数量一致）
const bannerImages = featured
  .slice(0, 5)
  .map((p) => p.images[0]?.src)
  .filter((src): src is string => Boolean(src));

// 按 dateAdded 倒序排序（最新添加的排前）；同日期内用 quality score 兜底
const sorted = [...prompts].sort((a, b) => {
  const dateDiff = (b.dateAdded || '').localeCompare(a.dateAdded || '');
  if (dateDiff !== 0) return dateDiff;
  // tiebreaker: 图多、可复用、英文优先
  const score = (p: Prompt) => (p.images.length >= 2 ? 4 : 0) + (p.reusable ? 3 : 0) + (p.language === 'en' ? 2 : 0) + Math.min(p.difficulty, 5);
  return score(b) - score(a);
});
// grid 排除已展示的 featured 6 条，避免重复
const featuredSet = new Set(featuredSlugs);
const sortedExcludingFeatured = sorted.filter((p) => !featuredSet.has(p.slug));

const itemListLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Ai Art Spell - 精选 AI 图像生成提示词',
  description: t.siteTagline,
  url: new URL('/zh/', siteBase).toString(),
  numberOfItems: prompts.length,
  itemListElement: prompts.slice(0, 50).map((p, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: p.title,
    url: new URL(`/zh/prompt/${p.slug}/`, siteBase).toString(),
    description: p.tagline,
  })),
};
---

<Base>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(itemListLd)} />
  {/* Preload hero banner 第一张图：CSS background-image 也能借此机会提前下载（救 LCP） */}
  {bannerImages[0] && (
    <link slot="head" rel="preload" as="image" href={bannerImages[0]} fetchpriority="high" />
  )}

  <section class="hero">
    <!-- Banner 轮播背景（淡入淡出） -->
    <div class="hero-banner" data-hero-banner aria-hidden="true">
      {bannerImages.map((src, i) => (
        <div
          class={`hero-banner-slide${i === 0 ? ' active' : ''}`}
          data-hero-slide={String(i)}
          style={`background-image: url(${src})`}
        />
      ))}
      <div class="hero-banner-overlay" />
    </div>

    <div class="container hero-content">
      <h1>
        <span class="grad">{t.hero.titlePrefix}</span><br />
        {t.hero.titleSuffix}
      </h1>
      <div class="search-wrap">
        <input
          type="text"
          id="prompt-search"
          placeholder={t.hero.searchPlaceholder}
          autocomplete="off"
          aria-label="搜索提示词"
        />
        <button type="button" class="search-clear" data-search-clear aria-label="清空搜索" hidden>×</button>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="fs-row">
        <!-- LEFT: 精品 8 张小卡片横滚 -->
        <div class="fs-col">
          <div class="fs-col-head">
            <h2>{t.section.featured}</h2>
            <span class="count">{t.section.countPicks(featured.length)}</span>
          </div>
          <p class="editorial-meta" style="font-size: 12px; margin: 0 0 12px;">
            为 AI 图像生成社区精选
          </p>
          <div class="carousel" data-featured-carousel data-per-page="8">
            <div class="carousel-track" data-featured-track>
              {featured.map((p, i) => (
                <div class="carousel-slide" data-featured-slide>
                  <PromptCard
                    prompt={p}
                    base={base}
                    overlay={true}
                    newTab={true}
                    eager={i < 2}
                    fetchpriority={i < 2 ? 'high' : 'auto'}
                  />
                </div>
              ))}
            </div>
            <button type="button" class="carousel-arrow carousel-prev" data-featured-prev aria-label="上一组">‹</button>
            <button type="button" class="carousel-arrow carousel-next" data-featured-next aria-label="下一组">›</button>
            <div class="carousel-dots" data-featured-dots></div>
          </div>
        </div>

        <!-- RIGHT: 专题 5 张大图轮换 -->
        <div class="fs-col">
          <div class="fs-col-head">
            <h2>{t.section.specials}</h2>
            <a href={`${base}/zh/collections/`}>{t.section.specialsBrowse}</a>
          </div>
          <p class="editorial-meta" style="font-size: 12px; margin: 0 0 12px;">
            编辑精选的主题提示词合集
          </p>
          <div class="specials-cover" data-specials-cover>
            {specials.map((c, i) => (
              <a
                class="specials-image-link"
                data-specials-link={String(i)}
                href={`${base}/zh/collections/${c.slug}/`}
                style={i === 0 ? '' : 'display:none;'}
                aria-label={`打开专题：${c.title}`}
              >
                <img
                  src={c.cover}
                  alt={c.title}
                  data-specials-img={String(i)}
                  data-title={c.title}
                  data-desc={c.description}
                  data-href={`${base}/zh/collections/${c.slug}/`}
                  class={i === 0 ? 'active' : ''}
                  loading={i === 0 ? 'eager' : 'lazy'}
                  fetchpriority={i === 0 ? 'high' : 'auto'}
                  decoding="async"
                />
              </a>
            ))}
            <div class="specials-overlay">
              <h3 data-specials-title>{specials[0]?.title}</h3>
              <p data-specials-desc>{specials[0]?.description}</p>
            </div>
          </div>
          <div class="specials-dots" data-specials-dots>
            {specials.map((_, i) => (
              <button
                type="button"
                class={`specials-dot${i === 0 ? ' active' : ''}`}
                data-specials-dot={String(i)}
                aria-label={`显示专题 ${i + 1}`}
              />
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="all">
    <div class="container">
      <div class="section-head">
        <h2>{t.section.all}</h2>
        <span class="count" id="result-count">{t.section.countPrompts(sorted.length)}</span>
      </div>

      <div class="pills" id="filter-pills">
        <button class="pill active" data-cat="all">{t.filter.all}</button>
        {promptCategories.map((c) => (
          <button class="pill" data-cat={c.id}>{c.labelZh}</button>
        ))}
      </div>

      <div class="grid" id="prompt-grid">
        {sortedExcludingFeatured.map((p) => (
          <div
            class="card-wrap"
            data-name={p.title.toLowerCase()}
            data-cat={p.category}
            data-tags={p.tags.join(' ')}
            data-engines={p.engines.join(' ')}
            data-author={p.source.authorName.toLowerCase()}
          >
            <PromptCard prompt={p} base={base} newTab={true} />
          </div>
        ))}
      </div>

      <p class="empty hidden" id="empty-state">{t.section.emptyState}</p>
    </div>
  </section>
</Base>

<style>
  .editorial-meta {
    color: var(--text-muted);
    font-size: 13px;
    margin: 0 0 24px;
  }
  /* 分页样式已移除（瀑布流模式） */
  /* ---- 精选轮播 (水平滚动 carousel) ---- */
  .carousel {
    position: relative;
    margin: 0 0 8px;
  }
  .carousel-track {
    display: flex;
    gap: 12px;
    overflow-x: auto;
    scroll-behavior: smooth;
    scroll-snap-type: x mandatory;
    padding: 8px 4px 16px;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: thin;
    scrollbar-color: var(--border) transparent;
  }
  .carousel-track::-webkit-scrollbar { height: 6px; }
  .carousel-track::-webkit-scrollbar-track { background: transparent; }
  .carousel-track::-webkit-scrollbar-thumb {
    background: var(--border);
    border-radius: 3px;
  }
  .carousel-slide {
    flex: 0 0 240px;
    scroll-snap-align: start;
    box-sizing: border-box;
  }
  .carousel-arrow {
    position: absolute;
    top: 40%;
    transform: translateY(-50%);
    z-index: 5;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: 1px solid var(--border);
    background: rgba(255, 255, 255, 0.95);
    color: var(--text);
    font-size: 22px;
    line-height: 1;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.15s, border-color 0.15s, opacity 0.15s;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
  }
  .carousel-arrow:hover {
    background: #fff;
    border-color: var(--accent);
    color: var(--accent);
  }
  .carousel-arrow[aria-disabled="true"] {
    opacity: 0.3;
    cursor: default;
    pointer-events: none;
  }
  .carousel-prev { left: -8px; }
  .carousel-next { right: -8px; }
  .carousel-dots {
    display: flex;
    justify-content: center;
    gap: 6px;
    margin-top: 4px;
  }
  .carousel-dot {
    width: 6px;
    height: 6px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: var(--border);
    cursor: pointer;
    transition: all 0.15s;
  }
  .carousel-dot.active {
    background: var(--accent);
    width: 18px;
    border-radius: 3px;
  }
  @media (max-width: 900px) {
    .carousel-slide { flex: 0 0 200px; }
    .carousel-arrow { width: 32px; height: 32px; font-size: 18px; }
  }
  @media (max-width: 560px) {
    .carousel-slide { flex: 0 0 160px; }
  }
</style>

<script is:inline>
  // ===== 专题 (右栏): 5 张 collection cover 自动轮换 =====
  (function () {
    const cover = document.querySelector('[data-specials-cover]');
    if (!cover) return;
    const imgs = cover.querySelectorAll('[data-specials-img]');
    const imageLinks = cover.querySelectorAll('[data-specials-link]');
    const dots = document.querySelectorAll('[data-specials-dot]');
    const titleEl = cover.querySelector('[data-specials-title]');
    const descEl = cover.querySelector('[data-specials-desc]');
    const linkEl = cover.querySelector('[data-specials-link]');
    if (imgs.length < 2) return;
    let current = 0;
    let timer = null;
    function show(idx) {
      current = (idx + imgs.length) % imgs.length;
      imageLinks.forEach((link, i) => {
        link.style.display = i === current ? 'block' : 'none';
      });
      imgs.forEach((img, i) => {
        const active = i === current;
        img.style.display = active ? 'block' : 'none';
        img.classList.toggle('active', active);
      });
      dots.forEach((d, i) => d.classList.toggle('active', i === current));
      const dataTitle = imgs[current].getAttribute('data-title');
      const dataDesc = imgs[current].getAttribute('data-desc');
      const dataHref = imgs[current].getAttribute('data-href');
      if (titleEl && dataTitle) titleEl.textContent = dataTitle;
      if (descEl && dataDesc) descEl.textContent = dataDesc;
      if (linkEl && dataHref) linkEl.setAttribute('href', dataHref);
    }
    function next() { show(current + 1); }
    function start() { stop(); timer = setInterval(next, 5000); }
    function stop() { if (timer) { clearInterval(timer); timer = null; } }
    dots.forEach((d, i) => d.addEventListener('click', () => { show(i); start(); }));
    cover.addEventListener('mouseenter', stop);
    cover.addEventListener('mouseleave', start);
    document.addEventListener('visibilitychange', () => {
      document.hidden ? stop() : start();
    });
    show(0);
    start();
  })();
</script>

<script is:inline>
  // ===== 精选轮播 (水平滚动, 每次滑 1 张) =====
  (function () {
    const carousel = document.querySelector('[data-featured-carousel]');
    if (!carousel) return;
    const track = carousel.querySelector('[data-featured-track]');
    const slides = carousel.querySelectorAll('[data-featured-slide]');
    const prevBtn = carousel.querySelector('[data-featured-prev]');
    const nextBtn = carousel.querySelector('[data-featured-next]');
    const dotsBox = carousel.querySelector('[data-featured-dots]');
    const total = slides.length;
    if (total === 0) return;
    let timer = null;

    function stepWidth() {
      if (slides.length === 0) return 252;
      const slide = slides[0];
      const style = window.getComputedStyle(track);
      const gap = parseFloat(style.gap) || 12;
      return slide.getBoundingClientRect().width + gap;
    }
    function visibleCount() {
      return Math.max(1, Math.floor(track.clientWidth / stepWidth()));
    }

    function updateArrows() {
      const scrollLeft = track.scrollLeft;
      const max = track.scrollWidth - track.clientWidth - 2;
      if (prevBtn) prevBtn.setAttribute('aria-disabled', scrollLeft < 2 ? 'true' : 'false');
      if (nextBtn) nextBtn.setAttribute('aria-disabled', scrollLeft >= max ? 'true' : 'false');
    }
    function next() { track.scrollBy({ left: stepWidth(), behavior: 'smooth' }); }
    function prev() { track.scrollBy({ left: -stepWidth(), behavior: 'smooth' }); }

    prevBtn?.addEventListener('click', () => { prev(); stopAuto(); });
    nextBtn?.addEventListener('click', () => { next(); stopAuto(); });

    let scrollTicking = false;
    track.addEventListener('scroll', () => {
      if (!scrollTicking) {
        window.requestAnimationFrame(() => { updateArrows(); scrollTicking = false; });
        scrollTicking = true;
      }
    });

    if (dotsBox) dotsBox.style.display = 'none';

    function startAuto() {
      stopAuto();
      timer = setInterval(() => {
        const max = track.scrollWidth - track.clientWidth - 2;
        if (track.scrollLeft >= max) {
          track.scrollTo({ left: 0, behavior: 'smooth' });
        } else {
          next();
        }
      }, 4000);
    }
    function stopAuto() { if (timer) { clearInterval(timer); timer = null; } }
    carousel.addEventListener('mouseenter', stopAuto);
    carousel.addEventListener('mouseleave', startAuto);
    document.addEventListener('visibilitychange', () => {
      document.hidden ? stopAuto() : startAuto();
    });
    window.addEventListener('resize', updateArrows);

    updateArrows();
    startAuto();
  })();

  // ===== Hero banner 轮播（背景图；文字与圆点已按需求移除）=====
  (function () {
    const banner = document.querySelector('[data-hero-banner]');
    if (!banner) return;
    const slides = banner.querySelectorAll('[data-hero-slide]');
    const total = slides.length;
    if (total === 0) return;
    let current = 0;
    let timer = null;

    function show(idx) {
      current = (idx + total) % total;
      slides.forEach((s, i) => s.classList.toggle('active', i === current));
    }
    function next() { show(current + 1); }
    function startAuto() { stopAuto(); timer = setInterval(next, 5000); }
    function stopAuto() { if (timer) { clearInterval(timer); timer = null; } }

    banner.addEventListener('mouseenter', stopAuto);
    banner.addEventListener('mouseleave', startAuto);

    document.addEventListener('visibilitychange', () => {
      document.hidden ? stopAuto() : startAuto();
    });

    startAuto();
  })();

  // ===== 首页搜索/筛选 =====
  (function () {
    const search = document.getElementById('prompt-search');
    const pills = document.querySelectorAll('#filter-pills .pill');
    const grid = document.getElementById('prompt-grid');
    const featuredGrid = document.getElementById('featured-grid');
    const emptyState = document.getElementById('empty-state');
    const count = document.getElementById('result-count');
    if (!grid || !search) return;

    let activeCat = 'all';
    let activeQuery = '';

    function apply() {
      let visible = 0;
      const wraps = grid.querySelectorAll('.card-wrap');
      const query = activeQuery.toLowerCase().trim();
      wraps.forEach((w) => {
        const cat = w.dataset.cat;
        const tags = w.dataset.tags || '';
        const engines = w.dataset.engines || '';
        const author = w.dataset.author || '';
        const name = w.dataset.name || '';
        const matchCat = activeCat === 'all' || cat === activeCat;
        const matchQuery = !query ||
          name.includes(query) ||
          tags.toLowerCase().includes(query) ||
          engines.toLowerCase().includes(query) ||
          author.includes(query);
        const show = matchCat && matchQuery;
        w.style.display = show ? '' : 'none';
        if (show) visible++;
      });
      if (emptyState) emptyState.classList.toggle('hidden', visible > 0);
      if (count) {
        const total = wraps.length;
        count.textContent = visible === total
          ? `${total} 条提示词`
          : `${visible} / ${total} 条`;
      }
      if (featuredGrid) {
        featuredGrid.parentElement.parentElement.style.display = query ? 'none' : '';
      }
    }

    search.addEventListener('input', (e) => {
      activeQuery = e.target.value;
      syncClearBtn();
      apply();
    });

    // ===== 搜索清除按钮：输入内容后显示，点击清空 =====
    const clearBtn = document.querySelector('[data-search-clear]');
    function syncClearBtn() {
      if (clearBtn) clearBtn.hidden = !search.value;
    }
    if (clearBtn) {
      clearBtn.addEventListener('click', () => {
        search.value = '';
        activeQuery = '';
        clearBtn.hidden = true;
        apply();
        search.focus();
      });
      syncClearBtn();
    }

    pills.forEach((p) => {
      p.addEventListener('click', () => {
        pills.forEach((q) => q.classList.remove('active'));
        p.classList.add('active');
        activeCat = p.dataset.cat;
        apply();
      });
    });

    // 同步 URL hash 到 activeCat：从详情页跳到 /zh/#portrait 时自动筛选
    function syncFromHash() {
      const hash = window.location.hash.replace('#', '');
      if (!hash || hash === 'featured') return;
      let target = null;
      pills.forEach((p) => {
        if (p.dataset.cat === hash || (hash === 'all' && p.dataset.cat === 'all')) {
          target = p;
        }
      });
      if (target) {
        pills.forEach((q) => q.classList.remove('active'));
        target.classList.add('active');
        activeCat = target.dataset.cat;
        apply();
        const section = document.getElementById('all');
        if (section) section.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    }
    syncFromHash();
    window.addEventListener('hashchange', syncFromHash);
    pills.forEach((p) => {
      p.addEventListener('click', () => {
        history.replaceState(null, '', '#' + p.dataset.cat);
      });
    });
  })();
</script>