---
import Base from '../../layouts/Base.astro';
import PromptCard from '../../components/PromptCard.astro';
import AgnesHomeComposer from '../../components/AgnesHomeComposer.astro';
import { prompts, promptCategories, type Prompt } from '../../data/prompts';
import { engines } from '../../data/engines';
import { zh } from '../../i18n';

const t = zh;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const siteBase = Astro.site ?? new URL('https://prompt-gallery.example.com');


// Hero banner：使用统一的本地横幅背景，避免首页首屏加载多张远程图片
const bannerImage = `${base}/banner_bg.jpg`;

// 按 dateAdded 倒序排序（最新添加的排前）；同日期内用 quality score 兜底
const sorted = [...prompts].sort((a, b) => {
  const dateDiff = (b.dateAdded || '').localeCompare(a.dateAdded || '');
  if (dateDiff !== 0) return dateDiff;
  // tiebreaker: 图多、可复用、英文优先
  const score = (p: Prompt) => (p.images.length >= 2 ? 4 : 0) + (p.reusable ? 3 : 0) + (p.language === 'en' ? 2 : 0) + Math.min(p.difficulty, 5);
  return score(b) - score(a);
});
// 首页只渲染「最新 48 条」（与英文站一致）。全量交由 /ai-image-prompts/ 分页承载。
// 原先渲染全部 1,188 条 → HTML 达 2MB、1,252 条内链，稀释权重也拖慢抓取。
const HOME_LATEST_COUNT = 48;
const latest = sorted.slice(0, HOME_LATEST_COUNT);

const categoryCards = promptCategories.map((category) => {
  const matches = prompts.filter((prompt) => prompt.category === category.id);
  return {
    ...category,
    count: matches.length,
    image: matches.find((prompt) => prompt.images[0]?.src)?.images[0],
  };
}).filter((category) => category.count > 0);

const modelCards = Object.values(engines)
  .map((engine) => ({
    ...engine,
    count: prompts.filter((prompt) => prompt.engines.includes(engine.key as Prompt['engines'][number])).length,
  }))
  .filter((engine) => engine.count > 0 && engine.key !== 'other')
  .sort((a, b) => b.count - a.count)
  .slice(0, 8);

const homepageKeywords = [
  '免费AI生图',
  'AI图片生成器',
  '在线AI生图',
  '文生图',
  'AI生图提示词',
  'AI绘画提示词',
  'AI人像提示词',
  'AI产品摄影提示词',
  'AI海报提示词',
  'AI 3D提示词',
  'AI插画提示词',
  '电影感提示词',
].join('，');

const itemListLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Ai Art Spell - 精选 AI 图像生成提示词',
  description: t.siteTagline,
  url: new URL('/zh/', siteBase).toString(),
  numberOfItems: prompts.length,
  itemListElement: sorted.slice(0, 50).map((p, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: p.title,
    url: new URL(`/zh/prompt/${p.slug}/`, siteBase).toString(),
    description: p.tagline,
  })),
};
---

<Base title="免费AI生图与AI生图提示词" description="浏览免费 AI 生图提示词、AI绘画提示词、AI人像、产品摄影、海报、3D、插画和电影感案例，并在线使用 AI 图片生成器创作。">
  <Fragment slot="head"><meta name="keywords" content={homepageKeywords} /></Fragment>  <script slot="head" type="application/ld+json" set:html={JSON.stringify(itemListLd)} />
  {/* 预加载唯一的本地横幅图，保持首屏稳定 */}
  <link slot="head" rel="preload" as="image" href={bannerImage} fetchpriority="high" />

  <section class="hero">
    <div class="hero-banner" data-hero-banner aria-hidden="true">
      <img
        class="hero-banner-slide active"
        src={bannerImage}
        alt=""
        aria-hidden="true"
        width="2017"
        height="346"
        fetchpriority="high"
        decoding="async"
      />
      <div class="hero-banner-overlay" />
    </div>

    <div class="container hero-content">
      <h1>
        <span class="grad">AI生图提示词</span><br />
        与在线图片生成。
      </h1>
      <p class="hero-subtitle">浏览可直接复制的 AI生图提示词和 AI绘画提示词，查看真实示例图片，再把灵感送入本站 AI 图片生成器在线创作。</p>
      <p class="hero-keywords">AI人像提示词 · AI产品摄影提示词 · AI海报提示词 · AI 3D提示词 · AI插画提示词 · 电影感提示词</p>
      <div class="search-wrap">
        <input
          type="text"
          id="prompt-search"
          placeholder={t.hero.searchPlaceholder}
          autocomplete="off"
          aria-label="搜索提示词"
        />
        <button type="button" class="search-clear" data-search-clear aria-label="清空搜索" hidden>×</button>
      </div>
    </div>
  </section>

  <AgnesHomeComposer locale="zh" />


  <section class="homepage-intro" aria-label="关于 AI 生图提示词库">
    <div class="container">
      <p><strong>AI生图提示词与 AI绘画提示词</strong>，配有示例图片、可复用创意和主题合集，覆盖人像、产品摄影、海报、3D、插画和电影感图片生成。</p>
      <p class="homepage-intro-detail">每条提示词都配有真实示例、作者来源和可复制文本。你可以先按分类或 AI 模型浏览，也可以直接打开 AI 图片生成器在线生成同款灵感。</p>
    </div>
  </section>

  <section class="homepage-discovery section" aria-labelledby="browse-categories-title">
    <div class="container">
      <div class="section-head">
        <div>
          <h2 id="browse-categories-title">按分类浏览 AI生图提示词</h2>
          <p class="section-lead">从人像、摄影、产品、海报、3D 渲染和插画中找到下一条灵感。</p>
        </div>
        <a href="/zh/ai-image-prompts/">查看全部提示词 →</a>
      </div>
      <div class="discovery-grid discovery-category-grid">
        {categoryCards.map((category) => (
          <a class="discovery-card" href={`/zh/prompts/${category.id}/`} data-discovery-category={category.id}>
            {category.image ? <img src={category.image.src} alt="" loading="lazy" width={category.image.width || 500} height={Math.round((category.image.width || 500) * 0.75)} /> : <span class="discovery-card-placeholder" aria-hidden="true" />}
            <span class="discovery-card-body">
              <strong>AI{category.labelZh}提示词</strong>
              <span>{category.description}</span>
              <small>{category.count} 条提示词 →</small>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="homepage-discovery section" aria-labelledby="browse-models-title">
    <div class="container">
      <div class="section-head">
        <div>
          <h2 id="browse-models-title">按 AI 模型浏览提示词</h2>
          <p class="section-lead">查看适用于主流 AI 图片生成工具的提示词案例。</p>
        </div>
        <a href={`${base}/tools/`}>查看 AI 工具 →</a>
      </div>
      <div class="model-link-grid">
        {modelCards.map((model) => (
          <a class="model-link-card" href={`/zh/models/${model.key}/`}>
            <span class="model-link-icon">{model.emoji}</span>
            <span><strong>{model.nameZh}提示词</strong><small>{model.count} 条案例</small></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section" id="all">
    <div class="container">
      <div class="section-head">
        <h2>{t.section.all}</h2>
        <span class="count" id="result-count">最新 {latest.length} / 共 {prompts.length} 条</span>
      </div>

      <!-- 分类 pill 改为真实聚合页链接（原先是 #anchor，无落地页） -->
      <div class="pills" id="filter-pills">
        <a class="pill active" href="/zh/ai-image-prompts/">{t.filter.all}</a>
        {promptCategories.map((c) => (
          <a class="pill" href={`/zh/prompts/${c.id}/`}>{c.labelZh}</a>
        ))}
      </div>

      <div class="grid" id="prompt-grid">
        {latest.map((p) => (
          <div
            class="card-wrap"
            data-name={p.title.toLowerCase()}
            data-cat={p.category}
            data-tags={p.tags.join(' ')}
            data-engines={p.engines.join(' ')}
            data-author={p.source.authorName.toLowerCase()}
          >
            <PromptCard prompt={p} base={base} newTab={true} />
          </div>
        ))}
      </div>

      <div class="view-all-wrap">
        <a class="view-all-btn" href="/zh/ai-image-prompts/">
          浏览全部 {prompts.length} 条提示词 →
        </a>
      </div>


      <p class="empty hidden" id="empty-state">{t.section.emptyState}</p>
    </div>
  </section>
</Base>

<style>
  .hero-subtitle,
  .hero-keywords {
    max-width: 760px;
    margin: 14px auto 0;
    color: rgba(255, 255, 255, 0.92);
    text-align: center;
    line-height: 1.6;
  }
  .hero-keywords {
    margin-top: 8px;
    color: rgba(255, 255, 255, 0.76);
    font-size: 12px;
  }
  .homepage-intro-detail {
    margin: 8px 0 0;
    color: var(--text-muted);
    font-size: 13px;
  }
  .homepage-discovery .section-head { align-items: flex-start; }
  .section-lead {
    margin: 6px 0 0;
    color: var(--text-muted);
    font-size: 13px;
  }
  .discovery-grid {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 12px;
  }
  .discovery-card,
  .model-link-card {
    color: inherit;
    text-decoration: none;
  }
  .discovery-card {
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg-card);
    transition: transform 0.18s ease, box-shadow 0.18s ease, border-color 0.18s ease;
  }
  .discovery-card:hover {
    border-color: var(--accent);
    box-shadow: var(--shadow-sm);
    transform: translateY(-2px);
  }
  .discovery-card img,
  .discovery-card-placeholder {
    display: block;
    width: 100%;
    height: 92px;
    object-fit: cover;
    background: var(--bg-soft);
  }
  .discovery-card-body {
    display: flex;
    min-height: 112px;
    flex-direction: column;
    gap: 5px;
    padding: 10px;
  }
  .discovery-card-body strong { font-size: 13px; line-height: 1.3; }
  .discovery-card-body span {
    display: -webkit-box;
    overflow: hidden;
    color: var(--text-muted);
    font-size: 11px;
    line-height: 1.4;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }
  .discovery-card-body small,
  .model-link-card small {
    margin-top: auto;
    color: var(--accent);
    font-size: 11px;
  }
  .model-link-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 10px;
  }
  .model-link-card {
    display: flex;
    min-height: 66px;
    align-items: center;
    gap: 10px;
    padding: 12px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg-card);
    transition: border-color 0.18s ease, transform 0.18s ease;
  }
  .model-link-card:hover { border-color: var(--accent); transform: translateY(-2px); }
  .model-link-icon {
    display: grid;
    width: 32px;
    height: 32px;
    flex: 0 0 32px;
    place-items: center;
    border-radius: 50%;
    background: var(--bg-soft);
    font-size: 18px;
  }
  .model-link-card > span:last-child {
    display: flex;
    min-width: 0;
    flex-direction: column;
    gap: 3px;
  }
  .model-link-card strong {
    overflow: hidden;
    font-size: 12px;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  @media (max-width: 900px) { .discovery-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (max-width: 600px) {
    .hero-subtitle { font-size: 13px; }
    .hero-keywords { font-size: 11px; }
    .discovery-grid,
    .model-link-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .discovery-card img,
    .discovery-card-placeholder { height: 78px; }
  }
  .editorial-meta {
    color: var(--text-muted);
    font-size: 13px;
    margin: 0 0 24px;
  }
  /* 分页样式已移除（瀑布流模式） */
  /* ---- 精选轮播 (水平滚动 carousel) ---- */
  .carousel {
    position: relative;
    margin: 0 0 8px;
  }
  .carousel-track {
    display: flex;
    gap: 12px;
    overflow-x: auto;
    scroll-behavior: smooth;
    scroll-snap-type: x mandatory;
    padding: 8px 4px 16px;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: thin;
    scrollbar-color: var(--border) transparent;
  }
  .carousel-track::-webkit-scrollbar { height: 6px; }
  .carousel-track::-webkit-scrollbar-track { background: transparent; }
  .carousel-track::-webkit-scrollbar-thumb {
    background: var(--border);
    border-radius: 3px;
  }
  .carousel-slide {
    flex: 0 0 240px;
    scroll-snap-align: start;
    box-sizing: border-box;
  }
  .carousel-arrow {
    position: absolute;
    top: 40%;
    transform: translateY(-50%);
    z-index: 5;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: 1px solid var(--border);
    background: rgba(255, 255, 255, 0.95);
    color: var(--text);
    font-size: 22px;
    line-height: 1;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.15s, border-color 0.15s, opacity 0.15s;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
  }
  .carousel-arrow:hover {
    background: #fff;
    border-color: var(--accent);
    color: var(--accent);
  }
  .carousel-arrow[aria-disabled="true"] {
    opacity: 0.3;
    cursor: default;
    pointer-events: none;
  }
  .carousel-prev { left: -8px; }
  .carousel-next { right: -8px; }
  .carousel-dots {
    display: flex;
    justify-content: center;
    gap: 6px;
    margin-top: 4px;
  }
  .carousel-dot {
    width: 6px;
    height: 6px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: var(--border);
    cursor: pointer;
    transition: all 0.15s;
  }
  .carousel-dot.active {
    background: var(--accent);
    width: 18px;
    border-radius: 3px;
  }
  .view-all-wrap {
    margin-top: 28px;
    text-align: center;
  }
  .view-all-btn {
    display: inline-block;
    padding: 12px 28px;
    border: 1px solid var(--accent);
    border-radius: 999px;
    background: var(--bg-card);
    color: var(--accent);
    font-size: 14px;
    font-weight: 600;
    text-decoration: none;
    transition: background 0.18s ease, color 0.18s ease;
  }
  .view-all-btn:hover {
    background: var(--accent);
    color: #fff;
  }
  @media (max-width: 900px) {
    .carousel-slide { flex: 0 0 200px; }
    .carousel-arrow { width: 32px; height: 32px; font-size: 18px; }
  }
  @media (max-width: 560px) {
    .carousel-slide { flex: 0 0 160px; }
  }
</style>

<script is:inline>
  // ===== 精选轮播 (水平滚动, 每次滑 1 张) =====

  // ===== 首页搜索/筛选 =====
  (function () {
    const search = document.getElementById('prompt-search');
    const pills = document.querySelectorAll('#filter-pills .pill');
    const grid = document.getElementById('prompt-grid');    const emptyState = document.getElementById('empty-state');
    const count = document.getElementById('result-count');
    if (!grid || !search) return;

    let activeCat = 'all';
    let activeQuery = new URLSearchParams(window.location.search).get('q')?.trim() || '';
    if (activeQuery) search.value = activeQuery;

    function apply() {
      let visible = 0;
      const wraps = grid.querySelectorAll('.card-wrap');
      const query = activeQuery.toLowerCase().trim();
      wraps.forEach((w) => {
        const cat = w.dataset.cat;
        const tags = w.dataset.tags || '';
        const engines = w.dataset.engines || '';
        const author = w.dataset.author || '';
        const name = w.dataset.name || '';
        const matchCat = activeCat === 'all' || cat === activeCat;
        const matchQuery = !query ||
          name.includes(query) ||
          tags.toLowerCase().includes(query) ||
          engines.toLowerCase().includes(query) ||
          author.includes(query);
        const show = matchCat && matchQuery;
        w.style.display = show ? '' : 'none';
        if (show) visible++;
      });
      if (emptyState) emptyState.classList.toggle('hidden', visible > 0);
      if (count) {
        const total = wraps.length;
        count.textContent = visible === total
          ? `${total} 条提示词`
          : `${visible} / ${total} 条`;
      }
    }

    search.addEventListener('input', (e) => {
      activeQuery = e.target.value;
      syncClearBtn();
      apply();
    });

    // ===== 搜索清除按钮：输入内容后显示，点击清空 =====
    const clearBtn = document.querySelector('[data-search-clear]');
    function syncClearBtn() {
      if (clearBtn) clearBtn.hidden = !search.value;
    }
    if (clearBtn) {
      clearBtn.addEventListener('click', () => {
        search.value = '';
        activeQuery = '';
        clearBtn.hidden = true;
        apply();
        search.focus();
      });
      syncClearBtn();
    }

    // 分类 pill 已改为真实聚合页链接（/prompts/<cat>/），不再做客户端筛选

    // 初始化：调用一次 apply 让计数显示初始状态
    apply();

    // 回车 -> 跳转聚合页做全站搜索（首页只渲染最新 48 条，搜不全）
    search.addEventListener('keydown', (e) => {
      if (e.key !== 'Enter') return;
      const q = search.value.trim();
      window.location.href = q
        ? `/ai-image-prompts/?q=${encodeURIComponent(q)}`
        : `/ai-image-prompts/`;
    });
  })();
</script>