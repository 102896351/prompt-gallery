---
import Base from '../../layouts/Base.astro';
import { prompts } from '../../data/prompts';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
// 推荐前 6 个 prompt 给用户
const featured = prompts.slice(0, 6);
---

<Base title="404 · 页面未找到" description="您访问的页面不存在。可以浏览我们的提示词库或返回首页。" noAds noindex>
  <section class="hero not-found-hero">
    <div class="container">
      <div class="not-found-content">
        <div class="not-found-code">404</div>
        <h1>页面没找到</h1>
        <p class="not-found-sub">您访问的链接可能已失效，或内容已被移除。</p>
        <div class="not-found-actions">
          <a href={`${base}/zh/`} class="btn primary">← 返回首页</a>
          <a href={`${base}/zh/#all`} class="btn">浏览全部提示词</a>
          <a href={`${base}/zh/tools/`} class="btn">AI 工具集</a>
        </div>
      </div>

      <div class="not-found-suggest">
        <h2>或者浏览精选提示词：</h2>
        <div class="not-found-grid">
          {featured.map((p, i) => (
            <a href={`${base}/zh/prompt/${p.slug}/`} class="card not-found-card">
              <div class="not-found-card-cover">
                <img
                  src={p.images[0]?.src}
                  alt={p.title}
                  width="400"
                  height="300"
                  loading={i < 2 ? 'eager' : 'lazy'}
                  fetchpriority={i < 2 ? 'high' : 'auto'}
                  decoding={i < 2 ? 'sync' : 'async'}
                  referrerpolicy="no-referrer"
                  onerror="this.style.visibility='hidden'"
                />
              </div>
              <div class="not-found-card-body">
                <h3>{p.title}</h3>
                <span class="badge">{p.category}</span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .not-found-hero {
    padding: 80px 0 32px;
  }
  .not-found-content {
    text-align: center;
    max-width: 600px;
    margin: 0 auto 64px;
  }
  .not-found-code {
    font-size: 96px;
    font-weight: 800;
    line-height: 1;
    background: linear-gradient(135deg, var(--accent), var(--accent-2));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    margin-bottom: 16px;
    letter-spacing: -0.05em;
  }
  .not-found-content h1 {
    font-size: 28px;
    margin: 0 0 12px;
    color: var(--text);
  }
  .not-found-sub {
    color: var(--text-soft);
    font-size: 16px;
    margin: 0 0 24px;
  }
  .not-found-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    justify-content: center;
  }
  .not-found-suggest h2 {
    font-size: 18px;
    margin: 0 0 20px;
    color: var(--text-soft);
    font-weight: 600;
    text-align: center;
  }
  .not-found-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 16px;
  }
  .not-found-card {
    display: flex;
    flex-direction: column;
    padding: 0;
    overflow: hidden;
  }
  .not-found-card-cover {
    aspect-ratio: 4 / 3;
    background: var(--bg-soft);
    overflow: hidden;
  }
  .not-found-card-cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .not-found-card-body {
    padding: 12px 14px;
  }
  .not-found-card-body h3 {
    margin: 0 0 6px;
    font-size: 14px;
    font-weight: 600;
    line-height: 1.4;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .not-found-card-body .badge {
    font-size: 11px;
  }
</style>
