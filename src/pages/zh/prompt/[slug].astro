---
import Base from '../../../layouts/Base.astro';
import PromptImage from '../../../components/PromptImage.astro';
import PromptCard from '../../../components/PromptCard.astro';
import { prompts, promptCategories, getRelatedPrompts } from '../../../data/prompts';
import { getCompatibleEngines } from '../../../data/engines';
import { getDetailSeoTitle, getDetailSeoDescription } from '../../../utils/seo';
import { zh } from '../../../i18n';

export function getStaticPaths() {
  return prompts.map((p) => ({
    params: { slug: p.slug },
    props: { prompt: p },
  }));
}

const { prompt } = Astro.props;
const t = zh;
const messages = zh;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const cat = promptCategories.find((c) => c.id === prompt.category);
const related = getRelatedPrompts(prompt.slug, 8);
const fullPrompt = prompt.structuredData ? JSON.stringify(prompt.structuredData, null, 2) : prompt.prompt;
// 适用引擎列表（详情页底部"适用于"区块用）
const compatibleEngines = getCompatibleEngines(prompt.engines);
const verifiedEngineKeys = new Set(prompt.engines.filter((k: string) => k !== 'other'));
// 用于模型识别的文本：合并 prompt 原文 + structuredData（保证原文里的 "Gemini" 等关键词能被识别）
const textForModelDetection = [prompt.prompt, prompt.rawBlock, fullPrompt].filter(Boolean).join('\n');
// 中文页面：分类标签用 labelZh
const displayCatLabel = cat?.labelZh ?? cat?.label ?? prompt.category;
// 中文页面：标题用原文（中文用户直接看原标题）
const displayTitle = prompt.title;
// 引擎显示名（按 locale 翻译）
const engineLabel = (key: string) => (messages.engines as Record<string, string>)[key] ?? key;

// 从 prompt 文本中识别额外提到的模型/工具（按从大到小顺序，避免 Nano Banana 抢 Gemini）
const MODEL_PATTERNS: [RegExp, string][] = [
  [/\b(Gemini(?:\s*Nano\s*Banana)?(?:\s*Pro)?)\b/gi, 'gemini'],
  [/\b(Nano\s*Banana(?:\s*Pro)?)\b/gi, 'nano-banana-pro'],
  [/\b(ChatGPT|GPT-4o?|GPT\s*Image)\b/gi, 'chatgpt-image'],
  [/\b(Midjourney|MJ)\b/gi, 'midjourney'],
  [/\b(Stable\s*Diffusion|SD\s*XL|SD3?)\b/gi, 'stable-diffusion'],
  [/\b(Flux(?:\s*\.?\s*1)?)\b/gi, 'flux'],
  [/\b(Sora)\b/gi, 'sora'],
  [/\b(Veo)\b/gi, 'veo'],
  [/\b(Kling|可灵)\b/gi, 'kling'],
  [/\b(DALL[\s-]?E)\b/gi, 'chatgpt-image'],
  [/\b(Hailuo|海螺)\b/gi, 'other'],
  [/\b(Imagen)\b/gi, 'gemini'],
];
// 跑所有 pattern，按 match 区间去重（避免 Gemini 区间内的 Nano Banana 重复添加）
const detectedEngines = new Set<string>(prompt.engines);
for (const [re, key] of MODEL_PATTERNS) {
  re.lastIndex = 0;
  if (re.test(textForModelDetection)) detectedEngines.add(key);
}
const displayEngines = [...detectedEngines]
  .map(k => engineLabel(k))
  .filter(Boolean);
// 标签显示名
const tagLabel = (key: string) => (messages.tags as Record<string, string>)[key] ?? key;

// 站点基础 URL（上线时只需改 astro.config.mjs 的 site，无需改这里）
const siteBase = Astro.site ?? new URL('https://prompt-gallery.example.com');
const pageUrl = new URL(`/zh/prompt/${prompt.slug}`, siteBase).toString();
const homeUrl = new URL('/zh/', siteBase).toString();
const catUrl = new URL(`/zh/#${prompt.category}`, siteBase).toString();

// JSON-LD Article（CreativeWork 的子类型，利于 Google 收录长文式 prompt 卡片页）
const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: prompt.title,
  name: prompt.title,
  description: prompt.tagline,
  url: pageUrl,
  mainEntityOfPage: { '@type': 'WebPage', '@id': pageUrl },
  datePublished: prompt.dateAdded,
  dateModified: prompt.dateAdded,
  dateCreated: prompt.dateAdded,
  author: {
    '@type': 'Person',
    name: prompt.source.authorName,
    url: prompt.source.authorUrl,
  },
  publisher: {
    '@type': 'Organization',
    name: 'Ai Art Spell',
    logo: { '@type': 'ImageObject', url: new URL('favicon.jpg', siteBase).toString() },
  },
  keywords: prompt.tags.join(', '),
  ...(prompt.images[0] ? { image: [prompt.images[0].src] } : {}),
  ...(prompt.aspectRatio ? { aspectRatio: prompt.aspectRatio } : {}),
  ...(prompt.source.sourceUrl ? { sourceOrganization: { '@type': 'WebSite', url: prompt.source.sourceUrl } } : {}),
};

// JSON-LD BreadcrumbList（首页 > 分类 > prompt）
const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Ai Art Spell', item: homeUrl },
    { '@type': 'ListItem', position: 2, name: displayCatLabel, item: catUrl },
    { '@type': 'ListItem', position: 3, name: prompt.title, item: pageUrl },
  ],
};

// SEO 长尾：取第一个非 "other" 引擎作为显示名，兜底 "AI 图像"
const primaryEngineKey = prompt.engines.find(e => e !== 'other') || prompt.engines[0] || 'other';
const engineName = engineLabel(primaryEngineKey);

// JSON-LD FAQPage（中文版问题用中文，吃百度/搜狗长尾词）
const faqItems: Array<{ q: string; a: string }> = [
  {
    q: `这条「${prompt.title}」提示词是什么？`,
    a: prompt.tagline || `用于 ${engineName} AI 图像生成的${displayCatLabel}提示词。`,
  },
  {
    q: '这条提示词适用于哪些 AI 工具？',
    a: `兼容：${displayEngines.join('、')}。复制后粘贴到任一工具即可生成图片。`,
  },
  {
    q: '怎么使用这条提示词？',
    a: prompt.reusable && prompt.placeholders?.length
      ? `这是可复用模板，请将 ${prompt.placeholders.slice(0, 2).map(p => '`' + p + '`').join('、')} 等占位符替换为你自己的内容，然后粘贴到 ${engineName} 即可。`
      : `点击上方"复制提示词"按钮，粘贴到 ${engineName} 或其他兼容的 AI 图像生成工具中生成。可根据具体需求微调提示词。`,
  },
  {
    q: '生成的图片可以商用吗？',
    a: `请查阅原始来源（${prompt.source.platform}）的授权条款。本站仅整理提示词文本，图片版权归原作者所有。`,
  },
];
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map(item => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};

// meta keywords: Bing/Yandex 用
const metaKeywords = [
  prompt.title,
  `${engineName} 提示词`,
  `${displayCatLabel}提示词`,
  `${engineName} ${displayCatLabel}`,
  ...prompt.tags,
  ...displayEngines,
  'AI 图像生成',
  '提示词库',
  '一键复制',
].join('，');

// 优化 <h1>：包含引擎 + use case 长尾词
const optimizedH1 = `${prompt.title} — ${engineName} ${displayCatLabel}提示词`;
---

<Base title={getDetailSeoTitle(prompt, prompt.title, 'zh')} description={getDetailSeoDescription(prompt, prompt.title, 'zh')} ogImage={prompt.images[0]?.src}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(articleLd)} />
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(faqLd)} />
  <Fragment slot="head">
    <meta name="keywords" content={metaKeywords} />
  </Fragment>

  <div class="container">
    <!-- 视觉面包屑导航（与 JSON-LD BreadcrumbList 对应） -->
    <nav class="breadcrumb" aria-label="面包屑">
      <a href={`${base}/zh/`}>首页</a>
      <span class="breadcrumb-sep">/</span>
      <a href={`${base}/zh/#all`}>全部提示词</a>
      <span class="breadcrumb-sep">/</span>
      <a href={`${base}/zh/#${prompt.category}`}>{displayCatLabel}</a>
      <span class="breadcrumb-sep">/</span>
      <span class="breadcrumb-current" aria-current="page">{displayTitle.slice(0, 30)}{displayTitle.length > 30 ? '...' : ''}</span>
    </nav>

    <div class="detail-head">
      <p style="margin: 0 0 12px; font-size: 13px;">
        <a href="/" style="color: var(--text-soft); text-decoration: none;">← 返回首页</a>
      </p>
      <div class="detail-pills">
        <span class="pill active">{displayCatLabel}</span>
        {prompt.engines.filter(e => e !== 'other').map(e => (
          <span class="badge engine">{engineLabel(e)}</span>
        ))}
        <span class={`badge diff-${prompt.difficulty}`}>难度 {prompt.difficulty}/5</span>
        {prompt.reusable && <span class="badge host">{tagLabel('reusable')}</span>}
      </div>

      <h1>{optimizedH1}</h1>
      <p class="tagline">{prompt.tagline}</p>

      <div class="detail-actions">
        <button type="button" class="btn primary" data-copy-target="prompt-full" id="copy-btn">
          <span class="copy-default">📋 复制提示词</span>
          <span class="copy-success hidden">✓ 已复制</span>
        </button>
        <a href={prompt.source.sourceUrl} target="_blank" rel="noopener" class="btn source-link-hidden">
          在 {prompt.source.platform} 查看原文 →
        </a>
      </div>
    </div>

    <div class="detail-grid">
      <div class="prose">
        {prompt.images.length > 0 && (
          <div class="prompt-gallery" data-gallery>
            <button
              type="button"
              class="prompt-main-image"
              data-gallery-trigger="0"
              aria-label={`查看第 1 / ${prompt.images.length} 张图片`}
            >
              <PromptImage
                src={prompt.images[0].src}
                alt={prompt.images[0].alt ?? prompt.title}
                width={prompt.images[0].width}
                className="prompt-main-image-img"
                eager={true}
                fetchpriority="high"
              />
              <span class="prompt-image-count">
                <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true">
                  <path fill="currentColor" d="M21 19V5c0-1.1-.9-2-2-2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2zM8.5 13.5l2.5 3.01L14.5 12l4.5 6H5l3.5-4.5z"/>
                </svg>
                <span>1 / {prompt.images.length}</span>
              </span>
            </button>

            {prompt.images.length > 1 && (
              <div class="prompt-thumbs" role="tablist" aria-label="图片画廊">
                {prompt.images.map((img, i) => (
                  <button
                    type="button"
                    class={`prompt-thumb${i === 0 ? ' active' : ''}`}
                    data-gallery-trigger={String(i)}
                    data-gallery-src={img.src}
                    aria-label={`显示第 ${i + 1} 张`}
                    aria-selected={i === 0 ? 'true' : 'false'}
                  >
                    <PromptImage
                      src={img.src}
                      alt={img.alt ?? prompt.title}
                      width={img.width}
                      className="prompt-thumb-img"
                    />
                  </button>
                ))}
              </div>
            )}
          </div>
        )}

        {prompt.images.length > 0 && (
          <div class="lightbox" data-lightbox hidden aria-hidden="true" role="dialog" aria-modal="true" aria-label="图片查看器">
            <button class="lightbox-close" data-lightbox-close aria-label="关闭">×</button>
            <button class="lightbox-prev" data-lightbox-prev aria-label="上一张">‹</button>
            <button class="lightbox-next" data-lightbox-next aria-label="下一张">›</button>
            <div class="lightbox-stage">
              {prompt.images.map((img, i) => (
                <img
                  src={img.src}
                  alt={img.alt ?? prompt.title}
                  class={`lightbox-img${i === 0 ? ' active' : ''}`}
                  data-lightbox-img={String(i)}
                  loading="lazy"
                  decoding="async"
                />
              ))}
            </div>
            <div class="lightbox-meta">
              <span data-lightbox-counter>1 / {prompt.images.length}</span>
              <span data-lightbox-caption>{prompt.images[0].alt ?? prompt.title}</span>
            </div>
          </div>
        )}

        <div class="verdict-box">
          <div class="label">编辑点评</div>
          <p style="margin: 0; color: var(--text);">{prompt.verdict}</p>
        </div>

        <pre id="prompt-full" class="prompt-source" style="display:none;">{fullPrompt}</pre>

        <h2>提示词内容</h2>
        <div class="prompt-display">
          <button type="button" class="prompt-copy-btn" data-prompt-copy aria-label="复制提示词">
            <span class="copy-default">📋 复制</span>
            <span class="copy-success hidden">✓ 已复制</span>
          </button>
          <pre><code>{fullPrompt}</code></pre>
        </div>

        {prompt.negativePrompt && (
          <>
            <h2>反向提示词</h2>
            <div class="prompt-display">
              <button type="button" class="prompt-copy-btn" data-prompt-copy aria-label="复制反向提示词">
                <span class="copy-default">📋 复制</span>
                <span class="copy-success hidden">✓ 已复制</span>
              </button>
              <pre><code>{prompt.negativePrompt}</code></pre>
            </div>
          </>
        )}

        {prompt.aspectRatio && (
          <>
            <h2>画面比例</h2>
            <p><code>{prompt.aspectRatio}</code></p>
          </>
        )}

        {prompt.reusable && prompt.prompt.includes('[') && (
          <>
            <h2>使用方法</h2>
            <p>
              这是一个<strong>可复用的模板</strong>。请把占位符（如 <code>[INSERT CITY NAME]</code>）替换成你自己的内容，再发送给图像生成模型。
            </p>
            {prompt.placeholders && prompt.placeholders.length > 0 && (
              <div class="prompt-placeholders">
                {prompt.placeholders.map((ph) => (
                  <code class="placeholder-chip">{ph}</code>
                ))}
              </div>
            )}
          </>
        )}

        <!-- FAQ 区块：长尾搜索 + Google 富媒体片段 -->
        <section class="faq-block" aria-label="常见问题">
          <h2>常见问题</h2>
          {faqItems.map((item) => (
            <details class="faq-item">
              <summary>{item.q}</summary>
              <p>{item.a}</p>
            </details>
          ))}
        </section>

        <section class="source-section-hidden">
          <h2>来源</h2>
          <div class="source-box">
          <div class="source-author">
            <strong>@{prompt.source.authorName}</strong>
            {prompt.source.authorUrl && (
              <a href={prompt.source.authorUrl} target="_blank" rel="noopener">主页 ↗</a>
            )}
          </div>
          <div class="source-platform">
            平台：<strong>{prompt.source.platform}</strong>
            {prompt.source.statusId && <span class="source-status"> · status {prompt.source.statusId}</span>}
          </div>
          <a href={prompt.source.sourceUrl} target="_blank" rel="noopener" class="source-url">
            {prompt.source.sourceUrl} →
          </a>
          </div>
        </section>
      </div>

      <aside>
        <div class="specs">
          <h3>速览</h3>
          <div class="spec-row"><span class="k">分类</span><span class="v">{displayCatLabel}</span></div>
          <div class="spec-row"><span class="k">使用的模型</span><span class="v">{displayEngines.join('、')}</span></div>
          {prompt.aspectRatio && (
            <div class="spec-row"><span class="k">画面比例</span><span class="v">{prompt.aspectRatio}</span></div>
          )}
          <div class="spec-row"><span class="k">难度</span><span class="v">{prompt.difficulty}/5</span></div>
          <div class="spec-row"><span class="k">可复用</span><span class="v">{prompt.reusable ? '是' : '否'}</span></div>
          <div class="spec-row"><span class="k">原文语言</span><span class="v">{prompt.language.toUpperCase()}</span></div>
          <div class="spec-row"><span class="k">收录日期</span><span class="v">{prompt.dateAdded}</span></div>
          {prompt.tags.length > 0 && (
            <div class="spec-row">
              <span class="k">标签</span>
              <span class="v">{prompt.tags.join(', ')}</span>
            </div>
          )}
        </div>

        <!-- 适用引擎列表（B 列表型卡片，整张卡可点跳转） -->
        <section class="engines-list" aria-label="适用 AI 引擎">
          <h3>适用于以下 AI 工具</h3>
          <p class="engines-sub">复制下方提示词，粘贴到任一工具即可使用。带 ✓ 的是已验证可用的引擎。</p>
          <div class="engine-rows">
            {compatibleEngines.map((e) => {
              const verified = verifiedEngineKeys.has(e.key);
              return (
                <a href={e.url} target="_blank" rel="noopener" class="engine-row">
                  {e.icon ? (
                    <img class="engine-logo" src={e.icon} alt={e.nameZh} loading="lazy" width="32" height="32" />
                  ) : (
                    <span class="engine-emoji" aria-hidden="true">{e.emoji}</span>
                  )}
                  <span class="engine-info">
                    <span class="engine-name">
                      {e.nameZh}
                      {verified && <span class="engine-verified" title="已验证可用">✓</span>}
                    </span>
                    <span class="engine-desc">{e.descZh}</span>
                  </span>
                  <span class="engine-arrow" aria-hidden="true">→</span>
                </a>
              );
            })}
          </div>
        </section>
      </aside>
    </div>

    {related.length > 0 && (
      <section class="section">
        <div class="section-head">
          <h2>相似提示词</h2>
          <a href={`${base}/zh/#all`} class="see-all">查看全部 →</a>
        </div>
        <div class="grid">
          {related.map((p) => <PromptCard prompt={p} base={base} />)}
        </div>
      </section>
    )}
  </div>
</Base>

<style>
  /* 视觉面包屑导航（与 JSON-LD BreadcrumbList 对应） */
  .breadcrumb {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 6px;
    padding: 20px 0 8px;
    font-size: 13px;
    color: var(--text-muted);
  }
  .breadcrumb a {
    color: var(--text-soft);
    text-decoration: none;
  }
  .breadcrumb a:hover { color: var(--accent-soft); }
  .breadcrumb-sep {
    color: var(--border);
    margin: 0 2px;
  }
  .breadcrumb-current {
    color: var(--text);
    font-weight: 500;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    max-width: 30ch;
  }

  .back-link {
    color: var(--text-muted);
    font-size: 14px;
    display: inline-block;
    margin-bottom: 16px;
  }
  .back-link:hover { color: var(--accent-soft); }
  .detail-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 16px;
  }
  .detail-head h1 {
    font-size: clamp(28px, 4vw, 40px);
    line-height: 1.2;
    margin: 0 0 12px;
    font-weight: 800;
    letter-spacing: -0.02em;
  }
  .detail-head .tagline {
    font-size: 17px;
    color: var(--text-soft);
    margin: 0 0 24px;
    -webkit-line-clamp: unset;
  }
  .detail-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-bottom: 32px;
  }
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 10px 18px;
    border-radius: 10px;
    border: 1px solid var(--border);
    background: var(--bg-card);
    color: var(--text);
    font-size: 14px;
    font-family: inherit;
    cursor: pointer;
    transition: all 0.15s;
    text-decoration: none;
  }
  .btn:hover { border-color: var(--accent); color: var(--text); }
  .btn.primary {
    background: linear-gradient(135deg, var(--accent), var(--accent-2));
    border-color: transparent;
    color: #ffffff;
    font-weight: 600;
  }
  .btn.primary:hover { filter: brightness(1.1); color: #ffffff; }
  .copy-success.hidden { display: none; }

  .detail-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 280px;
    gap: 48px;
  }
  @media (max-width: 900px) {
    .detail-grid { grid-template-columns: 1fr; }
  }
  .prose h2 {
    font-size: 20px;
    margin: 32px 0 12px;
    font-weight: 700;
  }
  .prose p { color: var(--text-soft); }

  /* 主图 + 缩略图条带 + Lightbox */
  .prompt-gallery {
    margin-bottom: 32px;
  }
  .prompt-main-image {
    position: relative;
    display: block;
    width: 100%;
    /* No aspect-ratio: tall images (vertical 9:16, square collages,
       portrait crops) used to be force-cropped to 16:10 with
       object-fit: cover, hiding the top/bottom of the actual
       prompt output. The user explicitly asked for the forced
       16:10 to go. Now image height is intrinsic; the wrapper
       auto-sizes to the image. */
    max-height: 85vh;
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--bg-soft);
    border: 1px solid var(--border);
    cursor: zoom-in;
    padding: 0;
    font-family: inherit;
  }
  .prompt-main-image:hover { border-color: var(--accent); }
  .prompt-main-image :global(img) {
    width: 100%;
    height: auto;
    max-height: 85vh;
    object-fit: contain;
    display: block;
    transition: transform 0.3s;
  }
  .prompt-main-image:hover :global(img) {
    transform: scale(1.03);
  }
  .prompt-image-count {
    position: absolute;
    right: 12px;
    bottom: 12px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 12px;
    background: rgba(11, 13, 18, 0.78);
    backdrop-filter: blur(8px);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 999px;
    color: var(--text);
    font-size: 12px;
    font-weight: 500;
    pointer-events: none;
  }

  .prompt-thumbs {
    display: flex;
    gap: 8px;
    overflow-x: auto;
    margin-top: 8px;
    padding-bottom: 4px;
    scrollbar-width: thin;
  }
  .prompt-thumb {
