---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const blogLd = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: 'AI Art Prompt Guides',
  description: 'Practical frameworks and tutorials for writing AI image-generation prompts that actually work.',
  url: new URL('/blog/', Astro.site ?? 'https://aiartspell.art').toString(),
};
---
<Base title="AI Art Prompt Guides & Tutorials" description="Practical frameworks and tutorials for writing AI image-generation prompts that actually work — subject, style, lighting, composition, and more.">
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(blogLd)} />
  <section class="blog-hero">
    <div class="container">
      <h1><span class="grad">Guides &amp; Tutorials</span></h1>
      <p>Practical frameworks for writing AI image prompts that actually work — plus a free in-browser generator to practice on.</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="blog-grid">
        {posts.map((post) => (
          <a href={`/blog/${post.slug}/`} class="card blog-card">
            {post.data.cover && (
              <div class="blog-card-cover">
                <img src={post.data.cover} alt={post.data.title} loading="lazy" decoding="async" />
              </div>
            )}
            <div class="blog-card-body">
              <span class="blog-card-topic">{post.data.topic}</span>
              <h2>{post.data.title}</h2>
              <p class="blog-card-desc">{post.data.description}</p>
              <span class="blog-card-date">{post.data.pubDate.toISOString().slice(0, 10)}</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
</Base>

<style>
  .blog-hero { padding: 72px 0 28px; text-align: center; }
  .blog-hero h1 {
    font-size: clamp(32px, 4.5vw, 46px);
    margin: 0 0 12px;
    font-weight: 800;
    letter-spacing: -0.02em;
  }
  .blog-hero p {
    color: var(--text-soft);
    max-width: 620px;
    margin: 0 auto;
    font-size: 16px;
  }
  .blog-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 22px;
  }
  .blog-card { display: flex; flex-direction: column; padding: 0; overflow: hidden; }
  .blog-card-cover {
    aspect-ratio: 16 / 9;
    background: var(--bg-soft);
    overflow: hidden;
  }
  .blog-card-cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s;
  }
  .blog-card:hover .blog-card-cover img { transform: scale(1.04); }
  .blog-card-body { padding: 18px 20px 20px; display: flex; flex-direction: column; flex: 1; }
  .blog-card-topic {
    display: inline-block;
    align-self: flex-start;
    padding: 3px 12px;
    background: var(--accent-bg);
    color: var(--accent);
    border-radius: 999px;
    font-size: 12px;
    font-weight: 600;
    margin-bottom: 10px;
  }
  .blog-card-body h2 {
    margin: 0 0 8px;
    font-size: 18px;
    line-height: 1.4;
    font-weight: 700;
  }
  .blog-card-desc {
    color: var(--text-soft);
    font-size: 13px;
    line-height: 1.6;
    margin: 0 0 14px;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .blog-card-date {
    margin-top: auto;
    color: var(--text-muted);
    font-size: 12px;
  }
</style>
