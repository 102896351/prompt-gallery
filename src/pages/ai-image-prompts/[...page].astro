---
// ============================================================
//  /ai-image-prompts/  — 全量 prompt 聚合页（分页）
//  -----------------------------------------------------------
//  存在的意义：原先 1,228 个 prompt 只能从首页平铺进入（首页 2MB、
//  1,227 条内链，权重被稀释到每页 0.08%）。本页承接「ai image prompt」
//  这类品类词，并把权重按分页层次下发给详情页。
//
//  SEO 要点：
//  - self-canonical（Base.astro 已自动输出），绝不指向 page1
//  - 每页 title 唯一（带 Page N）
//  - page 1 承载导语 / 分类入口 / FAQ；page 2+ 只留卡片，避免分��重复
//  - 跳页导航保证 3 跳内可达所有 prompt
// ============================================================

import Base from '../../layouts/Base.astro';
import PromptCard from '../../components/PromptCard.astro';
import { prompts, promptCategories } from '../../data/prompts';
import { engines } from '../../data/engines';
import type { Prompt } from '../../data/prompts';

export async function getStaticPaths({ paginate }: any) {
  const sorted = [...prompts].sort((a, b) =>
    (b.dateAdded || '').localeCompare(a.dateAdded || '')
  );
  return paginate(sorted, { pageSize: 48 });
}

const { page } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const isFirst = page.currentPage === 1;
const suffix = isFirst ? '' : ` — Page ${page.currentPage}`;

const title = `AI Image Prompts${suffix}`;
const description = isFirst
  ? `${prompts.length} copy-ready AI image prompts for Nano Banana Pro, ChatGPT, Gemini and Midjourney. Real example images, parameters and results — browse by category or model.`
  : `AI image prompts library — page ${page.currentPage} of ${page.lastPage}. Copy-ready prompts with example images and parameters.`;

const siteBase = Astro.site ?? new URL('https://aiartspell.art');

// 分类入口
const catCards = promptCategories
  .map((c) => ({ ...c, count: prompts.filter((p) => p.category === c.id).length }))
  .filter((c) => c.count > 0);

// 模型入口
const modelCards = Object.values(engines)
  .map((e) => ({
    ...e,
    count: prompts.filter((p) => p.engines.includes(e.key as Prompt['engines'][number])).length,
  }))
  .filter((e) => e.count > 0 && e.key !== 'other')
  .sort((a, b) => b.count - a.count);

// 跳页导航：1、末页、每 5 页、当前页 ±2
function pageHref(n: number) {
  return n === 1 ? `${base}/ai-image-prompts/` : `${base}/ai-image-prompts/page/${n}/`;
}
const pageNumbers = Array.from({ length: page.lastPage }, (_, i) => i + 1).filter(
  (n) => n === 1 || n === page.lastPage || n % 5 === 0 || Math.abs(n - page.currentPage) <= 2
);

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', siteBase).toString() },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'AI Image Prompts',
      item: new URL('/ai-image-prompts/', siteBase).toString(),
    },
  ],
};

const itemListLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: `AI Image Prompts${suffix}`,
  numberOfItems: page.data.length,
  itemListElement: page.data.map((p: Prompt, i: number) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: p.titleEn || p.title,
    url: new URL(`/prompt/${p.slug}/`, siteBase).toString(),
  })),
};

// FAQ 只在 page 1 输出，避免分页内容重复
const faqList = [
  {
    q: 'What is an AI image prompt?',
    a: 'An AI image prompt is the text instruction you send to an image model such as Nano Banana Pro, ChatGPT or Gemini. A good prompt describes subject, style, lighting, camera and output ratio, which is why copying a tested prompt usually beats writing one from scratch.',
  },
  {
    q: 'Which AI image model should I use?',
    a: 'Nano Banana Pro is strongest at text rendering and fine detail. ChatGPT (DALL-E) is convenient for quick iterations in chat. Midjourney leads on stylized and cinematic output. Gemini is a good all-rounder, and Flux is the best open-source option for local runs.',
  },
  {
    q: 'Are these prompts free to use?',
    a: 'Yes. Every prompt on this page is free to copy and adapt for personal or commercial work. Each entry lists its source author, so please credit the original creator when you publish results publicly.',
  },
  {
    q: 'How do I get better results from a copied prompt?',
    a: 'Keep the structure and swap only the subject first. Then adjust one variable at a time — lighting, lens, colour palette or aspect ratio. Changing several variables at once makes it impossible to tell which one caused the difference.',
  },
  {
    q: 'Do these prompts work with Nano Banana Pro?',
    a: 'Most of them do. Prompts tagged with Nano Banana Pro were tested against that model. Others were written for Midjourney, Flux or ChatGPT and may need small wording changes, since each model responds differently to parameter-style syntax.',
  },
];

const faqLd = isFirst
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: faqList.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    }
  : null;
---

<Base title={title} description={description}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(itemListLd)} />
  {faqLd && <script slot="head" type="application/ld+json" set:html={JSON.stringify(faqLd)} />}

  <section class="section">
    <div class="container">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href={`${base}/`}>Home</a>
        <span aria-hidden="true">/</span>
        <span>AI Image Prompts</span>
      </nav>

      <h1>AI Image Prompts{suffix}</h1>
      <p class="page-count">
        {prompts.length} prompts · page {page.currentPage} of {page.lastPage}
      </p>

      {
        isFirst && (
          <>
            <p class="lead">
              A working library of <strong>{prompts.length} AI image prompts</strong> with real
              example images, tested parameters and results. Every entry is copy-ready for Nano
              Banana Pro, ChatGPT, Gemini, Midjourney and Flux. Start with a category or a model
              below, or browse everything in order.
            </p>

            <h2 class="sub">Browse AI Image Prompts by Category</h2>
            <div class="chip-grid">
              {catCards.map((c) => (
                <a class="chip" href={`${base}/prompts/${c.id}/`}>
                  <strong>{c.label}</strong>
                  <span>{c.count}</span>
                </a>
              ))}
            </div>

            <h2 class="sub">Browse AI Image Prompts by Model</h2>
            <div class="chip-grid">
              {modelCards.map((m) => (
                <a class="chip" href={`${base}/models/${m.key}/`}>
                  <strong>{m.nameEn}</strong>
                  <span>{m.count}</span>
                </a>
              ))}
            </div>
          </>
        )
      }

      <h2 class="sub">{isFirst ? 'All AI image prompts' : `Page ${page.currentPage}`}</h2>

      <div class="search-wrap">
        <input
          type="text"
          id="prompt-search"
          placeholder="Search all prompts by keyword, model or tag..."
          autocomplete="off"
          aria-label="Search prompts"
        />
      </div>

      <div class="grid" id="prompt-grid">
        {
          page.data.map((p: Prompt) => (
            <div class="card-wrap" data-name={(p.titleEn || p.title).toLowerCase()} data-tags={p.tags.join(' ')}>
              <PromptCard prompt={p} base={base} />
            </div>
          ))
        }
      </div>

      <p class="empty hidden" id="empty-state">No prompts matched your search.</p>

      <nav class="pager" aria-label="Pagination">
        {page.url.prev ? <a href={page.url.prev}>← Previous</a> : <span class="pager-off">← Previous</span>}
        <div class="pager-nums">
          {
            pageNumbers.map((n: number) =>
              n === page.currentPage ? (
                <span class="pager-cur">{n}</span>
              ) : (
                <a href={pageHref(n)}>{n}</a>
              )
            )
          }
        </div>
        {page.url.next ? <a href={page.url.next}>Next →</a> : <span class="pager-off">Next →</span>}
      </nav>

      {
        isFirst && (
          <section class="faq" aria-labelledby="faq-title">
            <h2 id="faq-title" class="sub">AI image prompts FAQ</h2>
            {faqList.map((f) => (
              <details>
                <summary>{f.q}</summary>
                <p>{f.a}</p>
              </details>
            ))}
          </section>
        )
      }
    </div>
  </section>
</Base>

<script is:inline>
  // 全站搜索：加载 /search-index.json（与页面解耦，不撑大 HTML）
  (function () {
    var input = document.getElementById('prompt-search');
    var grid = document.getElementById('prompt-grid');
    var empty = document.getElementById('empty-state');
    if (!input || !grid) return;

    var cards = Array.prototype.slice.call(grid.querySelectorAll('.card-wrap'));
    var index = null;
    var loading = false;

    function render(list) {
      // 用索引结果渲染（跨分页全站搜索）
      var html = list.map(function (it) {
        return (
          '<div class="card-wrap"><a class="card" href="/prompt/' + it.slug + '/">' +
          '<img src="' + it.img + '" alt="" loading="lazy" />' +
          '<div class="card-body"><strong>' + it.title + '</strong></div></a></div>'
        );
      }).join('');
      grid.innerHTML = html;
      if (empty) empty.classList.toggle('hidden', list.length > 0);
    }

    function restore() {
      cards.forEach(function (c) { c.style.display = ''; });
      if (empty) empty.classList.add('hidden');
    }

    function localFilter(q) {
      var n = 0;
      cards.forEach(function (c) {
        var hit = (c.dataset.name || '').includes(q) || (c.dataset.tags || '').includes(q);
        c.style.display = hit ? '' : 'none';
        if (hit) n++;
      });
      if (empty) empty.classList.toggle('hidden', n > 0);
    }

    function loadIndex(cb) {
      if (index) return cb(index);
      if (loading) return;
      loading = true;
      fetch('/search-index.json')
        .then(function (r) { return r.json(); })
        .then(function (data) { index = data; loading = false; cb(index); })
        .catch(function () { loading = false; cb(null); });
    }

    function searchAll(q) {
      loadIndex(function (data) {
        if (!data) return localFilter(q);
        var hits = data.filter(function (it) {
          return (it.title + ' ' + it.tags).toLowerCase().includes(q);
        }).slice(0, 48);
        render(hits);
      });
    }

    // 支持 /ai-image-prompts/?q=xxx 直接进入
    var initial = new URLSearchParams(window.location.search).get('q');
    if (initial) {
      input.value = initial;
      searchAll(initial.trim().toLowerCase());
    }

    var timer = null;
    input.addEventListener('input', function (e) {
      var q = e.target.value.trim().toLowerCase();
      if (!q) { restore(); return; }
      clearTimeout(timer);
      timer = setTimeout(function () { searchAll(q); }, 220);
    });
  })();
</script>

<style>
  .crumbs {
    margin-bottom: 12px;
    color: var(--text-muted);
    font-size: 13px;
  }
  .crumbs a { color: var(--accent); text-decoration: none; }
  .crumbs a:hover { text-decoration: underline; }
  .page-count {
    margin: 6px 0 18px;
    color: var(--text-muted);
    font-size: 13px;
  }
  .lead {
    max-width: 760px;
    margin: 0 0 24px;
    color: var(--text);
    line-height: 1.75;
  }
  .sub {
    margin: 32px 0 14px;
    font-size: 19px;
  }
  .chip-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 8px;
  }
  .chip {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 7px 14px;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--bg-card);
    color: var(--text);
    font-size: 13px;
    text-decoration: none;
    transition: border-color 0.16s ease, transform 0.16s ease;
  }
  .chip:hover { border-color: var(--accent); transform: translateY(-1px); }
  .chip span { color: var(--text-muted); font-size: 12px; }
  .search-wrap { margin: 0 0 18px; }
  .search-wrap input {
    width: 100%;
    max-width: 460px;
    padding: 10px 14px;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--bg-card);
    color: var(--text);
    font-size: 14px;
  }
  .search-wrap input:focus { outline: 2px solid var(--accent-soft); border-color: var(--accent); }
  .pager {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 8px;
    margin: 32px 0 8px;
  }
  .pager a,
  .pager span {
    min-width: 36px;
    padding: 7px 11px;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--bg-card);
    color: var(--text);
    font-size: 13px;
    text-align: center;
    text-decoration: none;
  }
  .pager a:hover { border-color: var(--accent); color: var(--accent); }
  .pager .pager-cur {
    border-color: var(--accent);
    background: var(--accent);
    color: #fff;
    font-weight: 600;
  }
  .pager .pager-off { opacity: 0.4; }
  .pager-nums { display: flex; flex-wrap: wrap; gap: 6px; }
  .faq details {
    margin-bottom: 10px;
    padding: 12px 16px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg-card);
  }
  .faq summary { cursor: pointer; font-weight: 600; font-size: 14px; }
  .faq details p { margin: 10px 0 0; color: var(--text-muted); font-size: 14px; line-height: 1.7; }
  .grid .card-wrap a.card { text-decoration: none; color: inherit; display: block; }
  .grid .card-wrap img { width: 100%; border-radius: var(--radius); display: block; }
  .grid .card-body { padding: 8px 2px; font-size: 13px; }
</style>
