---
//  /prompts/<category>/  — 分类聚合页（分页）
//  承接 "ai portrait prompts" / "ai product photography prompts" 这类品类词，
//  同时把权重从 /ai-image-prompts/ 下发给详情页。

import Base from '../../../layouts/Base.astro';
import PromptCard from '../../../components/PromptCard.astro';
import { prompts, promptCategories, type Prompt } from '../../../data/prompts';

export async function getStaticPaths({ paginate }: any) {
  return promptCategories
    .map((cat) => ({
      cat,
      items: prompts
        .filter((p) => p.category === cat.id)
        .sort((a, b) => (b.dateAdded || '').localeCompare(a.dateAdded || '')),
    }))
    .filter((g) => g.items.length > 0)
    .flatMap((g) =>
      paginate(g.items, {
        params: { category: g.cat.id },
        props: { cat: g.cat },
        pageSize: 48,
      })
    );
}

const { page } = Astro.props;
const { cat } = Astro.props as { cat: (typeof promptCategories)[number] };
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const isFirst = page.currentPage === 1;
const suffix = isFirst ? '' : ` — Page ${page.currentPage}`;

const title = `AI ${cat.label} Prompts${suffix}`;
const description = isFirst
  ? `${page.data.length === 0 ? '' : prompts.filter((p) => p.category === cat.id).length} copy-ready AI ${cat.label.toLowerCase()} prompts with real example images and tested parameters. ${cat.description}.`
  : `AI ${cat.label.toLowerCase()} prompts — page ${page.currentPage} of ${page.lastPage}.`;

const total = prompts.filter((p) => p.category === cat.id).length;
const siteBase = Astro.site ?? new URL('https://aiartspell.art');

function pageHref(catId: string, n: number) {
  return n === 1 ? `${base}/prompts/${catId}/` : `${base}/prompts/${catId}/${n}/`;
}
const pageNumbers = Array.from({ length: page.lastPage }, (_, i) => i + 1).filter(
  (n) => n === 1 || n === page.lastPage || n % 5 === 0 || Math.abs(n - page.currentPage) <= 2
);

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', siteBase).toString() },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'AI Image Prompts',
      item: new URL('/ai-image-prompts/', siteBase).toString(),
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: `AI ${cat.label} Prompts`,
      item: new URL(`/prompts/${cat.id}/`, siteBase).toString(),
    },
  ],
};

const itemListLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: `AI ${cat.label} Prompts${suffix}`,
  numberOfItems: page.data.length,
  itemListElement: page.data.map((p: Prompt, i: number) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: p.titleEn || p.title,
    url: new URL(`/prompt/${p.slug}/`, siteBase).toString(),
  })),
};
---

<Base title={title} description={description}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(itemListLd)} />

  <section class="section">
    <div class="container">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href={`${base}/`}>Home</a>
        <span aria-hidden="true">/</span>
        <a href={`${base}/ai-image-prompts/`}>AI Image Prompts</a>
        <span aria-hidden="true">/</span>
        <span>{cat.label}</span>
      </nav>

      <h1>AI {cat.label} Prompts{suffix}</h1>
      <p class="page-count">{total} prompts · page {page.currentPage} of {page.lastPage}</p>

      {
        isFirst && (
          <p class="lead">
            <strong>{total} AI {cat.label.toLowerCase()} prompts</strong> — {cat.description}.
            Every entry below includes a real example image, the tested wording and the model it was
            written for, so you can copy it straight into Nano Banana Pro, ChatGPT or Gemini.
          </p>
        )
      }

      <div class="grid">
        {
          page.data.map((p: Prompt) => (
            <div class="card-wrap">
              <PromptCard prompt={p} base={base} />
            </div>
          ))
        }
      </div>

      <nav class="pager" aria-label="Pagination">
        {page.url.prev ? <a href={page.url.prev}>← Previous</a> : <span class="pager-off">← Previous</span>}
        <div class="pager-nums">
          {
            pageNumbers.map((n: number) =>
              n === page.currentPage ? (
                <span class="pager-cur">{n}</span>
              ) : (
                <a href={pageHref(cat.id, n)}>{n}</a>
              )
            )
          }
        </div>
        {page.url.next ? <a href={page.url.next}>Next →</a> : <span class="pager-off">Next →</span>}
      </nav>
    </div>
  </section>
</Base>

<style>
  .crumbs {
    margin-bottom: 12px;
    color: var(--text-muted);
    font-size: 13px;
  }
  .crumbs a { color: var(--accent); text-decoration: none; }
  .crumbs a:hover { text-decoration: underline; }
  .page-count { margin: 6px 0 18px; color: var(--text-muted); font-size: 13px; }
  .lead { max-width: 760px; margin: 0 0 26px; line-height: 1.75; }
  .pager {
    display: flex; flex-wrap: wrap; align-items: center; justify-content: center;
    gap: 8px; margin: 32px 0 8px;
  }
  .pager a, .pager span {
    min-width: 36px; padding: 7px 11px; border: 1px solid var(--border);
    border-radius: 8px; background: var(--bg-card); color: var(--text);
    font-size: 13px; text-align: center; text-decoration: none;
  }
  .pager a:hover { border-color: var(--accent); color: var(--accent); }
  .pager .pager-cur { border-color: var(--accent); background: var(--accent); color: #fff; font-weight: 600; }
  .pager .pager-off { opacity: 0.4; }
  .pager-nums { display: flex; flex-wrap: wrap; gap: 6px; }
</style>
