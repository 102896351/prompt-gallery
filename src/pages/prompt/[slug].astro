  .cc-card a { color: var(--accent-soft); }

  /* badge difficulty 颜色 */
  .badge.diff-1 { background: rgba(34, 197, 94, 0.12); border-color: var(--green); color: var(--green); }
  .badge.diff-2 { background: rgba(34, 197, 94, 0.12); border-color: var(--green); color: var(--green); }
  .badge.diff-3 { background: rgba(245, 158, 11, 0.12); border-color: var(--amber); color: var(--amber); }
  .badge.diff-4 { background: rgba(245, 158, 11, 0.12); border-color: var(--amber); color: var(--amber); }
  .badge.diff-5 { background: rgba(239, 68, 68, 0.12); border-color: var(--red); color: var(--red); }

