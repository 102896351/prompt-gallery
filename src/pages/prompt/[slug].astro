  }
  .prompt-copy-btn .copy-success { color: #16a34a; }
  .prompt-copy-btn .copy-success.hidden { display: none; }
  .prompt-copy-btn .copy-default.hidden { display: none; }
  .prompt-display pre {
    margin: 0;
