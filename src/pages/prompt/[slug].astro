  .see-all:hover { color: var(--accent); }
</style>

<script is:inline>
  (function () {
    // ===== Copy prompt button (顶部) =====
    const btn = document.getElementById('copy-btn');
    const src = document.getElementById('prompt-full');
    if (btn && src) {
      btn.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(src.textContent || '');
          const def = btn.querySelector('.copy-default');
          const ok = btn.querySelector('.copy-success');
          if (def && ok) {
            def.classList.add('hidden');
            ok.classList.remove('hidden');
            setTimeout(() => {
              def.classList.remove('hidden');
              ok.classList.add('hidden');
            }, 1800);
          }
        } catch (e) {
          const range = document.createRange();
          range.selectNode(src);
          const sel = window.getSelection();
          sel.removeAllRanges();
          sel.addRange(range);
        }
      });
    }

    // ===== Inline copy buttons (代码框右上角) =====
    document.querySelectorAll('[data-prompt-copy]').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const container = btn.closest('.prompt-display');
        if (!container) return;
        const pre = container.querySelector('pre');
        const text = pre ? (pre.textContent || '') : '';
        try {
          await navigator.clipboard.writeText(text);
          const def = btn.querySelector('.copy-default');
          const ok = btn.querySelector('.copy-success');
          if (def && ok) {
            def.classList.add('hidden');
            ok.classList.remove('hidden');
            setTimeout(() => {
              def.classList.remove('hidden');
              ok.classList.add('hidden');
            }, 1800);
          }
        } catch (e) {
          // fallback: select text
          if (pre) {
            const range = document.createRange();
            range.selectNode(pre);
            const sel = window.getSelection();
            sel.removeAllRanges();
            sel.addRange(range);
          }
        }
      });
    });

    // ===== Image gallery + lightbox =====
    const gallery = document.querySelector('[data-gallery]');
    const lightbox = document.querySelector('[data-lightbox]');
    if (!gallery || !lightbox) return;

    const triggers = gallery.querySelectorAll('[data-gallery-trigger]');
    const mainCount = gallery.querySelector('.prompt-image-count span:last-child');
    const thumbs = gallery.querySelectorAll('.prompt-thumb');
    const lightboxImgs = lightbox.querySelectorAll('[data-lightbox-img]');
    const counterEl = lightbox.querySelector('[data-lightbox-counter]');
    const captionEl = lightbox.querySelector('[data-lightbox-caption]');
    const total = lightboxImgs.length;
    let current = 0;

    function setMain(idx) {
      current = idx;
      // 替换主图 src
      const mainImgEl = gallery.querySelector('.prompt-main-image img');
      const target = lightboxImgs[idx];
      if (mainImgEl && target) {
        mainImgEl.src = target.src;
        mainImgEl.alt = target.alt || '';
      }
      if (mainCount) mainCount.textContent = `${idx + 1} / ${total}`;
      // 更新缩略图 active 状态
      thumbs.forEach((t, i) => {
        t.classList.toggle('active', i === idx);
        t.setAttribute('aria-selected', i === idx ? 'true' : 'false');
      });
    }

    function openLightbox(idx) {
      current = idx;
      lightbox.hidden = false;
      lightbox.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
      showLightboxImg(idx);
    }

    function closeLightbox() {
      lightbox.hidden = true;
      lightbox.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
    }

    function showLightboxImg(idx) {
      current = idx;
      lightboxImgs.forEach((img, i) => {
        img.classList.toggle('active', i === idx);
      });
      if (counterEl) counterEl.textContent = `${idx + 1} / ${total}`;
      if (captionEl) {
        const target = lightboxImgs[idx];
        captionEl.textContent = target ? (target.alt || '') : '';
      }
    }

    function nav(delta) {
      const next = (current + delta + total) % total;
      // 如果 lightbox 当前打开，更新 lightbox；否则更新主图
      if (!lightbox.hidden) {
        showLightboxImg(next);
      } else {
        setMain(next);
      }
    }

    // 缩略图点击：更新主图
    triggers.forEach((t) => {
      t.addEventListener('click', (e) => {
        e.preventDefault();
        const idx = parseInt(t.getAttribute('data-gallery-trigger'), 10) || 0;
        if (t.classList.contains('prompt-main-image')) {
          // 点主图 → 打开 lightbox
          openLightbox(idx);
        } else {
          // 点缩略图 → 切换主图
          setMain(idx);
        }
      });
    });

    // Lightbox 控件
    lightbox.querySelector('[data-lightbox-close]')?.addEventListener('click', closeLightbox);
    lightbox.querySelector('[data-lightbox-prev]')?.addEventListener('click', () => nav(-1));
    lightbox.querySelector('[data-lightbox-next]')?.addEventListener('click', () => nav(1));

    // 点背景关闭
    lightbox.addEventListener('click', (e) => {
      if (e.target === lightbox) closeLightbox();
    });

    // 键盘快捷键
    document.addEventListener('keydown', (e) => {
      if (lightbox.hidden) return;
      if (e.key === 'Escape') closeLightbox();
      else if (e.key === 'ArrowLeft') nav(-1);
      else if (e.key === 'ArrowRight') nav(1);
    });
  })();
</script>