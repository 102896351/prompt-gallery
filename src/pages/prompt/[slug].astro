---
import Base from '../../layouts/Base.astro';
import PromptImage from '../../components/PromptImage.astro';
import PromptCard from '../../components/PromptCard.astro';
import { prompts, promptCategories, getRelatedPrompts } from '../../data/prompts';
import { getCompatibleEngines } from '../../data/engines';
import { getDetailSeoTitle, getDetailSeoDescription } from '../../utils/seo';
import { en } from '../../i18n';

export function getStaticPaths() {
  return prompts.map((p) => ({
    params: { slug: p.slug },
    props: { prompt: p },
  }));
}

const { prompt } = Astro.props;
const t = en;
const messages = t;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const cat = promptCategories.find((c) => c.id === prompt.category);
const related = getRelatedPrompts(prompt.slug, 8);
const fullPrompt = prompt.structuredData ? JSON.stringify(prompt.structuredData, null, 2) : prompt.prompt;
// 适用引擎列表（详情页底部"适用于"区块用）
const compatibleEngines = getCompatibleEngines(prompt.engines);
const verifiedEngineKeys = new Set(prompt.engines.filter((k: string) => k !== 'other'));
// 用于模型识别：合并 prompt 原文 + rawBlock + structuredData
const textForModelDetection = [prompt.prompt, prompt.rawBlock, fullPrompt].filter(Boolean).join('\n');
// 英文页面：优先使用 titleEn（如果有），否则 fallback 到 title（原文）
const displayTitle = prompt.titleEn || prompt.title;
// 英文页面：优先使用 taglineEn（如果有），否则 fallback 到 tagline（原文）
const displayTagline = prompt.taglineEn || prompt.tagline;
// 分类标签：英文页用 label
const displayCatLabel = cat?.label ?? prompt.category;
// 引擎显示名（按 locale 翻译）
const engineLabel = (key: string) => (messages.engines as Record<string, string>)[key] ?? key;

// 从 prompt 文本中识别额外提到的模型/工具
const MODEL_PATTERNS: [RegExp, string][] = [
  [/\b(Gemini(?:\s*Nano\s*Banana)?(?:\s*Pro)?)\b/gi, 'gemini'],
  [/\b(Nano\s*Banana(?:\s*Pro)?)\b/gi, 'nano-banana-pro'],
  [/\b(ChatGPT|GPT-4o?|GPT\s*Image)\b/gi, 'chatgpt-image'],
  [/\b(Midjourney|MJ)\b/gi, 'midjourney'],
  [/\b(Stable\s*Diffusion|SD\s*XL|SD3?)\b/gi, 'stable-diffusion'],
  [/\b(Flux(?:\s*\.?\s*1)?)\b/gi, 'flux'],
  [/\b(Sora)\b/gi, 'sora'],
  [/\b(Veo)\b/gi, 'veo'],
  [/\b(Kling)\b/gi, 'kling'],
  [/\b(DALL[\s-]?E)\b/gi, 'chatgpt-image'],
  [/\b(Hailuo)\b/gi, 'other'],
  [/\b(Imagen)\b/gi, 'gemini'],
];
const detectedEngines = new Set<string>(prompt.engines);
for (const [re, key] of MODEL_PATTERNS) {
  if (re.test(textForModelDetection)) detectedEngines.add(key);
}
const displayEngines = [...detectedEngines]
  .map(k => engineLabel(k))
  .filter(Boolean);
// 标签显示名
const tagLabel = (key: string) => (messages.tags as Record<string, string>)[key] ?? key;

// 站点基础 URL（上线时只需改 astro.config.mjs 的 site，无需改这里）
const siteBase = Astro.site ?? new URL('https://prompt-gallery.example.com');
const pageUrl = new URL(`/prompt/${prompt.slug}`, siteBase).toString();
const homeUrl = new URL('/', siteBase).toString();
const catUrl = new URL(`/#${prompt.category}`, siteBase).toString();

// JSON-LD Article（CreativeWork 的子类型，利于 Google 收录长文式 prompt 卡片页）
// Article 继承 CreativeWork 全部属性，故 dateCreated/keywords/sourceOrganization 等仍有效
const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: displayTitle,
  name: displayTitle,
  description: displayTagline,
  url: pageUrl,
  mainEntityOfPage: { '@type': 'WebPage', '@id': pageUrl },
  datePublished: prompt.dateAdded,
  dateModified: prompt.dateAdded,
  dateCreated: prompt.dateAdded,
  author: {
    '@type': 'Person',
    name: prompt.source.authorName,
    url: prompt.source.authorUrl,
  },
  publisher: {
    '@type': 'Organization',
    name: 'Ai Art Spell',
    logo: { '@type': 'ImageObject', url: new URL('favicon.jpg', siteBase).toString() },
  },
  keywords: prompt.tags.join(', '),
  ...(prompt.images[0] ? { image: [prompt.images[0].src] } : {}),
  ...(prompt.aspectRatio ? { aspectRatio: prompt.aspectRatio } : {}),
  ...(prompt.source.sourceUrl ? { sourceOrganization: { '@type': 'WebSite', url: prompt.source.sourceUrl } } : {}),
};

// JSON-LD BreadcrumbList（首页 > 分类 > prompt）
const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Ai Art Spell', item: homeUrl },
    { '@type': 'ListItem', position: 2, name: displayCatLabel, item: catUrl },
    { '@type': 'ListItem', position: 3, name: displayTitle, item: pageUrl },
  ],
};

// JSON-LD FAQPage（Google 富媒体片段：常见问题）
// 每个详情页自动生成 4 个 FAQ，吃搜索长尾词（"how to use X prompt"、"what engine" 等）
// ★ Google FAQ 富媒体只在政府/医疗/教育类站点有限显示，但 schema 仍然帮助理解内容
// SEO 长尾：取第一个非 "other" 引擎作为显示名，兜底 "AI image"
const primaryEngineKey = prompt.engines.find(e => e !== 'other') || prompt.engines[0] || 'other';
const engineName = engineLabel(primaryEngineKey);

const faqItems: Array<{ q: string; a: string }> = [
  {
    q: `What is this ${displayTitle} prompt?`,
    a: displayTagline || `A ${displayCatLabel.toLowerCase()} prompt for ${engineName} AI image generation.`,
  },
  {
    q: `Which AI tools work with this prompt?`,
    a: `This prompt is compatible with: ${prompt.engines.map(e => engineLabel(e)).join(', ')}.${prompt.engines.filter(e => e !== 'other').length > 0 ? ' Copy and paste it into your preferred tool.' : ''}`,
  },
  {
    q: 'How do I use this prompt?',
    a: prompt.reusable && prompt.placeholders?.length
      ? `This is a reusable template. Replace placeholders like ${prompt.placeholders.slice(0, 2).map(p => '`' + p + '`').join(', ')} with your own values, then paste into ${engineName}.`
      : `Click "Copy prompt" above, paste it into ${engineName} or any compatible AI image generator, and generate. Adjust the prompt for your specific use case.`,
  },
  {
    q: 'Can I use the generated images commercially?',
    a: `Check the original source (${prompt.source.platform}) for licensing terms. This page only curates the prompt text — image rights follow the source author's policy.`,
  },
];
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map(item => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};

// meta keywords：Google 不用，但 Bing/Yandex 用
const metaKeywords = [
  displayTitle,
  `${engineName} prompt`,
  `${displayCatLabel} prompt`,
  `${engineName} ${displayCatLabel}`,
  ...prompt.tags,
  ...prompt.engines.map(e => engineLabel(e)),
  'AI image generation',
  'prompt library',
  'copy prompt',
].join(', ');

// 优化 <h1>：包含引擎 + use case 长尾词
// 原始: displayTitle（裸 prompt 标题）
// 优化: displayTitle + 引擎 + 用途短语
const optimizedH1 = `${displayTitle} — ${engineName} ${displayCatLabel} Prompt`;
---

<Base title={getDetailSeoTitle(prompt, displayTitle, 'en')} description={getDetailSeoDescription(prompt, displayTitle, 'en')} ogImage={prompt.images[0]?.src}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(articleLd)} />
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(faqLd)} />
  {/* meta keywords: Google 不用但 Bing/Yandex 用 */}
  <Fragment slot="head">
    <meta name="keywords" content={metaKeywords} />
  </Fragment>

  <div class="container">
    <!-- Visual breadcrumb (matches JSON-LD BreadcrumbList) -->
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href={`${base}/`}>Home</a>
      <span class="breadcrumb-sep">/</span>
      <a href={`${base}/#all`}>All prompts</a>
      <span class="breadcrumb-sep">/</span>
      <a href={`${base}/#${prompt.category}`}>{displayCatLabel}</a>
      <span class="breadcrumb-sep">/</span>
      <span class="breadcrumb-current" aria-current="page">{displayTitle.slice(0, 30)}{displayTitle.length > 30 ? '...' : ''}</span>
    </nav>

    <div class="detail-head">
      <p style="margin: 0 0 12px; font-size: 13px;">
        <a href={base} style="color: var(--text-soft); text-decoration: none;">← 返回首页</a>
      </p>
      <div class="detail-pills">
        <span class="pill active">{displayCatLabel}</span>
        {prompt.engines.filter(e => e !== 'other').map(e => (
          <span class="badge engine">{engineLabel(e)}</span>
        ))}
        <span class={`badge diff-${prompt.difficulty}`}>Difficulty {prompt.difficulty}/5</span>
        {prompt.reusable && <span class="badge host">↻ Reusable</span>}
      </div>

      <h1>{optimizedH1}</h1>
      <p class="tagline">{displayTagline}</p>

      <div class="detail-actions">
        <button type="button" class="btn primary" data-copy-target="prompt-full" id="copy-btn">
          <span class="copy-default">📋 Copy prompt</span>
          <span class="copy-success hidden">✓ Copied</span>
        </button>
        <a href={prompt.source.sourceUrl} target="_blank" rel="noopener" class="btn">
          View source on {prompt.source.platform} →
        </a>
      </div>
    </div>

    <div class="detail-grid">
      <!-- 主内容 -->
      <div class="prose">
        <!-- 主图 + 缩略图条带（点击弹窗） -->
        {prompt.images.length > 0 && (
          <div class="prompt-gallery" data-gallery>
            {/* 主图：默认显示第一张，点击放大 */}
            <button
              type="button"
              class="prompt-main-image"
              data-gallery-trigger="0"
              aria-label={`View image 1 of ${prompt.images.length} fullscreen`}
            >
              <PromptImage
                src={prompt.images[0].src}
                alt={prompt.images[0].alt ?? displayTitle}
                width={prompt.images[0].width}
                className="prompt-main-image-img"
                eager={true}
                fetchpriority="high"
              />
              <span class="prompt-image-count">
                <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true">
                  <path fill="currentColor" d="M21 19V5c0-1.1-.9-2-2-2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2zM8.5 13.5l2.5 3.01L14.5 12l4.5 6H5l3.5-4.5z"/>
                </svg>
                <span>1 / {prompt.images.length}</span>
              </span>
            </button>

            {/* 缩略图条带：仅在多图时显示 */}
            {prompt.images.length > 1 && (
              <div class="prompt-thumbs" role="tablist" aria-label="Image gallery">
                {prompt.images.map((img, i) => (
                  <button
                    type="button"
                    class={`prompt-thumb${i === 0 ? ' active' : ''}`}
                    data-gallery-trigger={String(i)}
                    data-gallery-src={img.src}
                    aria-label={`Show image ${i + 1}`}
                    aria-selected={i === 0 ? 'true' : 'false'}
                  >
                    <PromptImage
                      src={img.src}
                      alt={img.alt ?? displayTitle}
                      width={img.width}
                      className="prompt-thumb-img"
                    />
                  </button>
                ))}
              </div>
            )}
          </div>
        )}

        {/* Lightbox 弹窗（DOM 注入到 body 末尾，全局可见） */}
        {prompt.images.length > 0 && (
          <div class="lightbox" data-lightbox hidden aria-hidden="true" role="dialog" aria-modal="true" aria-label="Image viewer">
            <button class="lightbox-close" data-lightbox-close aria-label="Close">×</button>
            <button class="lightbox-prev" data-lightbox-prev aria-label="Previous image">‹</button>
            <button class="lightbox-next" data-lightbox-next aria-label="Next image">›</button>
            <div class="lightbox-stage">
              {prompt.images.map((img, i) => (
                <img
                  src={img.src}
                  alt={img.alt ?? displayTitle}
                  class={`lightbox-img${i === 0 ? ' active' : ''}`}
                  data-lightbox-img={String(i)}
                  loading="lazy"
                  decoding="async"
                />
              ))}
            </div>
            <div class="lightbox-meta">
              <span data-lightbox-counter>1 / {prompt.images.length}</span>
              <span data-lightbox-caption>{prompt.images[0].alt ?? prompt.title}</span>
            </div>
          </div>
        )}

        <!-- 编辑部 verdict -->
        <div class="verdict-box">
          <div class="label">Our take</div>
          <p style="margin: 0; color: var(--text);">{prompt.verdict}</p>
        </div>

        <!-- FAQ 区块：用户长尾搜索 + Google 富媒体片段 -->
        <section class="faq-block" aria-label="Frequently asked questions">
          <h2>Frequently asked questions</h2>
          {faqItems.map((item) => (
            <details class="faq-item">
              <summary>{item.q}</summary>
              <p>{item.a}</p>
            </details>
          ))}
        </section>

        <!-- 完整 prompt（隐藏的 copy source） -->
        <pre id="prompt-full" class="prompt-source" style="display:none;">{fullPrompt}</pre>

        <!-- 渲染的 prompt 显示 -->
        <h2>The prompt</h2>
        <div class="prompt-display">
          <button type="button" class="prompt-copy-btn" data-prompt-copy aria-label="Copy prompt">
            <span class="copy-default">📋 Copy</span>
            <span class="copy-success hidden">✓ Copied</span>
          </button>
          <pre><code>{fullPrompt}</code></pre>
        </div>

        {prompt.negativePrompt && (
          <>
            <h2>Negative prompt</h2>
            <div class="prompt-display">
              <button type="button" class="prompt-copy-btn" data-prompt-copy aria-label="Copy negative prompt">
                <span class="copy-default">📋 Copy</span>
                <span class="copy-success hidden">✓ Copied</span>
              </button>
              <pre><code>{prompt.negativePrompt}</code></pre>
            </div>
          </>
        )}

        {prompt.aspectRatio && (
          <>
            <h2>Aspect ratio</h2>
            <p><code>{prompt.aspectRatio}</code></p>
          </>
        )}

        {prompt.reusable && prompt.prompt.includes('[') && (
          <>
            <h2>How to use</h2>
            <p>
              This prompt is a <strong>reusable template</strong>. Replace the
              placeholders (e.g. <code>[INSERT CITY NAME]</code>) with your own
              values before sending to your image-generation model.
            </p>
            {prompt.placeholders && prompt.placeholders.length > 0 && (
              <div class="prompt-placeholders">
                {prompt.placeholders.map((ph) => (
                  <code class="placeholder-chip">{ph}</code>
                ))}
              </div>
            )}
          </>
        )}

        <h2>Source</h2>
        <div class="source-box">
          <div class="source-author">
            <strong>@{prompt.source.authorName}</strong>
            {prompt.source.authorUrl && (
              <a href={prompt.source.authorUrl} target="_blank" rel="noopener">profile ↗</a>
            )}
          </div>
          <div class="source-platform">
            Platform: <strong>{prompt.source.platform}</strong>
            {prompt.source.statusId && <span class="source-status"> · status {prompt.source.statusId}</span>}
          </div>
          <a href={prompt.source.sourceUrl} target="_blank" rel="noopener" class="source-url">
            {prompt.source.sourceUrl} →
          </a>
        </div>
      </div>

      <!-- 侧边栏 -->
      <aside>
        <div class="specs">
          <h3>At a glance</h3>
          <div class="spec-row"><span class="k">Category</span><span class="v">{displayCatLabel}</span></div>
          <div class="spec-row"><span class="k">Models used</span><span class="v">{displayEngines.join(', ')}</span></div>
          {prompt.aspectRatio && (
            <div class="spec-row"><span class="k">Aspect ratio</span><span class="v">{prompt.aspectRatio}</span></div>
          )}
          <div class="spec-row"><span class="k">Difficulty</span><span class="v">{prompt.difficulty}/5</span></div>
          <div class="spec-row"><span class="k">Reusable</span><span class="v">{prompt.reusable ? 'Yes' : 'No'}</span></div>
          <div class="spec-row"><span class="k">Source lang</span><span class="v">{prompt.language.toUpperCase()}</span></div>
          <div class="spec-row"><span class="k">Date added</span><span class="v">{prompt.dateAdded}</span></div>
          {prompt.tags.length > 0 && (
            <div class="spec-row">
              <span class="k">Tags</span>
              <span class="v">{prompt.tags.join(', ')}</span>
            </div>
          )}
        </div>

        <!-- 适用引擎列表（B 列表型卡片，整张卡可点跳转） -->
        <section class="engines-list" aria-label="Compatible AI engines">
          <h3>Works with these AI tools</h3>
          <p class="engines-sub">Copy the prompt and paste it into any of these tools. Verified engines are marked with a check.</p>
          <div class="engine-rows">
            {compatibleEngines.map((e) => {
              const verified = verifiedEngineKeys.has(e.key);
              return (
                <a href={e.url} target="_blank" rel="noopener" class="engine-row">
                  {e.icon ? (
                    <img class="engine-logo" src={e.icon} alt={e.nameEn} loading="lazy" width="32" height="32" />
                  ) : (
                    <span class="engine-emoji" aria-hidden="true">{e.emoji}</span>
                  )}
                  <span class="engine-info">
                    <span class="engine-name">
                      {e.nameEn}
                      {verified && <span class="engine-verified" title="Verified for this prompt">✓</span>}
                    </span>
                    <span class="engine-desc">{e.descEn}</span>
                  </span>
                  <span class="engine-arrow" aria-hidden="true">→</span>
                </a>
              );
            })}
          </div>
        </section>
      </aside>
    </div>

    {related.length > 0 && (
      <section class="section">
        <div class="section-head">
          <h2>Similar prompts</h2>
          <a href={`${base}/#all`} class="see-all">See all →</a>
        </div>
        <div class="grid">
          {related.map((p) => <PromptCard prompt={p} base={base} />)}
        </div>
      </section>
    )}
  </div>
</Base>

<style>
  /* Visual breadcrumb (matches JSON-LD BreadcrumbList) */
  .breadcrumb {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 6px;
    padding: 20px 0 8px;
    font-size: 13px;
    color: var(--text-muted);
  }
  .breadcrumb a {
    color: var(--text-soft);
    text-decoration: none;
  }
  .breadcrumb a:hover { color: var(--accent-soft); }
  .breadcrumb-sep {
    color: var(--border);
    margin: 0 2px;
  }
  .breadcrumb-current {
    color: var(--text);
    font-weight: 500;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    max-width: 30ch;
  }

  .back-link {
    color: var(--text-muted);
    font-size: 14px;
    display: inline-block;
    margin-bottom: 16px;
  }
  .back-link:hover { color: var(--accent-soft); }
  .detail-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 16px;
  }
  .detail-head h1 {
    font-size: clamp(28px, 4vw, 40px);
    line-height: 1.2;
    margin: 0 0 12px;
    font-weight: 800;
    letter-spacing: -0.02em;
  }
  .detail-head .tagline {
    font-size: 17px;
    color: var(--text-soft);
    margin: 0 0 24px;
    -webkit-line-clamp: unset;
  }
  .detail-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-bottom: 32px;
  }
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 10px 18px;
    border-radius: 10px;
    border: 1px solid var(--border);
    background: var(--bg-card);
    color: var(--text);
    font-size: 14px;
    font-family: inherit;
    cursor: pointer;
    transition: all 0.15s;
    text-decoration: none;
  }
  .btn:hover {
    border-color: var(--accent);
    color: var(--text);
  }
  .btn.primary {
    background: linear-gradient(135deg, var(--accent), var(--accent-2));
    border-color: transparent;
    color: #ffffff;
    font-weight: 600;
  }
  .btn.primary:hover {
    filter: brightness(1.1);
    color: #ffffff;
  }
  .copy-success.hidden { display: none; }

  /* 主内容布局 */
  .detail-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 280px;
    gap: 48px;
  }
  @media (max-width: 900px) {
    .detail-grid { grid-template-columns: 1fr; }
  }
  .prose h2 {
    font-size: 20px;
    margin: 32px 0 12px;
    font-weight: 700;
  }
  .prose p { color: var(--text-soft); }

  /* 主图 + 缩略图条带 + Lightbox */
  .prompt-gallery {
    margin-bottom: 32px;
  }
  .prompt-main-image {
    position: relative;
    display: block;
    width: 100%;
    /* No aspect-ratio: tall images (vertical 9:16, square collages,
       portrait crops) used to be force-cropped to 16:10 with
       object-fit: cover, hiding the top/bottom of the actual
       prompt output. The user explicitly asked for the forced
       16:10 to go. Now image height is intrinsic; the wrapper
       auto-sizes to the image. */
    max-height: 85vh;
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--bg-soft);
    border: 1px solid var(--border);
    cursor: zoom-in;
    padding: 0;
    font-family: inherit;
  }
  .prompt-main-image:hover { border-color: var(--accent); }
  .prompt-main-image :global(img) {
    width: 100%;
    height: auto;
    max-height: 85vh;
    object-fit: contain;
    display: block;
    transition: transform 0.3s;
  }
  .prompt-main-image:hover :global(img) {
    transform: scale(1.03);
  }
  .prompt-image-count {
    position: absolute;
    right: 12px;
    bottom: 12px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 12px;
    background: rgba(11, 13, 18, 0.78);
    backdrop-filter: blur(8px);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 999px;
    color: var(--text);
    font-size: 12px;
    font-weight: 500;
    pointer-events: none;
  }

  /* 缩略图条带 */
  .prompt-thumbs {
    display: flex;
    gap: 8px;
    overflow-x: auto;
    margin-top: 8px;
    padding-bottom: 4px;
    scrollbar-width: thin;
  }
  .prompt-thumb {
