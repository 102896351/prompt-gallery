---
// ============================================================
//  PromptCard.astro
//  首页 / 列表页的 prompt 卡片
//  模式：仿 ai-agents-hub 的 AgentCard，无 <style>，样式用全局 .card 类
// ============================================================

import type { Prompt } from '../data/prompts';
import { promptCategories } from '../data/prompts';
import { getLocaleFromPath, en, zh, type Locale } from '../i18n';
import PromptImage from './PromptImage.astro';
import { safeEnglishTitle } from '../utils/english-title';

interface Props {
  prompt: Prompt;
  base?: string;
  // 性能优化：列表里前几张首屏可见的卡片传 eager，提示浏览器提前加载并提升 LCP
  eager?: boolean;
  fetchpriority?: 'high' | 'low' | 'auto';
  // overlay 模式（首页精选 carousel 用）：只渲染图片 + 图片底部叠加标题，
  // 不渲染 body（tagline/badges/作者）。标题单行截断，样式仿专题区。
  overlay?: boolean;
  // 首页卡片在新标签页打开，保持首页滚动位置与已加载图片。
  newTab?: boolean;
}
const {
  prompt,
  base = import.meta.env.BASE_URL.replace(/\/$/, ''),
  eager = false,
  fetchpriority = 'auto',
  overlay = false,
  newTab = false,
} = Astro.props;
const cat = promptCategories.find((c) => c.id === prompt.category);
const cover = prompt.images[0];
// 根据当前页面 URL 推断 locale，决定卡片链接加不加 /zh 前缀
const locale: Locale = getLocaleFromPath(Astro.url.pathname);
const messages = locale === 'zh' ? zh : en;
const promptHref = locale === 'zh' ? `${base}/zh/prompt/${prompt.slug}` : `${base}/prompt/${prompt.slug}`;
// 英文页面：优先 titleEn，fallback 到 title；中文页：保持 title
const displayTitle = locale === 'en'
  ? safeEnglishTitle(prompt.titleEn, prompt.title, prompt.slug)
  : prompt.title;
// 英文页面描述不能直接显示中文 tagline；优先 taglineEn，
// 若历史数据的 taglineEn 仍含中文，则用稳定的英文通用描述兜底。
const hasCJK = (value: string) => /[一-鿿]/.test(value || '');
const displayTagline = locale === 'en'
  ? (prompt.taglineEn && !hasCJK(prompt.taglineEn)
      ? prompt.taglineEn
      : `AI ${prompt.category.replace(/-/g, ' ')} image-generation prompt.`)
  : prompt.tagline;
// 分类标签：locale=zh 用 labelZh，否则用 label
const displayCategoryLabel = locale === 'zh' ? (cat?.labelZh ?? cat?.label ?? prompt.category) : (cat?.label ?? prompt.category);
// 引擎显示名（按 locale 翻译）
const engineLabel = (key: string) => (messages.engines as Record<string, string>)[key] ?? key;
// 标签显示名
const tagLabel = (key: string) => (messages.tags as Record<string, string>)[key] ?? key;
---

<a
  href={promptHref}
  class={`card prompt-card${overlay ? ' prompt-card--overlay' : ''}`}
  target={newTab ? '_blank' : undefined}
  rel={newTab ? 'noopener' : undefined}
>
  {cover && (
    <div class="prompt-card-cover">
      <PromptImage
        src={cover.src}
        alt={cover.alt ?? displayTitle}
        width={cover.width}
        eager={eager}
        fetchpriority={fetchpriority}
      />
      {overlay && (
        <div class="prompt-card-overlay">
          <h3>{displayTitle}</h3>
        </div>
      )}
    </div>
  )}
  {!overlay && (
    <div class="prompt-card-body">
      <div class="card-top">
        <h3>{displayTitle}</h3>
      </div>
      <p class="tagline">{displayTagline}</p>
      <div class="card-meta">
        <span class="pill active" style="font-size: 11px; padding: 2px 8px;">{displayCategoryLabel}</span>
        {prompt.engines.slice(0, 2).map((e) => (
          <span class="badge engine" style="font-size: 10px;">{engineLabel(e)}</span>
        ))}
        {prompt.reusable && (
          <span class="badge host" style="font-size: 10px;">{tagLabel('reusable')}</span>
        )}
      </div>
      <div class="prompt-card-footer">
        <span class="prompt-card-author">@{prompt.source.authorName}</span>
      </div>
    </div>
  )}
</a>

<style>
  .prompt-card {
    display: flex;
    flex-direction: column;
    padding: 0;
    overflow: hidden;
  }
  .prompt-card-cover {
    aspect-ratio: 4 / 3;
    background: var(--bg-soft);
    overflow: hidden;
  }
  .prompt-card-cover :global(img) {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: contain;
    transition: transform 0.3s;
  }
  .prompt-card:hover .prompt-card-cover :global(img) {
    transform: scale(1.05);
  }
  .prompt-card-body {
    padding: 14px 16px 12px;
    display: flex;
    flex-direction: column;
    flex: 1;
  }
  .prompt-card-body .card-top {
    margin-bottom: 6px;
  }
  .prompt-card-body h3 {
    font-size: 15px;
    line-height: 1.35;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .prompt-card-footer {
    margin-top: 10px;
    padding-top: 8px;
    border-top: 1px solid var(--border);
    color: var(--text-muted);
    font-size: 11px;
  }
  .prompt-card-author {
    color: var(--text-muted);
  }
  /* ---- overlay 模式（首页精选 carousel）：标题叠加在图片底部 ---- */
  .prompt-card--overlay .prompt-card-cover {
    position: relative;
  }
  .prompt-card-overlay {
    position: absolute;
    inset: auto 0 0 0;
    padding: 22px 10px 8px;
    background: linear-gradient(
      to top,
      rgba(0, 0, 0, 0.78) 0%,
      rgba(0, 0, 0, 0.35) 55%,
      rgba(0, 0, 0, 0) 100%
    );
  }
  .prompt-card-overlay h3 {
    margin: 0;
    font-size: 12px;
    line-height: 1.35;
    font-weight: 600;
    color: #fff;
    /* 标题字数限制：单行截断 */
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
</style>