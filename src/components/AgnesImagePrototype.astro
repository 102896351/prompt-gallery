---
interface Props {
  locale?: 'en' | 'zh';
}

const { locale = 'en' } = Astro.props;
const isZh = locale === 'zh';

const encodeSvg = (svg) => `data:image/svg+xml;utf8,${encodeURIComponent(svg)}`;

const buildArtwork = (palette, shape, signature) => {
  const svg = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 600" preserveAspectRatio="xMidYMid meet" role="img">${signature}<defs><radialGradient id="g" cx="50%" cy="35%" r="80%"><stop offset="0%" stop-color="${palette.center}"/><stop offset="100%" stop-color="${palette.edge}"/></radialGradient></defs><rect width="800" height="600" fill="url(#g)"/>${shape}<text x="40" y="560" fill="${palette.label}" font-family="ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, 'PingFang SC', 'Microsoft YaHei'" font-size="20" letter-spacing="3">PROTOTYPE PREVIEW</text></svg>`;
  return encodeSvg(svg);
};

const mainArtwork = buildArtwork(
  { center: '#f4c5b2', edge: '#2e2749', label: 'rgba(255,255,255,0.7)' },
  '<circle cx="280" cy="230" r="150" fill="rgba(255,255,255,0.18)"/><circle cx="260" cy="220" r="60" fill="#fff7e9"/><rect x="360" y="180" width="380" height="220" rx="14" fill="rgba(255,255,255,0.08)"/><circle cx="555" cy="280" r="6" fill="#fff"/><circle cx="585" cy="280" r="6" fill="#fff"/><path d="M520 360 Q555 390 590 360" stroke="#fff" stroke-width="3" fill="none" stroke-linecap="round"/>',
  '',
);
const historyArtworks = [
  buildArtwork(
    { center: '#f4c5b2', edge: '#2e2749', label: 'rgba(255,255,255,0.65)' },
    '<circle cx="320" cy="240" r="120" fill="rgba(255,255,255,0.16)"/><circle cx="300" cy="230" r="50" fill="#fff7e9"/>',
    '',
  ),
  buildArtwork(
    { center: '#161b42', edge: '#ff8f66', label: 'rgba(255,255,255,0.65)' },
    '<circle cx="630" cy="120" r="36" fill="#ffcf7a"/><rect x="160" y="320" width="80" height="240" fill="rgba(20,20,55,0.8)"/><rect x="260" y="280" width="80" height="280" fill="rgba(30,30,75,0.85)"/><rect x="360" y="340" width="80" height="220" fill="rgba(20,20,55,0.8)"/><rect x="460" y="260" width="80" height="300" fill="rgba(35,35,90,0.85)"/><rect x="560" y="300" width="80" height="260" fill="rgba(20,20,55,0.8)"/>',
    '',
  ),
  buildArtwork(
    { center: '#dbe8e4', edge: '#e9b7ae', label: 'rgba(80,50,60,0.6)' },
    '<circle cx="400" cy="280" r="110" fill="rgba(255,255,255,0.55)"/><ellipse cx="400" cy="300" rx="60" ry="80" fill="#f5d3bc"/><ellipse cx="382" cy="290" rx="5" ry="3" fill="#44364a"/><ellipse cx="418" cy="290" rx="5" ry="3" fill="#44364a"/><path d="M375 335 Q400 355 425 335" stroke="#8b4a64" stroke-width="3" fill="none" stroke-linecap="round"/>',
    '',
  ),
];
const historyItems = isZh
  ? [
      { artwork: historyArtworks[0], mode: '文生图', ratio: '1:1', model: 'Agnes Image 2.1 Flash', date: '2 分钟前', prompt: 'A cinematic editorial portrait in warm studio light' },
      { artwork: historyArtworks[1], mode: '文生图', ratio: '16:9', model: 'Agnes Image 2.1 Flash', date: '10 分钟前', prompt: 'A futuristic city street with neon reflections' },
      { artwork: historyArtworks[2], mode: '文生图', ratio: '9:16', model: 'Agnes Image 2.1 Flash', date: '昨天 19:24', prompt: 'A soft portrait with natural window light' },
    ]
  : [
      { artwork: historyArtworks[0], mode: 'Text to Image', ratio: '1:1', model: 'Agnes Image 2.1 Flash', date: '2 min ago', prompt: 'A cinematic editorial portrait in warm studio light' },
      { artwork: historyArtworks[1], mode: 'Text to Image', ratio: '16:9', model: 'Agnes Image 2.1 Flash', date: '10 min ago', prompt: 'A futuristic city street with neon reflections' },
      { artwork: historyArtworks[2], mode: 'Text to Image', ratio: '9:16', model: 'Agnes Image 2.1 Flash', date: 'Yesterday 19:24', prompt: 'A soft portrait with natural window light' },
    ];

const copy = isZh
  ? {
      prototype: '视觉原型',
      localOnly: '仅本地测试',
      title: 'Agnes AI 生图工作台',
      subtitle: '把灵感变成画面。先在本机测试 Agnes Image 2.1 Flash，再发布你的创作。',
      model: 'Agnes Image 2.1 Flash',
      modelLabel: '当前模型',
      ready: '生成完成',
      modeLabel: '文生图',
      createdAt: '刚刚',
      create: '创建图像',
      textToImage: '文生图',
      imageToImage: '图生图',
      promptLabel: '图片描述',
      prompt: 'A cinematic editorial portrait in warm studio light, elegant composition, realistic texture, soft shadows, highly detailed',
      promptHint: '清晰描述主体、风格、光线和构图',
      promptCount: '126 / 4000',
      inspiration: '灵感标签',
      chips: ['电影感', '暖色灯光', '高细节'],
      referenceLabel: '参考图片',
      optional: '可选',
      uploadTitle: '添加参考图',
      uploadHint: '拖拽图片到这里，或点击上传',
      uploadTypes: 'JPG、PNG、WebP · 最多 4 张',
      ratioLabel: '画面比例',
      square: '正方形',
      landscape: '横向',
      portrait: '竖向',
      generate: '生成图片',
      clear: '清空',
      result: '生成结果',
      zoom: '放大预览',
      closeZoom: '关闭预览',
      emptyTitle: '你的画面将在这里出现',
      emptyDescription: '在左侧写下一个想法，开始你的下一次创作',
      canvas: '画布 1:1',
      download: '下载图片',
      regenerate: '再次生成',
      historyTitle: '最近创作',
      historyDescription: '生成结果保存在当前浏览器中',
      historyCount: '3 张图片',
      historyEmpty: '还没有生成记录',
      historyHint: '完成第一次创作后，结果会显示在这里',
      visualNote: '这是视觉原型，按钮和控件暂不连接真实功能。',
      privacy: '请勿上传私人照片、身份证件或其他敏感内容。',
      artworkLabels: ['Warm studio portrait', 'Neon city at night', 'Soft editorial portrait'],
      artworkPrompts: [
        'A cinematic editorial portrait in warm studio light',
        'A futuristic city street with neon reflections',
        'A soft portrait with natural window light',
      ],
    }
  : {
      prototype: 'VISUAL PROTOTYPE',
      localOnly: 'LOCAL ONLY',
      title: 'Agnes AI Image Studio',
      subtitle: 'Turn an idea into an image. Test Agnes Image 2.1 Flash locally before publishing your creation.',
      model: 'Agnes Image 2.1 Flash',
      modelLabel: 'Model',
      ready: 'Generation complete',
      modeLabel: 'Text to Image',
      createdAt: 'Just now',
      create: 'Create image',
      textToImage: 'Text to Image',
      imageToImage: 'Image to Image',
      promptLabel: 'Image prompt',
      prompt: 'A cinematic editorial portrait in warm studio light, elegant composition, realistic texture, soft shadows, highly detailed',
      promptHint: 'Describe the subject, style, light, and composition',
      promptCount: '126 / 4000',
      inspiration: 'Inspiration tags',
      chips: ['Cinematic', 'Warm light', 'Highly detailed'],
      referenceLabel: 'Reference image',
      optional: 'OPTIONAL',
      uploadTitle: 'Add a reference',
      uploadHint: 'Drop an image here, or click to upload',
      uploadTypes: 'JPG, PNG, WebP · Up to 4 images',
      ratioLabel: 'Aspect ratio',
      square: 'Square',
      landscape: 'Landscape',
      portrait: 'Portrait',
      generate: 'Generate image',
      clear: 'Clear',
      result: 'Generation result',
      zoom: 'Open enlarged preview',
      closeZoom: 'Close preview',
      emptyTitle: 'Your image will appear here',
      emptyDescription: 'Write an idea on the left to start your next creation',
      canvas: 'Canvas 1:1',
      download: 'Download image',
      regenerate: 'Generate again',
      historyTitle: 'Recent creations',
      historyDescription: 'Results are saved in this browser',
      historyCount: '3 images',
      historyEmpty: 'No creations yet',
      historyHint: 'Your first result will show up here',
      visualNote: 'This is a visual prototype. Controls are not connected yet.',
      privacy: 'Do not upload private photos, identity documents, or other sensitive content.',
      artworkLabels: ['Warm studio portrait', 'Neon city at night', 'Soft editorial portrait'],
      artworkPrompts: [
        'A cinematic editorial portrait in warm studio light',
        'A futuristic city street with neon reflections',
        'A soft portrait with natural window light',
      ],
    };
---

<section class="agnes-prototype" aria-labelledby={`agnes-prototype-title-${locale}`}>
  <div class="prototype-container">
    <header class="prototype-intro">
      <div class="prototype-intro-copy">
        <div class="prototype-kicker">
          <span class="prototype-badge">{copy.localOnly}</span>
          <span class="prototype-label">{copy.prototype}</span>
        </div>
        <h1 id={`agnes-prototype-title-${locale}`}><span class="prototype-gradient">Agnes AI</span> {isZh ? '生图工作台' : 'Image Studio'}</h1>
        <p>{copy.subtitle}</p>
      </div>
      <div class="prototype-model-card">
        <span class="prototype-model-icon" aria-hidden="true">✦</span>
        <span class="prototype-model-card-field">
          <label for={`prototype-header-model-${locale}`}>{copy.modelLabel}</label>
          <span class="prototype-model-select-wrap">
            <select id={`prototype-header-model-${locale}`} class="prototype-model-select">
              <option>{copy.model}</option>
            </select>
            <span class="prototype-select-chevron" aria-hidden="true">⌄</span>
          </span>
        </span>
        <span class="prototype-status-dot" aria-hidden="true"></span>
      </div>
    </header>

    <div class="prototype-workspace">
      <aside class="prototype-panel" aria-label={copy.create}>
        <div class="prototype-panel-heading">
          <h2>{copy.create}</h2>
          <span class="prototype-ready"><i aria-hidden="true"></i>{copy.ready}</span>
        </div>

        <div class="prototype-tabs" role="tablist" aria-label={isZh ? '生成模式' : 'Generation mode'}>
          <button type="button" class="prototype-tab is-active" role="tab" aria-selected="true" disabled>{copy.textToImage}</button>
          <button type="button" class="prototype-tab" role="tab" aria-selected="false" disabled>{copy.imageToImage}</button>
        </div>

        <div class="prototype-field">
          <div class="prototype-field-label">
            <label for={`prototype-prompt-${locale}`}>{copy.promptLabel}</label>
            <span>{copy.promptCount}</span>
          </div>
          <textarea id={`prototype-prompt-${locale}`} readonly value={copy.prompt}></textarea>
          <p class="prototype-field-hint"><span aria-hidden="true">✦</span>{copy.promptHint}</p>
        </div>

        <div class="prototype-chip-row" aria-label={copy.inspiration}>
          <span class="prototype-chip-label">{copy.inspiration}</span>
          {copy.chips.map((chip, index) => <span class:list={['prototype-chip', { 'is-highlighted': index === 0 }]}>{chip}</span>)}
        </div>

        <div class="prototype-field prototype-reference-field">
          <div class="prototype-field-label">
            <label>{copy.referenceLabel}</label>
            <span>{copy.optional}</span>
          </div>
          <div class="prototype-dropzone" aria-hidden="true">
            <div class="prototype-dropzone-icon"><span>＋</span></div>
            <div>
              <strong>{copy.uploadTitle}</strong>
              <p>{copy.uploadHint}</p>
              <small>{copy.uploadTypes}</small>
            </div>
          </div>
        </div>

        <fieldset class="prototype-ratio-field">
          <legend>{copy.ratioLabel}</legend>
          <div class="prototype-ratio-grid">
            <label class="prototype-ratio is-selected">
              <input type="radio" name={`prototype-ratio-${locale}`} checked disabled />
              <span class="prototype-ratio-shape is-square"></span>
              <strong>1:1</strong>
              <small>{copy.square}</small>
            </label>
            <label class="prototype-ratio">
              <input type="radio" name={`prototype-ratio-${locale}`} disabled />
              <span class="prototype-ratio-shape is-landscape"></span>
              <strong>16:9</strong>
              <small>{copy.landscape}</small>
            </label>
            <label class="prototype-ratio">
              <input type="radio" name={`prototype-ratio-${locale}`} disabled />
              <span class="prototype-ratio-shape is-portrait"></span>
              <strong>9:16</strong>
              <small>{copy.portrait}</small>
            </label>
          </div>
        </fieldset>

        <div class="prototype-panel-footer">
          <div class="prototype-action-row">
            <button type="button" class="prototype-button prototype-button-primary" disabled><span aria-hidden="true">✦</span>{copy.generate}</button>
            <button type="button" class="prototype-button prototype-button-secondary" disabled>{copy.clear}</button>
          </div>
          <p class="prototype-privacy">{copy.privacy}</p>
        </div>
      </aside>

      <section class="prototype-stage" aria-labelledby={`prototype-result-${locale}`}>
        <div class="prototype-stage-heading">
          <h2 id={`prototype-result-${locale}`}>{copy.result}</h2>
          <span class="prototype-stage-state"><i aria-hidden="true"></i>{copy.ready}</span>
        </div>
        <div class="prototype-canvas-wrap">
          <button type="button" class="prototype-canvas" data-prototype-zoom aria-label={copy.zoom} title={copy.zoom}>
            <img class="prototype-result-image" src={mainArtwork} alt="原型示例生成结果" />
            <span class="prototype-canvas-corner prototype-canvas-corner-tl" aria-hidden="true"></span>
            <span class="prototype-canvas-corner prototype-canvas-corner-tr" aria-hidden="true"></span>
            <span class="prototype-canvas-corner prototype-canvas-corner-bl" aria-hidden="true"></span>
            <span class="prototype-canvas-corner prototype-canvas-corner-br" aria-hidden="true"></span>
          </button>
        </div>
        <div class="prototype-result-meta">
          <div class="prototype-result-meta-row">
            <span class="prototype-tag">{copy.modeLabel}</span>
            <span class="prototype-tag is-soft">1:1</span>
            <span class="prototype-tag is-soft">{copy.model}</span>
          </div>
          <span class="prototype-result-date">{copy.createdAt}</span>
        </div>
        <div class="prototype-result-actions">
          <button type="button" class="prototype-button prototype-button-secondary"><span aria-hidden="true">↓</span>{copy.download}</button>
          <button type="button" class="prototype-button prototype-button-secondary"><span aria-hidden="true">↻</span>{copy.regenerate}</button>
        </div>
      </section>
    </div>

    <section class="prototype-history" aria-labelledby={`prototype-history-${locale}`}>
      <div class="prototype-history-heading">
        <div>
          <h2 id={`prototype-history-${locale}`}>{copy.historyTitle}</h2>
          <p>{copy.historyDescription}</p>
        </div>
        <span class="prototype-history-count">{copy.historyCount}</span>
      </div>
      <div class="prototype-history-grid">
        {historyItems.map((item) => (
          <article class="prototype-history-card">
            <div class="prototype-history-thumb-wrap">
              <img class="prototype-history-thumb" src={item.artwork} alt={item.prompt} />
              <button type="button" class="prototype-history-more" aria-label={copy.more} aria-expanded="false">⋯</button>
            </div>
            <div class="prototype-history-info">
              <div class="prototype-history-meta">
                <span class="prototype-tag">{item.mode}</span>
                <span class="prototype-tag is-soft">{item.ratio}</span>
              </div>
              <p class="prototype-history-summary">{item.prompt}</p>
              <div class="prototype-history-foot">
                <span class="prototype-history-model">{item.model}</span>
                <time>{item.date}</time>
              </div>
            </div>
          </article>
        ))}
      </div>
    </section>

    <p class="prototype-note"><span aria-hidden="true">ⓘ</span>{copy.visualNote}</p>
  </div>

  <div class="prototype-lightbox" data-prototype-lightbox hidden role="dialog" aria-modal="true" aria-label={copy.zoom}>
    <button type="button" class="prototype-lightbox-backdrop" data-prototype-close aria-label={copy.closeZoom}></button>
    <div class="prototype-lightbox-panel">
      <button type="button" class="prototype-lightbox-close" data-prototype-close aria-label={copy.closeZoom} title={copy.closeZoom}>×</button>
      <img class="prototype-lightbox-image" data-prototype-zoom-image src={mainArtwork} alt="原型示例生成结果" />
    </div>
  </div>
</section>

<style>
  .agnes-prototype {
    --prototype-panel-width: 370px;
    min-height: calc(100vh - 64px);
    padding: 52px 0 76px;
    background:
      radial-gradient(circle at 87% 7%, color-mix(in srgb, var(--accent) 7%, transparent), transparent 25rem),
      var(--bg);
  }

  .prototype-container {
    width: min(var(--maxw), calc(100% - 48px));
    margin: 0 auto;
  }

  .prototype-intro {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 28px;
    margin-bottom: 34px;
  }

  .prototype-kicker { display: flex; align-items: center; gap: 10px; margin-bottom: 14px; }
  .prototype-badge, .prototype-label, .prototype-ready, .prototype-stage-state, .prototype-coming-soon {
    display: inline-flex;
    align-items: center;
    white-space: nowrap;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: .08em;
    text-transform: uppercase;
  }
  .prototype-badge { padding: 5px 9px; border-radius: 999px; background: var(--accent-bg); color: var(--accent); }
  .prototype-label { color: var(--text-muted); }
  .prototype-intro h1 { max-width: 760px; margin: 0 0 10px; color: var(--text); font-size: clamp(32px, 5vw, 52px); font-weight: 800; letter-spacing: -.045em; line-height: 1.08; }
  .prototype-gradient { background: linear-gradient(135deg, var(--accent), var(--accent-2)); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .prototype-intro p { max-width: 680px; margin: 0; color: var(--text-soft); font-size: 16px; line-height: 1.65; }

  .prototype-model-card { display: flex; flex: 0 0 auto; align-items: center; gap: 10px; min-width: 252px; padding: 10px 13px; border: 1px solid var(--border); border-radius: var(--radius); background: color-mix(in srgb, var(--bg-card) 88%, transparent); box-shadow: var(--shadow-sm); }
  .prototype-model-card-field { display: flex; flex: 1; flex-direction: column; gap: 2px; min-width: 0; }
  .prototype-model-card-field > label { color: var(--text-muted); font-size: 9px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; }
  .prototype-model-card .prototype-model-select-wrap { position: relative; display: flex; align-items: center; min-width: 0; border: 0; background: transparent; }
  .prototype-model-card .prototype-model-select-wrap .prototype-select-chevron { right: 1px; font-size: 16px; }
  .prototype-model-card .prototype-model-select { width: 100%; min-width: 0; height: 25px; padding: 0 23px 0 0; border: 0; outline: 0; appearance: none; background: transparent; color: var(--text); font: inherit; font-size: 12px; font-weight: 750; cursor: pointer; }
  .prototype-model-card .prototype-model-select:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; border-radius: 4px; }
  .prototype-model-icon { display: grid; width: 29px; height: 29px; place-items: center; border-radius: 9px; background: var(--accent-bg); color: var(--accent); font-size: 16px; }
  .prototype-status-dot { width: 7px; height: 7px; flex: 0 0 7px; border-radius: 50%; background: var(--green); box-shadow: 0 0 0 4px color-mix(in srgb, var(--green) 14%, transparent); }

  .prototype-workspace { display: grid; grid-template-columns: var(--prototype-panel-width) minmax(0, 1fr); gap: 22px; align-items: start; }
  .prototype-panel, .prototype-stage, .prototype-history { border: 1px solid var(--border); border-radius: var(--radius); background: var(--bg-card); box-shadow: var(--shadow-sm); }
  .prototype-panel { padding: 22px; }
  .prototype-panel-heading, .prototype-stage-heading, .prototype-history-heading { display: flex; align-items: flex-start; justify-content: space-between; gap: 14px; }
  .prototype-panel-heading { margin-bottom: 20px; }
  .prototype-panel h2, .prototype-stage h2, .prototype-history h2 { margin: 0; color: var(--text); font-size: 20px; font-weight: 750; letter-spacing: -.025em; }
  .prototype-ready, .prototype-stage-state { gap: 7px; color: var(--text-muted); font-size: 10px; letter-spacing: .04em; }
  .prototype-ready i, .prototype-stage-state i { width: 6px; height: 6px; border-radius: 50%; background: var(--green); }

  .prototype-tabs { display: grid; grid-template-columns: 1fr 1fr; gap: 4px; margin-bottom: 22px; padding: 4px; border-radius: var(--radius-sm); background: var(--bg-soft); }
  .prototype-tab { min-height: 36px; padding: 0 8px; border: 0; border-radius: 6px; background: transparent; color: var(--text-muted); font: inherit; font-size: 12px; font-weight: 700; }
  .prototype-tab.is-active { background: var(--bg-card); color: var(--text); box-shadow: var(--shadow-sm); }
  .prototype-tab:disabled { cursor: default; opacity: 1; }

  .prototype-model-field { margin-bottom: 20px; }
  .prototype-model-select-wrap { position: relative; display: flex; align-items: center; min-height: 46px; border: 1px solid color-mix(in srgb, var(--accent) 30%, var(--border)); border-radius: var(--radius-sm); background: var(--bg-soft); }
  .prototype-model-select-wrap::after { position: absolute; inset: 0; border: 1px solid transparent; border-radius: inherit; content: ''; pointer-events: none; }
  .prototype-model-select-icon { display: grid; width: 30px; height: 30px; flex: 0 0 30px; place-items: center; margin-left: 10px; border-radius: 8px; background: var(--accent-bg); color: var(--accent); font-size: 15px; }
  .prototype-model-select { width: 100%; min-width: 0; height: 44px; padding: 0 34px 0 10px; border: 0; outline: 0; appearance: none; background: transparent; color: var(--text); font: inherit; font-size: 12px; font-weight: 700; }
  .prototype-model-select:disabled { cursor: default; opacity: 1; }
  .prototype-select-chevron { position: absolute; right: 13px; color: var(--accent); font-size: 18px; line-height: 1; pointer-events: none; transform: translateY(-2px); }

  .prototype-field { margin-bottom: 19px; }
  .prototype-field-label { display: flex; align-items: center; justify-content: space-between; gap: 10px; margin-bottom: 8px; }
  .prototype-field-label label, .prototype-ratio-field legend { color: var(--text); font-size: 12px; font-weight: 750; }
  .prototype-field-label span { color: var(--text-muted); font-size: 10px; font-weight: 600; letter-spacing: .04em; }
  .prototype-field textarea { display: block; width: 100%; min-height: 142px; resize: none; padding: 12px 13px; border: 1px solid var(--border); border-radius: var(--radius-sm); outline: 0; background: var(--bg-soft); color: var(--text); font: inherit; font-size: 12px; line-height: 1.55; }
  .prototype-field textarea:focus { border-color: var(--accent); box-shadow: 0 0 0 3px var(--accent-bg); }
  .prototype-field-hint { display: flex; align-items: center; gap: 5px; margin: 7px 0 0; color: var(--text-muted); font-size: 10px; }
  .prototype-field-hint span { color: var(--accent); }
  .prototype-chip-row { display: flex; align-items: center; flex-wrap: wrap; gap: 6px; margin: -2px 0 20px; }
  .prototype-chip-label { width: 100%; margin-bottom: 1px; color: var(--text-muted); font-size: 10px; font-weight: 700; }
  .prototype-chip { padding: 4px 8px; border: 1px solid var(--border); border-radius: 999px; color: var(--text-soft); font-size: 10px; }
  .prototype-chip.is-highlighted { border-color: color-mix(in srgb, var(--accent) 35%, var(--border)); background: var(--accent-bg); color: var(--accent); }

