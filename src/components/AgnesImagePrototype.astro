<script is:inline>
  (() => {
    const zoomTrigger = document.querySelector('[data-prototype-zoom]');
    const lightbox = document.querySelector('[data-prototype-lightbox]');
    const closeButtons = lightbox?.querySelectorAll('[data-prototype-close]');
    const closeButton = lightbox?.querySelector('.prototype-lightbox-close');
    if (!zoomTrigger || !lightbox || !closeButtons?.length) return;

    let previousActiveElement = null;

    function openLightbox() {
      previousActiveElement = document.activeElement;
      lightbox.hidden = false;
      document.body.style.overflow = 'hidden';
      closeButton?.focus();
    }

    function closeLightbox() {
      lightbox.hidden = true;
      document.body.style.overflow = '';
      if (previousActiveElement instanceof HTMLElement) previousActiveElement.focus();
    }

    zoomTrigger.addEventListener('click', openLightbox);
    closeButtons.forEach((button) => button.addEventListener('click', closeLightbox));
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && !lightbox.hidden) closeLightbox();
    });
  })();
</script>
