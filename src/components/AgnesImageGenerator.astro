---
interface Props {
  locale?: 'en' | 'zh';
}

const { locale = 'en' } = Astro.props;
const isZh = locale === 'zh';
const apiUrl = import.meta.env.PUBLIC_AGNES_API_URL
  || (import.meta.env.DEV ? (import.meta.env.PUBLIC_AGNES_LOCAL_API_URL || '') : '');
const modelOptions = [
  { id: 'agnes-image-2.1-flash', label: 'Agnes Image 2.1 Flash' },
];
const defaultModel = modelOptions[0].id;
const copy = isZh
  ? {
      titleSuffix: '生图工作台',
      subtitle: '把灵感变成画面。无需登录即可使用 Agnes Image 2.1 Flash，开始你的下一次创作。',
      badge: '无需登录',
      modelLabel: '当前模型',
      txt2img: '文生图',
      img2img: '图生图',
      create: '创建图像',
      promptLabel: '图片描述',
      placeholder: '例如：A cinematic editorial portrait in warm studio light, highly detailed',
      img2imgPlaceholder: '描述你想要的修改，例如：Transform into a cyberpunk night scene',
      promptHint: '清晰描述主体、风格、光线和构图',
      example: '填入示例 Prompt',
      promptCount: '0 / 4000',
      inspiration: '灵感标签',
      chips: ['电影感', '暖色灯光', '高细节'],
      referenceLabel: '参考图片',
      optional: '可选',
      uploadTitle: '添加参考图',
      uploadHint: '拖拽图片到这里，或点击上传',
      uploadDragHint: '松开即可添加参考图',
      uploadDropHint: '正在读取参考图…',
      uploadTypes: 'JPG、PNG、WebP · 每张最多 5MB，最多 4 张',
      imageRequired: '图生图至少需要一张参考图片。',
      aspectLabel: '画面比例',
      square: '正方形',
      landscape: '横向',
      portrait: '竖向',
      generate: '生成图片',
      generating: '正在生成…',
      reset: '清空',
      resultTitle: '生成结果',
      empty: '生成的图片会显示在这里。',
      download: '下载图片',
      retry: '再次生成',
      localDisabled: '本地 API 尚未启用，请先启动本地服务。',
      ready: '准备就绪',
      waitingTitle: '你的画面将在这里出现',
      waitingDescription: '在左侧写下一个想法，开始你的下一次创作',
      loadingTitle: '正在生成图片',
      loadingDescription: 'Agnes AI 正在处理，请稍候…',
      errorTitle: '图片生成失败',
      errorDescription: '请检查提示词或稍后重试',
      sending: '正在调用 Agnes AI…',
      success: '生成完成',
      failure: '生成失败',
      generatedBy: '图片由 Agnes AI 生成。本站不建立账号，也不保存服务端用户记录。',
      imageError: '返回的图片无法显示，请重试。',
      fileTooLarge: '文件超过 5MB，请选择更小的图片。',
      fileBadType: '不支持的图片类型，请选择 JPG、PNG 或 WebP。',
      fileTooMany: '最多上传 4 张图片。',
      fileTotalTooLarge: '参考图片总大小不能超过 12MB。',
      promptTooLong: '提示词不能超过 4000 个字符。',
      privacy: '上传图片和预览仅在当前浏览器中进行。点击生成后，提示词和图片会通过配置的 API 代理发送给 Agnes AI 处理；本站不建立用户账号，也不保存服务端用户记录。请勿提交私人照片、身份证、商业机密、医疗信息或其他敏感内容。',
      canvas: '画布',
      zoom: '放大预览',
      closeZoom: '关闭预览',
      historyTitle: '最近创作',
      historyEmpty: '还没有生成记录。生成图片后会自动保存在此浏览器中。',
      clearHistory: '清空历史',
      more: '更多',
      usePrompt: '重新使用提示词',
      downloadHistory: '下载',
      deleteHistory: '删除',
      saved: '已保存到本地历史',
      storageNote: '历史记录只保存在当前浏览器，不会上传到服务器。',
    }
  : {
      titleSuffix: 'Image Studio',
      subtitle: 'Turn an idea into an image. Use Agnes Image 2.1 Flash without an account and start your next creation.',
      badge: 'NO ACCOUNT',
      modelLabel: 'CURRENT MODEL',
      txt2img: 'Text to Image',
      img2img: 'Image to Image',
      create: 'Create image',
      promptLabel: 'Image prompt',
      placeholder: 'Example: A cinematic editorial portrait in warm studio light, highly detailed',
      img2imgPlaceholder: 'Describe the edit, e.g.: Transform into a cyberpunk night scene',
      promptHint: 'Describe the subject, style, light, and composition',
      example: 'Use example prompt',
      promptCount: '0 / 4000',
      inspiration: 'Inspiration tags',
      chips: ['Cinematic', 'Warm light', 'Highly detailed'],
      referenceLabel: 'Reference image',
      optional: 'OPTIONAL',
      uploadTitle: 'Add a reference',
      uploadHint: 'Drop an image here, or click to upload',
      uploadDragHint: 'Release to add your reference image',
      uploadDropHint: 'Reading reference image…',
      uploadTypes: 'JPG, PNG, WebP · Up to 5MB each, 4 images max',
      imageRequired: 'Image-to-image needs at least one reference image.',
      aspectLabel: 'Aspect ratio',
      square: 'Square',
      landscape: 'Landscape',
      portrait: 'Portrait',
      generate: 'Generate image',
      generating: 'Generating…',
      reset: 'Clear',
      resultTitle: 'Generation result',
      empty: 'Your generated image will appear here.',
      download: 'Download image',
      retry: 'Generate again',
      localDisabled: 'The local API is not enabled. Start the local service first.',
      ready: 'Ready',
      waitingTitle: 'Your image will appear here',
      waitingDescription: 'Write an idea on the left to start your next creation',
      loadingTitle: 'Generating image',
      loadingDescription: 'Agnes AI is processing your request…',
      errorTitle: 'Generation failed',
      errorDescription: 'Check the prompt or try again later',
      sending: 'Calling Agnes AI…',
      success: 'Generation complete',
      failure: 'Generation failed',
      generatedBy: 'Generated by Agnes AI. This site does not create accounts or store server-side user records.',
      imageError: 'The returned image could not be displayed. Try again.',
      fileTooLarge: 'File exceeds 5MB. Please choose a smaller image.',
      fileBadType: 'Unsupported image type. Please choose JPG, PNG, or WebP.',
      fileTooMany: 'Maximum 4 images allowed.',
      fileTotalTooLarge: 'Reference images must total 12MB or less.',
      promptTooLong: 'Prompt must be 4000 characters or fewer.',
      privacy: 'Image selection and preview stay in this browser. When you generate, your prompt and images are sent through the configured API proxy to Agnes AI for processing. This site does not create user accounts or store server-side user records. Do not submit private photos, identity documents, trade secrets, medical information, or other sensitive content.',
      canvas: 'Canvas',
      zoom: 'Open enlarged preview',
      closeZoom: 'Close preview',
      historyTitle: 'Recent creations',
      historyEmpty: 'No generated images yet. New results are saved in this browser.',
      clearHistory: 'Clear history',
      more: 'More',
      usePrompt: 'Use prompt',
      downloadHistory: 'Download',
      deleteHistory: 'Delete',
      saved: 'Saved to local history',
      storageNote: 'History stays in this browser and is not uploaded to the server.',
    };
---

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">

<section
  class="agnes-tool"
  data-locale={locale}
  data-api-url={apiUrl}
  data-enabled={apiUrl ? 'true' : 'false'}
  data-model-default={defaultModel}
  data-image-error={copy.imageError}
  data-file-too-large={copy.fileTooLarge}
  data-file-bad-type={copy.fileBadType}
  data-file-too-many={copy.fileTooMany}
  data-file-total-too-large={copy.fileTotalTooLarge}
  data-upload-hint={copy.uploadHint}
  data-upload-drag-hint={copy.uploadDragHint}
  data-upload-drop-hint={copy.uploadDropHint}
  data-image-required={copy.imageRequired}
  data-prompt-too-long={copy.promptTooLong}
  data-waiting-title={copy.waitingTitle}
  data-waiting-description={copy.waitingDescription}
  data-loading-title={copy.loadingTitle}
  data-loading-description={copy.loadingDescription}
  data-error-title={copy.errorTitle}
  data-error-description={copy.errorDescription}
  data-status-ready={copy.ready}
  data-status-sending={copy.sending}
  data-local-disabled={copy.localDisabled}
  data-status-success={copy.success}
  data-status-failure={copy.failure}
  data-history-empty-text={copy.historyEmpty}
  data-canvas-label={copy.canvas}
>
  <div class="agnes-container">
    <header class="agnes-intro">
      <div class="agnes-intro-copy">
        <div class="agnes-kicker">
          <span class="agnes-badge">{copy.badge}</span>
          <span class="agnes-kicker-label">AI IMAGE GENERATION</span>
        </div>
        <h1><span class="agnes-gradient">Agnes AI</span> {copy.titleSuffix}</h1>
        <p>{copy.subtitle}</p>
      </div>
      <div class="agnes-model-card">
        <span class="agnes-model-icon" aria-hidden="true">✦</span>
        <div class="agnes-model-field">
          <label for={`agnes-model-${locale}`}>{copy.modelLabel}</label>
          <div class="agnes-model-select-wrap">
            <select id={`agnes-model-${locale}`} class="agnes-model-select" data-model aria-label={copy.modelLabel}>
              {modelOptions.map((model) => <option value={model.id}>{model.label}</option>)}
            </select>
            <span class="agnes-select-chevron" aria-hidden="true">⌄</span>
          </div>
        </div>
        <span class="agnes-status-dot" aria-hidden="true"></span>
      </div>
    </header>

    <div class="agnes-workspace">
      <form class="agnes-sidebar agnes-form" data-generator-form>
        <div class="agnes-panel-heading">
          <h2>{copy.create}</h2>
          <span class="agnes-ready"><i aria-hidden="true"></i>{copy.ready}</span>
        </div>

        <div class="agnes-tabs" data-tabs role="tablist" aria-label={isZh ? '生成模式' : 'Generation mode'}>
          <button type="button" class="agnes-tab active" data-mode="txt2img" role="tab" aria-selected="true">{copy.txt2img}</button>
          <button type="button" class="agnes-tab" data-mode="img2img" role="tab" aria-selected="false">{copy.img2img}</button>
        </div>

        <div class="agnes-form-group">
          <div class="agnes-field-label">
            <label for={`agnes-prompt-${locale}`}>{copy.promptLabel}</label>
            <span data-counter>{copy.promptCount}</span>
          </div>
          <textarea
            id={`agnes-prompt-${locale}`}
            name="prompt"
            maxlength="4000"
            required
            placeholder={copy.placeholder}
            data-placeholder-txt={copy.placeholder}
            data-placeholder-img={copy.img2imgPlaceholder}
          ></textarea>
          <div class="agnes-form-row">
            <button class="agnes-example" type="button" data-example>{copy.example}</button>
            <span class="agnes-field-hint"><span aria-hidden="true">✦</span>{copy.promptHint}</span>
          </div>
        </div>

        <div class="agnes-chip-row" aria-label={copy.inspiration}>
          <span class="agnes-chip-label">{copy.inspiration}</span>
          {copy.chips.map((chip, index) => <span class:list={['agnes-chip', { 'is-highlighted': index === 0 }]}>{chip}</span>)}
        </div>

        <div class="agnes-upload-section" data-upload-section hidden>
          <div class="agnes-field-label">
            <label>{copy.referenceLabel}</label>
            <span>{copy.optional}</span>
          </div>
          <div class="agnes-dropzone" data-dropzone>
            <input type="file" accept="image/jpeg,image/png,image/webp" multiple data-file-input hidden />
            <div class="agnes-dropzone-icon" aria-hidden="true">＋</div>
            <div class="agnes-dropzone-copy">
              <strong>{copy.uploadTitle}</strong>
              <p class="agnes-dropzone-text">{copy.uploadHint}</p>
              <small>{copy.uploadTypes}</small>
            </div>
            <span class="agnes-dropzone-count" data-file-count hidden></span>
          </div>
          <div class="agnes-file-preview" data-file-preview></div>
        </div>

        <fieldset class="agnes-ratio-group">
          <legend>{copy.aspectLabel}</legend>
          <div class="agnes-ratio-grid">
            <label class="agnes-ratio is-selected">
              <input type="radio" name={`aspect-${locale}`} value="1:1" checked />
              <span class="agnes-ratio-shape ratio-square"></span>
              <strong>1:1</strong>
              <small>{copy.square}</small>
            </label>
            <label class="agnes-ratio">
              <input type="radio" name={`aspect-${locale}`} value="16:9" />
              <span class="agnes-ratio-shape ratio-landscape"></span>
              <strong>16:9</strong>
              <small>{copy.landscape}</small>
            </label>
            <label class="agnes-ratio">
              <input type="radio" name={`aspect-${locale}`} value="9:16" />
              <span class="agnes-ratio-shape ratio-portrait"></span>
              <strong>9:16</strong>
              <small>{copy.portrait}</small>
            </label>
          </div>
        </fieldset>

        <div class="agnes-sidebar-footer">
          <div class="agnes-actions">
            <button class="agnes-primary" type="submit" data-submit disabled={!apiUrl}><span aria-hidden="true">✦</span>{copy.generate}</button>
            <button class="agnes-secondary" type="button" data-reset>{copy.reset}</button>
          </div>
          <p class="agnes-status" data-status aria-live="polite">{apiUrl ? copy.ready : copy.localDisabled}</p>
          <p class="agnes-disclaimer">{copy.privacy}</p>
        </div>
      </form>

      <section class="agnes-canvas" aria-labelledby={`agnes-result-${locale}`}>
        <section class="agnes-result">
          <div class="agnes-stage-heading">
            <h2 id={`agnes-result-${locale}`}>{copy.resultTitle}</h2>
            <span class="agnes-result-state" data-result-state>{copy.ready}</span>
          </div>
          <div class="agnes-preview" data-preview>
            <div class="agnes-preview-canvas" data-preview-canvas data-ratio="1:1">
              <div class="agnes-preview-grid" aria-hidden="true"></div>
              <div class="agnes-preview-glow agnes-preview-glow-one" aria-hidden="true"></div>
              <div class="agnes-preview-glow agnes-preview-glow-two" aria-hidden="true"></div>
              <div class="agnes-preview-empty" data-empty>
                <img class="agnes-preview-reference" data-reference-image alt="" hidden />
                <div class="agnes-preview-icon" aria-hidden="true">✦</div>
                <strong data-empty-title>{copy.waitingTitle}</strong>
                <p data-empty-description>{copy.waitingDescription}</p>
                <span class="agnes-canvas-ratio" data-preview-ratio>{copy.canvas} 1:1</span>
              </div>
              <img data-image alt={copy.resultTitle} hidden tabindex="0" role="button" aria-label={copy.zoom} />
              <span class="agnes-canvas-corner agnes-canvas-corner-tl" aria-hidden="true"></span>
              <span class="agnes-canvas-corner agnes-canvas-corner-tr" aria-hidden="true"></span>
              <span class="agnes-canvas-corner agnes-canvas-corner-bl" aria-hidden="true"></span>
              <span class="agnes-canvas-corner agnes-canvas-corner-br" aria-hidden="true"></span>
            </div>
          </div>
          <div class="agnes-result-actions" data-result-actions hidden>
            <a class="agnes-primary" data-download download="agnes-image.png" href="#"><span aria-hidden="true">↓</span>{copy.download}</a>
            <button class="agnes-secondary" type="button" data-retry><span aria-hidden="true">↻</span>{copy.retry}</button>
          </div>
          <p class="agnes-generated-by">{copy.generatedBy}</p>
        </section>
      </section>
    </div>

    <section class="agnes-history" data-history-panel aria-labelledby={`agnes-history-${locale}`} data-history-empty-text={copy.historyEmpty} data-history-more-text={copy.more} data-history-use-text={copy.usePrompt} data-history-download-text={copy.downloadHistory} data-history-delete-text={copy.deleteHistory} data-history-clear-text={copy.clearHistory} data-history-txt-label={copy.txt2img} data-history-img-label={copy.img2img} data-history-saved={copy.saved}>
      <div class="agnes-history-head">
        <div>
          <h2 id={`agnes-history-${locale}`}>{copy.historyTitle}</h2>
          <p>{copy.storageNote}</p>
        </div>
        <button type="button" class="agnes-secondary" data-history-clear hidden>{copy.clearHistory}</button>
      </div>
      <p class="agnes-history-empty" data-history-empty>{copy.historyEmpty}</p>
      <div class="agnes-history-grid" data-history-list></div>
    </section>
  </div>

  <div class="agnes-lightbox" data-lightbox hidden role="dialog" aria-modal="true" aria-label={copy.zoom}>
    <button type="button" class="agnes-lightbox-backdrop" data-lightbox-close aria-label={copy.closeZoom}></button>
    <div class="agnes-lightbox-panel">
      <button type="button" class="agnes-lightbox-close" data-lightbox-close aria-label={copy.closeZoom} title={copy.closeZoom}>×</button>
      <img class="agnes-lightbox-image" data-lightbox-image alt="" />
    </div>
  </div>
</section>

<style>
  .agnes-tool { --agnes-panel-width: 370px; min-height: calc(100vh - 64px); padding: 52px 0 76px; background: radial-gradient(circle at 87% 7%, color-mix(in srgb, var(--accent) 7%, transparent), transparent 25rem), var(--bg); }
  .agnes-container { width: min(var(--maxw), calc(100% - 48px)); margin: 0 auto; }
  .agnes-intro { display: flex; align-items: flex-end; justify-content: space-between; gap: 28px; margin-bottom: 34px; }
  .agnes-kicker { display: flex; align-items: center; gap: 10px; margin-bottom: 14px; }
  .agnes-badge, .agnes-kicker-label, .agnes-ready, .agnes-result-state { display: inline-flex; align-items: center; white-space: nowrap; font-size: 10px; font-weight: 750; letter-spacing: .08em; text-transform: uppercase; }
  .agnes-badge { padding: 5px 9px; border-radius: 999px; background: var(--accent-bg); color: var(--accent); }
  .agnes-kicker-label { color: var(--text-muted); }
  .agnes-intro h1 { margin: 0 0 10px; color: var(--text); font-size: clamp(32px, 5vw, 52px); font-weight: 800; letter-spacing: -.045em; line-height: 1.08; }
  .agnes-gradient { background: linear-gradient(135deg, var(--accent), var(--accent-2)); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .agnes-intro p { max-width: 680px; margin: 0; color: var(--text-soft); font-size: 16px; line-height: 1.65; }
  .agnes-model-card { display: flex; flex: 0 0 auto; align-items: center; gap: 10px; min-width: 252px; padding: 10px 13px; border: 1px solid var(--border); border-radius: var(--radius); background: color-mix(in srgb, var(--bg-card) 88%, transparent); box-shadow: var(--shadow-sm); }
  .agnes-model-icon { display: grid; width: 29px; height: 29px; place-items: center; border-radius: 9px; background: var(--accent-bg); color: var(--accent); font-size: 16px; }
  .agnes-model-field { display: flex; flex: 1; flex-direction: column; gap: 2px; min-width: 0; }
  .agnes-model-field label { color: var(--text-muted); font-size: 9px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; }
  .agnes-model-select-wrap { position: relative; display: flex; align-items: center; min-width: 0; }
  .agnes-model-select { width: 100%; min-width: 0; height: 25px; padding: 0 23px 0 0; border: 0; outline: 0; appearance: none; background: transparent; color: var(--text); font: inherit; font-size: 12px; font-weight: 750; cursor: pointer; }
  .agnes-model-select:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; border-radius: 4px; }
  .agnes-model-select:disabled { cursor: default; opacity: .6; }
  .agnes-select-chevron { position: absolute; right: 1px; color: var(--accent); font-size: 16px; line-height: 1; pointer-events: none; transform: translateY(-2px); }
  .agnes-status-dot { width: 7px; height: 7px; flex: 0 0 7px; border-radius: 50%; background: var(--green); box-shadow: 0 0 0 4px color-mix(in srgb, var(--green) 14%, transparent); }

  .agnes-workspace { display: grid; grid-template-columns: var(--agnes-panel-width) minmax(0, 1fr); gap: 22px; align-items: start; }
  .agnes-sidebar, .agnes-history { border: 1px solid var(--border); border-radius: var(--radius); background: var(--bg-card); box-shadow: var(--shadow-sm); }
  .agnes-sidebar { display: flex; flex-direction: column; min-width: 0; padding: 22px; }
  .agnes-panel-heading, .agnes-stage-heading, .agnes-history-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 14px; }
  .agnes-panel-heading { margin-bottom: 20px; }
  .agnes-panel-heading h2, .agnes-stage-heading h2, .agnes-history h2 { margin: 0; color: var(--text); font-size: 20px; font-weight: 750; letter-spacing: -.025em; }
  .agnes-ready, .agnes-result-state { gap: 7px; color: var(--text-muted); font-size: 10px; letter-spacing: .04em; }
  .agnes-ready i { width: 6px; height: 6px; border-radius: 50%; background: var(--green); }
  .agnes-result-state[data-error="true"] { color: var(--red); }

  .agnes-tabs { display: grid; grid-template-columns: 1fr 1fr; gap: 4px; margin-bottom: 22px; padding: 4px; border-radius: var(--radius-sm); background: var(--bg-soft); }
  .agnes-tab { min-height: 36px; padding: 0 8px; border: 0; border-radius: 6px; background: transparent; color: var(--text-muted); font: inherit; font-size: 12px; font-weight: 700; cursor: pointer; }
  .agnes-tab.active { background: var(--bg-card); color: var(--text); box-shadow: var(--shadow-sm); }
  .agnes-tab:focus-visible, .agnes-example:focus-visible, .agnes-button:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .agnes-tab:disabled { cursor: default; opacity: .55; }

  .agnes-form-group { margin-bottom: 18px; }
  .agnes-field-label { display: flex; align-items: center; justify-content: space-between; gap: 10px; margin-bottom: 8px; }
  .agnes-field-label label, .agnes-ratio-group legend { color: var(--text); font-size: 12px; font-weight: 750; }
  .agnes-field-label > span { color: var(--text-muted); font-size: 10px; font-weight: 650; letter-spacing: .04em; }
  .agnes-form textarea { display: block; width: 100%; min-height: 142px; resize: vertical; padding: 12px 13px; border: 1px solid var(--border); border-radius: var(--radius-sm); outline: 0; background: var(--bg-soft); color: var(--text); font: inherit; font-size: 12px; line-height: 1.55; }
  .agnes-form textarea:focus { border-color: var(--accent); background: var(--bg-card); box-shadow: 0 0 0 3px var(--accent-bg); }
  .agnes-form-row { display: flex; align-items: center; justify-content: space-between; gap: 8px; margin-top: 7px; }
  .agnes-example { padding: 0; border: 0; background: transparent; color: var(--accent); cursor: pointer; font: inherit; font-size: 11px; }
  .agnes-example:disabled { cursor: default; opacity: .55; }
  .agnes-field-hint { display: flex; align-items: center; gap: 5px; color: var(--text-muted); font-size: 10px; text-align: right; }
  .agnes-field-hint span { color: var(--accent); }
  .agnes-chip-row { display: flex; align-items: center; flex-wrap: wrap; gap: 6px; margin: -2px 0 20px; }
  .agnes-chip-label { width: 100%; margin-bottom: 1px; color: var(--text-muted); font-size: 10px; font-weight: 700; }
  .agnes-chip { padding: 4px 8px; border: 1px solid var(--border); border-radius: 999px; color: var(--text-soft); font-size: 10px; }
