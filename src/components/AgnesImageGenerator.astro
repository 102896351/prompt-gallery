<script is:inline>
  (() => {
    const tool = document.querySelector('[data-api-url]');
    if (!tool) return;
    const form = tool.querySelector('[data-generator-form]');
    const prompt = form?.querySelector('textarea[name="prompt"]');
    const submit = form?.querySelector('[data-submit]');
    const reset = form?.querySelector('[data-reset]');
    const example = form?.querySelector('[data-example]');
    const counter = form?.querySelector('[data-counter]');
    const status = tool.querySelector('[data-status]');
    const tabs = tool.querySelector('[data-tabs]');
    const modelSelect = tool.querySelector('[data-model]');
    const uploadSection = tool.querySelector('[data-upload-section]');
    const dropzone = tool.querySelector('[data-dropzone]');
    const dropzoneText = tool.querySelector('.agnes-dropzone-text');
    const fileInput = tool.querySelector('[data-file-input]');
    const filePreview = tool.querySelector('[data-file-preview]');
    const fileCount = tool.querySelector('[data-file-count]');
    const preview = tool.querySelector('[data-preview]');
    const previewCanvas = tool.querySelector('[data-preview-canvas]');
    const previewRatio = tool.querySelector('[data-preview-ratio]');
    const image = tool.querySelector('[data-image]');
    const empty = tool.querySelector('[data-empty]');
    const emptyTitle = tool.querySelector('[data-empty-title]');
    const emptyDescription = tool.querySelector('[data-empty-description]');
    const resultState = tool.querySelector('[data-result-state]');
    const resultActions = tool.querySelector('[data-result-actions]');
    const download = tool.querySelector('[data-download]');
    const retry = tool.querySelector('[data-retry]');
    const referenceImage = tool.querySelector('[data-reference-image]');
    const historyPanel = tool.querySelector('[data-history-panel]');
    const historyList = historyPanel?.querySelector('[data-history-list]');
    const historyEmpty = historyPanel?.querySelector('[data-history-empty]');
    const historyClear = historyPanel?.querySelector('[data-history-clear]');
    const lightbox = tool.querySelector('[data-lightbox]');
    const lightboxImage = tool.querySelector('[data-lightbox-image]');
    const lightboxCloseButtons = lightbox?.querySelectorAll('[data-lightbox-close]');
    const lightboxClose = lightbox?.querySelector('.agnes-lightbox-close');
    const apiUrl = tool.dataset.apiUrl || '';
    const MAX_PROMPT_LENGTH = 4000;
    const MAX_FILE_SIZE = 5 * 1024 * 1024;
    const MAX_TOTAL_IMAGE_BYTES = 12 * 1024 * 1024;
    const MAX_FILES = 4;
    const ALLOWED_TYPES = new Set(['image/jpeg', 'image/png', 'image/webp']);
    const text = {
      ready: tool.dataset.statusReady || 'Ready',
      disabled: tool.dataset.enabled === 'true' ? (tool.dataset.statusReady || 'Ready') : (tool.dataset.localDisabled || 'Local API is not enabled'),
      sending: tool.dataset.statusSending || 'Generating…',
      success: tool.dataset.statusSuccess || 'Generation complete',
      failure: tool.dataset.statusFailure || 'Generation failed',
      waitingTitle: tool.dataset.waitingTitle || 'Your image will appear here',
      waitingDescription: tool.dataset.waitingDescription || '',
      loadingTitle: tool.dataset.loadingTitle || 'Generating image',
      loadingDescription: tool.dataset.loadingDescription || 'Processing…',
      errorTitle: tool.dataset.errorTitle || 'Generation failed',
      errorDescription: tool.dataset.errorDescription || 'Try again later',
      uploadHint: tool.dataset.uploadHint || 'Drop an image here, or click to upload',
      uploadDragHint: tool.dataset.uploadDragHint || 'Release to add your reference image',
      uploadDropHint: tool.dataset.uploadDropHint || 'Reading reference image…',
    };
    const exampleTxt = 'A cinematic editorial portrait in warm studio light, highly detailed, elegant composition, realistic texture';
    const exampleImg = 'Transform the scene into a cyberpunk night with neon reflections while preserving the original composition';
    const HISTORY_DB = 'agnes-local-history';
    const HISTORY_STORE = 'generations';
    const HISTORY_LIMIT = 20;
    let mode = 'txt2img';
    let busy = false;
    let uploadedFiles = [];
    let uploadObjectUrls = [];
    let dragDepth = 0;
    let dropStateTimer = null;
    let historyDb;
    let historyObjectUrls = [];
    let currentResultUrl = '';
    let previousActiveElement = null;

    function getModelLabel(modelId) {
      const option = modelSelect?.querySelector(`option[value="${CSS.escape(modelId)}"]`);
      return option?.textContent || modelId || 'Agnes Image 2.1 Flash';
    }

    function openHistoryDb() {
      if (!('indexedDB' in window)) return Promise.resolve(null);
      return new Promise((resolve, reject) => {
        const request = indexedDB.open(HISTORY_DB, 2);
        request.onupgradeneeded = () => {
          const db = request.result;
          if (!db.objectStoreNames.contains(HISTORY_STORE)) db.createObjectStore(HISTORY_STORE, { keyPath: 'id', autoIncrement: true });
        };
        request.onsuccess = () => resolve(request.result);
        request.onerror = () => reject(request.error);
      });
    }

    function historyTransaction(modeName, callback) {
      if (!historyDb) return Promise.resolve(null);
      return new Promise((resolve, reject) => {
        const transaction = historyDb.transaction(HISTORY_STORE, modeName);
        const store = transaction.objectStore(HISTORY_STORE);
        let result;
        try { result = callback(store); } catch (error) { reject(error); return; }
        transaction.oncomplete = () => resolve(result);
        transaction.onerror = () => reject(transaction.error);
      });
    }

    function getHistoryRecords() {
      if (!historyDb) return Promise.resolve([]);
      return new Promise((resolve, reject) => {
        const request = historyDb.transaction(HISTORY_STORE, 'readonly').objectStore(HISTORY_STORE).getAll();
        request.onsuccess = () => resolve(request.result.sort((a, b) => b.createdAt - a.createdAt));
        request.onerror = () => reject(request.error);
      });
    }

    function dataUriToBlob(value) {
      if (!value.startsWith('data:')) return fetch(value).then(response => {
        if (!response.ok) throw new Error('history image fetch failed');
        return response.blob();
      });
      const match = value.match(/^data:([^;]+);base64,(.*)$/);
      if (!match) throw new Error('invalid data URI');
      const binary = atob(match[2]);
      const bytes = new Uint8Array(binary.length);
      for (let i = 0; i < binary.length; i += 1) bytes[i] = binary.charCodeAt(i);
      return Promise.resolve(new Blob([bytes], { type: match[1] }));
    }

    function extensionForMime(mime) {
      if (mime === 'image/jpeg') return 'jpg';
      if (mime === 'image/webp') return 'webp';
      if (mime === 'image/gif') return 'gif';
      return 'png';
    }

    async function saveHistory(src, promptText, generationMode, ratio, modelId) {
      if (!historyDb) return false;
      try {
        await historyTransaction('readwrite', store => store.add({
          imageUrl: src,
          prompt: promptText,
          mode: generationMode,
          ratio,
          model: modelId,
          createdAt: Date.now(),
        }));
        const records = await getHistoryRecords();
        if (records.length > HISTORY_LIMIT) {
          await historyTransaction('readwrite', store => records.slice(HISTORY_LIMIT).forEach(record => store.delete(record.id)));
        }
        await renderHistory();
        return true;
      } catch (error) {
        console.warn('[agnes-local] history save skipped', error);
        return false;
      }
    }

    function clearHistoryObjectUrls() {
      historyObjectUrls.forEach(url => URL.revokeObjectURL(url));
      historyObjectUrls = [];
    }

    function clearCurrentResultUrl() {
      if (currentResultUrl.startsWith('blob:')) URL.revokeObjectURL(currentResultUrl);
      currentResultUrl = '';
    }

    function setCurrentResult(src) {
      clearCurrentResultUrl();
      currentResultUrl = src;
      image.src = src;
      image.hidden = false;
      download.href = src;
    }

    function selectRatio(ratio) {
      const input = form?.querySelector(`input[name^="aspect-"][value="${CSS.escape(ratio)}"]`);
      if (input) input.checked = true;
      form?.querySelectorAll('.agnes-ratio').forEach(label => {
        const labelInput = label.querySelector('input');
        label.classList.toggle('is-selected', labelInput?.value === ratio);
      });
      if (previewCanvas) {
        previewCanvas.dataset.ratio = ratio;
        previewRatio.textContent = `${tool.dataset.canvasLabel || 'Canvas'} ${ratio}`;
      }
    }

    function restoreHistoryRecord(record) {
      setCurrentResult(URL.createObjectURL(record.imageBlob));
      if (record.mode !== mode) switchMode(record.mode);
      if (prompt) { prompt.value = record.prompt || ''; updateCounter(); }
      selectRatio(record.ratio || '1:1');
      if (modelSelect && record.model && modelSelect.querySelector(`option[value="${CSS.escape(record.model)}"]`)) modelSelect.value = record.model;
      setPreviewState('success');
      setState(historyPanel?.dataset.historySaved || text.success);
    }

    async function renderHistory() {
      if (!historyList || !historyEmpty) return;
      historyObjectUrls.forEach(url => URL.revokeObjectURL(url));
      historyObjectUrls = [];
      historyList.innerHTML = '';
      const records = await getHistoryRecords();
      historyEmpty.hidden = records.length > 0;
      if (historyClear) historyClear.hidden = records.length === 0;
      const moreText = historyPanel.dataset.historyMoreText || 'More';
      const useText = historyPanel.dataset.historyUseText || 'Use prompt';
      const downloadText = historyPanel.dataset.historyDownloadText || 'Download';
      const deleteText = historyPanel.dataset.historyDeleteText || 'Delete';
      const txtLabel = historyPanel.dataset.historyTxtLabel || 'Text to Image';
      const imgLabel = historyPanel.dataset.historyImgLabel || 'Image to Image';
      records.forEach(record => {
        const src = record.imageUrl || '';
        const card = document.createElement('div');
        card.className = 'agnes-history-card';
        const imageWrap = document.createElement('div');
        imageWrap.className = 'agnes-history-image-wrap';
        const thumb = document.createElement('img');
        thumb.className = 'agnes-history-image';
        thumb.src = src;
        thumb.alt = record.prompt || '';
        thumb.addEventListener('click', () => {
          if (prompt) { prompt.value = record.prompt || ''; updateCounter(); }
          image.src = src;
          image.hidden = false;
          empty.hidden = true;
          download.href = src;
          resultActions.hidden = false;
          setPreviewState('success');
          setState(text.success);
        });
        const actionsOverlay = document.createElement('div');
        actionsOverlay.className = 'agnes-history-actions-overlay';
        const dlBtn = document.createElement('button');
        dlBtn.type = 'button';
        dlBtn.className = 'agnes-history-action-btn';
        dlBtn.innerHTML = '<i class="fas fa-download"></i>';
        dlBtn.addEventListener('click', (e) => { e.stopPropagation(); window.open(src, '_blank'); });
        const delBtn = document.createElement('button');
        delBtn.type = 'button';
        delBtn.className = 'agnes-history-action-btn delete';
        delBtn.innerHTML = '<i class="fas fa-trash-alt"></i>';
        delBtn.addEventListener('click', async (e) => {
          e.stopPropagation();
          await historyTransaction('readwrite', store => store.delete(record.id));
          await renderHistory();
        });
        actionsOverlay.append(dlBtn, delBtn);
        imageWrap.append(thumb, actionsOverlay);
        const info = document.createElement('div');
        info.className = 'agnes-history-info';
        const modeLabel = document.createElement('h3');
        modeLabel.className = 'agnes-history-mode';
        modeLabel.textContent = record.mode === 'img2img' ? imgLabel : txtLabel;
        const dateLabel = document.createElement('p');
        dateLabel.className = 'agnes-history-date';
        dateLabel.textContent = new Intl.DateTimeFormat(undefined, { month: 'numeric', day: 'numeric', hour: '2-digit', minute: '2-digit' }).format(record.createdAt);
        info.append(modeLabel, dateLabel);
        card.append(imageWrap, info);
        historyList.appendChild(card);
      });
    }

    async function initHistory() {
      try {
        historyDb = await openHistoryDb();
        await renderHistory();
      } catch (error) {
        console.warn('[agnes-local] history unavailable', error);
      }
    }

    function updateCounter() {
      if (counter && prompt) counter.textContent = `${prompt.value.length} / ${MAX_PROMPT_LENGTH}`;
      updateSubmitAvailability();
    }

    function setState(message, failed = false) {
      if (status) {
        status.textContent = message;
        if (failed) status.setAttribute('data-error', 'true');
        else status.removeAttribute('data-error');
      }
      if (resultState) {
        resultState.textContent = message;
        if (failed) resultState.setAttribute('data-error', 'true');
        else resultState.removeAttribute('data-error');
      }
    }

    function setPreviewState(state) {
      preview?.classList.remove('is-loading', 'is-error', 'is-ready', 'is-success');
      previewCanvas?.classList.remove('is-image-ready');
      if (state) preview?.classList.add(`is-${state}`);
      if (state === 'loading') {
        emptyTitle.textContent = text.loadingTitle;
        emptyDescription.textContent = text.loadingDescription;
        referenceImage.hidden = true;
        empty.hidden = false;
        image.hidden = true;
        resultActions.hidden = true;
      } else if (state === 'error') {
        emptyTitle.textContent = text.errorTitle;
        emptyDescription.textContent = text.errorDescription;
        referenceImage.hidden = true;
        empty.hidden = false;
        image.hidden = true;
        resultActions.hidden = true;
      } else if (state === 'success') {
        empty.hidden = true;
        image.hidden = false;
        resultActions.hidden = false;
        previewCanvas?.classList.add('is-image-ready');
        preview?.classList.remove('is-loading');
      } else {
        emptyTitle.textContent = text.waitingTitle;
        emptyDescription.textContent = text.waitingDescription;
        referenceImage.hidden = true;
        empty.hidden = false;
        image.hidden = true;
        resultActions.hidden = true;
      }
    }

    function updateSubmitAvailability() {
      if (submit) submit.disabled = busy || !apiUrl || !prompt?.value.trim() || prompt.value.length > MAX_PROMPT_LENGTH;
    }

    function setBusy(value) {
      busy = value;
      const controls = [
        ...(tabs ? tabs.querySelectorAll('button') : []),
        modelSelect,
        ...(form ? form.querySelectorAll('input[type="radio"]') : []),
        fileInput,
        example,
        reset,
      ].filter(Boolean);
      controls.forEach(control => { control.disabled = value; });
      dropzone?.classList.toggle('is-disabled', value);
      updateSubmitAvailability();
    }

    function switchMode(newMode) {
      if (busy) return;
      mode = newMode === 'img2img' ? 'img2img' : 'txt2img';
      tabs?.querySelectorAll('.agnes-tab').forEach(tab => {
        const active = tab.dataset.mode === mode;
        tab.classList.toggle('active', active);
        tab.setAttribute('aria-selected', String(active));
      });
      if (uploadSection) uploadSection.hidden = mode === 'txt2img';
      if (mode === 'txt2img') clearFiles();
      if (prompt) prompt.placeholder = mode === 'img2img' ? (prompt.dataset.placeholderImg || '') : (prompt.dataset.placeholderTxt || '');
    }

    function applyInitialInput() {
      const params = new URLSearchParams(window.location.search);
      const initialPrompt = params.get('prompt') || '';
      if (initialPrompt && prompt) {
        prompt.value = initialPrompt;
        if (initialPrompt.length > MAX_PROMPT_LENGTH) setState(tool.dataset.promptTooLong || 'Prompt is too long', true);
      }
      updateCounter();
    }

    function renderUploadedFiles() {
      uploadObjectUrls.forEach(url => URL.revokeObjectURL(url));
      uploadObjectUrls = [];
      if (!filePreview) return;
      filePreview.innerHTML = '';
      uploadedFiles.forEach((file, index) => {
        const thumb = document.createElement('div');
        thumb.className = 'agnes-file-thumb';
        const imageWrap = document.createElement('div');
        imageWrap.className = 'agnes-file-image-wrap';
        const img = document.createElement('img');
        const objectUrl = URL.createObjectURL(file);
        uploadObjectUrls.push(objectUrl);
        img.src = objectUrl;
        img.alt = file.name;
        const actions = document.createElement('div');
        actions.className = 'agnes-file-actions';
        const removeBtn = document.createElement('button');
        removeBtn.className = 'agnes-file-action delete';
        removeBtn.type = 'button';
        removeBtn.setAttribute('aria-label', `Remove ${file.name}`);
        removeBtn.title = 'Remove';
        removeBtn.textContent = '×';
        removeBtn.addEventListener('click', () => {
          uploadedFiles.splice(index, 1);
          renderUploadedFiles();
          updateFileCount();
        });
        actions.append(removeBtn);
        imageWrap.append(img, actions);
        thumb.append(imageWrap);
        filePreview.appendChild(thumb);
      });
    }

    function updateFileCount() {
      if (!fileCount) return;
      if (uploadedFiles.length > 0) {
        fileCount.hidden = false;
        fileCount.textContent = `${uploadedFiles.length} / ${MAX_FILES}`;
      } else {
        fileCount.hidden = true;
        fileCount.textContent = '';
      }
    }

    function clearFiles() {
      uploadedFiles = [];
      renderUploadedFiles();
      updateFileCount();
    }

    function addFiles(files) {
      for (const file of files) {
        if (uploadedFiles.length >= MAX_FILES) { setState(tool.dataset.fileTooMany || 'Maximum 4 images allowed', true); break; }
        if (file.size > MAX_FILE_SIZE) { setState(tool.dataset.fileTooLarge || 'File too large', true); continue; }
        if (!ALLOWED_TYPES.has(file.type)) { setState(tool.dataset.fileBadType || 'Unsupported type', true); continue; }
        const totalBytes = uploadedFiles.reduce((sum, item) => sum + item.size, 0) + file.size;
        if (totalBytes > MAX_TOTAL_IMAGE_BYTES) { setState(tool.dataset.fileTotalTooLarge || 'Reference images are too large', true); continue; }
        uploadedFiles.push(file);
      }
      renderUploadedFiles();
      updateFileCount();
      if (!busy && uploadedFiles.length > 0) setState(text.ready);
    }

    function fileToDataUri(file) {
      return new Promise((resolve, reject) => {
        const reader = new FileReader();
        reader.onload = () => resolve(reader.result);
        reader.onerror = () => reject(new Error('Failed to read file'));
        reader.readAsDataURL(file);
      });
    }

    function imageFromPayload(payload) {
      const result = payload?.result ?? payload;
      const candidates = [
        ...(Array.isArray(result?.data) ? result.data : []),
        ...(result?.data && !Array.isArray(result.data) ? [result.data] : []),
        ...(Array.isArray(result?.images) ? result.images : []),
        ...(Array.isArray(result?.output) ? result.output : []),
        result?.image,
        result,
      ].filter(Boolean);
      for (const item of candidates) {
        const value = typeof item === 'string' ? item : item.b64_json || item.base64 || item.image || item.url || item.image_url;
        if (typeof value !== 'string' || !value.trim()) continue;
        const trimmed = value.trim();
        if (/^data:image\/[a-z0-9.+-]+;base64,/i.test(trimmed)) return trimmed;
        if (/^https?:\/\//i.test(trimmed)) return trimmed;
        if (/^[A-Za-z0-9+/=\r\n]+$/.test(trimmed) && trimmed.length > 128) {
          const clean = trimmed.replace(/\s+/g, '');
          let mime = typeof item === 'object' && item.mime_type ? item.mime_type : 'image/png';
          try {
            const head = atob(clean.slice(0, 32));
            if (head.startsWith('\xFF\xD8\xFF')) mime = 'image/jpeg';
            else if (head.startsWith('\x89PNG\r\n\x1A\n')) mime = 'image/png';
            else if (head.startsWith('RIFF') && head.slice(8, 12) === 'WEBP') mime = 'image/webp';
            else if (head.startsWith('GIF8')) mime = 'image/gif';
          } catch {}
          return `data:${mime};base64,${clean}`;
        }
      }
      return '';
    }

    async function generate() {
      if (!apiUrl || !prompt?.value.trim() || busy || prompt.value.length > MAX_PROMPT_LENGTH) return;
      const lastPrompt = prompt.value.trim();
      const ratio = form?.querySelector('input[name^="aspect-"]:checked')?.value || '1:1';
      const modelId = modelSelect?.value || tool.dataset.modelDefault || 'agnes-image-2.1-flash';
      setBusy(true);
      selectRatio(ratio);
      setState(text.sending);
      setPreviewState('loading');
      try {
        const body = { model: modelId, prompt: lastPrompt, ratio };
        if (mode === 'img2img') {
          body.image = [];
          for (const file of uploadedFiles) body.image.push(await fileToDataUri(file));
          if (body.image.length === 0) throw new Error(tool.dataset.imageRequired || 'Image-to-image needs a reference image');
        }
        const response = await fetch(apiUrl, { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify(body) });
        const payload = await response.json().catch(() => ({}));
        if (!response.ok) throw new Error(payload?.error?.message || text.failure);
        const src = imageFromPayload(payload);
        if (!src) throw new Error(text.failure);
        setCurrentResult(src);
        setPreviewState('success');
        setState(text.success);
        if (await saveHistory(src, lastPrompt, mode, ratio, modelId)) setState(historyPanel?.dataset.historySaved || text.success);
      } catch (error) {
        setPreviewState('error');
        setState(error instanceof Error ? error.message : text.failure, true);
      } finally {
        setBusy(false);
      }
    }

    function resetForm() {
      if (busy) return;
      if (prompt) prompt.value = '';
      clearFiles();
      switchMode('txt2img');
      selectRatio('1:1');
      clearCurrentResultUrl();
      image.src = '';
      download.href = '#';
      setPreviewState('ready');
      setState(apiUrl ? text.ready : text.disabled, !apiUrl);
      updateCounter();
    }

    function openLightbox() {
      if (!lightbox || !lightboxImage || image.hidden || !image.src) return;
      previousActiveElement = document.activeElement;
      lightboxImage.src = image.currentSrc || image.src;
      lightboxImage.alt = image.alt;
      lightbox.hidden = false;
      document.body.style.overflow = 'hidden';
      lightboxClose?.focus();
    }

    function closeLightbox() {
      if (!lightbox) return;
      lightbox.hidden = true;
      lightboxImage.src = '';
      document.body.style.overflow = '';
      if (previousActiveElement instanceof HTMLElement) previousActiveElement.focus();
    }

    tabs?.querySelectorAll('.agnes-tab').forEach(tab => tab.addEventListener('click', () => switchMode(tab.dataset.mode)));
    form?.querySelectorAll('input[name^="aspect-"]').forEach(input => input.addEventListener('change', () => selectRatio(input.value)));
    function resetDropzoneVisual() {
      if (!dropzone) return;
      dragDepth = 0;
      dropzone.classList.remove('dragover', 'is-dropped');
      if (dropzoneText) dropzoneText.textContent = text.uploadHint;
    }

    function showDroppedState() {
      if (!dropzone) return;
      if (dropStateTimer) window.clearTimeout(dropStateTimer);
      dropzone.classList.remove('dragover');
      dropzone.classList.add('is-dropped');
      if (dropzoneText) dropzoneText.textContent = text.uploadDropHint;
      dropStateTimer = window.setTimeout(resetDropzoneVisual, 900);
    }

    dropzone?.addEventListener('click', () => { if (!busy) fileInput?.click(); });
    dropzone?.addEventListener('dragenter', event => {
      if (busy) return;
      event.preventDefault();
      dragDepth += 1;
      dropzone.classList.remove('is-dropped');
      dropzone.classList.add('dragover');
      if (dropzoneText) dropzoneText.textContent = text.uploadDragHint;
    });
    dropzone?.addEventListener('dragover', event => {
      if (busy) return;
      event.preventDefault();
      event.dataTransfer.dropEffect = 'copy';
      dropzone.classList.add('dragover');
      if (dropzoneText) dropzoneText.textContent = text.uploadDragHint;
    });
    dropzone?.addEventListener('dragleave', event => {
      if (busy) return;
      event.preventDefault();
      dragDepth = Math.max(0, dragDepth - 1);
      if (dragDepth === 0) resetDropzoneVisual();
    });
    dropzone?.addEventListener('drop', event => {
      event.preventDefault();
      if (busy) {
        resetDropzoneVisual();
        return;
      }
      const files = event.dataTransfer?.files;
      showDroppedState();
      if (files?.length) addFiles(files);
    });
    fileInput?.addEventListener('change', () => { if (fileInput.files) addFiles(fileInput.files); fileInput.value = ''; });
    // Prevent the programmatic click from bubbling back to the dropzone, which
    // would re-trigger fileInput.click() and cause infinite recursion / no dialog.
    fileInput?.addEventListener('click', event => event.stopPropagation());
    prompt?.addEventListener('input', updateCounter);
    form?.addEventListener('submit', event => { event.preventDefault(); generate(); });
    example?.addEventListener('click', () => { if (prompt && !busy) { prompt.value = mode === 'img2img' ? exampleImg : exampleTxt; updateCounter(); prompt.focus(); } });
    reset?.addEventListener('click', resetForm);
    retry?.addEventListener('click', generate);
    image?.addEventListener('error', () => {
      if (!image.src) return;
      image.hidden = true;
      resultActions.hidden = true;
      setPreviewState('error');
      setState(tool.dataset.imageError || text.failure, true);
    });
    image?.addEventListener('click', openLightbox);
    image?.addEventListener('keydown', event => {
      if (event.key === 'Enter' || event.key === ' ') { event.preventDefault(); openLightbox(); }
    });
    lightboxCloseButtons?.forEach(button => button.addEventListener('click', closeLightbox));
    document.addEventListener('keydown', event => { if (event.key === 'Escape' && lightbox && !lightbox.hidden) closeLightbox(); });
    document.addEventListener('click', event => {
      if (!event.target.closest('.agnes-history-card')) {
        historyList?.querySelectorAll('.agnes-history-menu').forEach(menu => { menu.hidden = true; });
        historyList?.querySelectorAll('.agnes-history-more').forEach(button => button.setAttribute('aria-expanded', 'false'));
      }
    });
    historyClear?.addEventListener('click', async () => {
      if (!historyDb || busy) return;
      await historyTransaction('readwrite', store => store.clear());
      await renderHistory();
    });
    window.addEventListener('beforeunload', () => {
      uploadObjectUrls.forEach(url => URL.revokeObjectURL(url));
      clearHistoryObjectUrls();
      clearCurrentResultUrl();
    });

    selectRatio('1:1');
    applyInitialInput();
    setPreviewState('ready');
    if (!apiUrl) setState(text.disabled, true);
    initHistory();
  })();
</script>
