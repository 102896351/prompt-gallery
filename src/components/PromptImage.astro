---
// ============================================================
//  PromptImage.astro
//  缩略图组件：懒加载 + 加载失败降级到 fallback.svg
// ============================================================

interface Props {
  src: string;
  alt?: string;
  width?: number;
  className?: string;
  // 性能优化：首屏可见的图（hero / featured 头部 / 详情页主图）应传 eager + high
  eager?: boolean; // 默认 false (lazy)；首屏图传 true
  fetchpriority?: 'high' | 'low' | 'auto'; // 默认 auto；首屏关键图传 'high'
  // 外链图统一通过 R2 自定义域名提供；保留 no-referrer 以避免第三方参数污染。
  referrerpolicy?: 'no-referrer' | 'origin' | 'strict-origin-when-cross-origin';
}

const {
  src,
  alt = '',
  width = 500,
  className,
  eager = false,
  fetchpriority = 'auto',
  referrerpolicy = 'no-referrer',
} = Astro.props;
const height = Math.round((width / 4) * 3); // 4:3 比例，避免 CLS
const fallbackSrc = `${import.meta.env.BASE_URL}fallback.svg`;
---

<img
  src={src}
  alt={alt}
  width={width}
  height={height}
  loading={eager ? 'eager' : 'lazy'}
  fetchpriority={fetchpriority}
  decoding={eager ? 'sync' : 'async'}
  referrerpolicy={referrerpolicy}
  data-fallback={fallbackSrc}
  class={className}
  onerror="if(this.src!==this.dataset.fallback)this.src=this.dataset.fallback"
/>

<style>
  img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    background: var(--bg-soft);
  }
</style>