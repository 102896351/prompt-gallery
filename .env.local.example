# Public frontend API endpoint used by the production GitHub Pages build.
# Keep this as a URL only; never put API keys in PUBLIC_* variables.
PUBLIC_AGNES_API_URL=/api/agnes/v1/generate-image

# Local-only Agnes API test configuration.
# Copy this file to .env.local and fill in your own key.
AGNES_API_KEY=
AGNES_LOCAL_HOST=127.0.0.1
AGNES_LOCAL_PORT=8787
AGNES_LOCAL_ORIGIN=http://localhost:4321
AGNES_API_BASE_URL=https://apihub.agnes-ai.com/v1
AGNES_IMAGE_MODEL=agnes-image-2.1-flash
AGNES_REQUEST_TIMEOUT_MS=90000
PUBLIC_AGNES_LOCAL_API_URL=http://127.0.0.1:8787/v1/generate-image
