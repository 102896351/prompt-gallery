{
  "name": "prompt-gallery",
  "type": "module",
  "version": "0.1.0",
  "description": "A curated bilingual gallery of AI image-generation prompts. Pure static site.",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build && node scripts/fix-sitemap-lastmod.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "extract": "node scripts/extract-prompts.mjs",
    "curate": "node scripts/curate-prompts.mjs",
    "curate:append": "node scripts/curate-prompts.mjs --mode append",
    "assets:migrate": "node scripts/migrate-assets.mjs",
    "assets:validate": "node scripts/validate-candidates.mjs",
    "assets:validate-dist": "node scripts/validate-dist-assets.mjs",
    "assets:target": "node scripts/curate-until-target.mjs",
    "agnes:local": "node scripts/agnes-local-api.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.2.1",
    "@aws-sdk/client-s3": "^3.1116.0",
    "astro": "^5.0.0"
  },
  "devDependencies": {
    "json5": "^2.2.3",
    "playwright": "^1.62.1",
    "remark-parse": "^11.0.0",
    "translate": "^3.1.0",
    "unified": "^11.0.5"
  }
}
